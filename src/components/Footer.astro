---
import { SITE, mapsLink, waLink } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="row g-4 g-lg-5">
      <!-- Col 1: Brand & Transparansi Editorial -->
      <div class="col-lg-3 col-md-6">
        <a class="d-flex align-items-center gap-2 mb-3 text-white text-decoration-none" href="/">
          <span class="brand-mark" style="background: transparent !important; box-shadow: none !important; border: none !important; width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;">
            <img src="/images/saka.webp" alt="Logo Saka" width="34" height="34" style="object-fit: contain; background: transparent !important; display: block;" />
          </span>
          <span class="brand-text text-white">pkl<span>disaka.com</span></span>
        </a>
        <p class="small text-secondary mb-3">
          Portal pusat informasi, panduan kurikulum vokasi, dan administrasi Praktik Kerja Lapangan (PKL) terstruktur di Kota Malang.
        </p>
        <div class="p-2 border border-secondary rounded small text-secondary">
          <i class="bi bi-shield-check text-success me-1"></i>
          <strong>Prinsip Editorial:</strong> Menyajikan data faktual tanpa klaim berlebihan dan bebas dari rekaan.
        </div>
      </div>

      <!-- Col 2: Program & Jurusan -->
      <div class="col-6 col-lg-2">
        <div class="footer-heading">Program & Jurusan</div>
        <ul class="footer-links">
          <li><a href="/program-pkl/">Program PKL</a></li>
          <li><a href="/lowongan-pkl/">Status Lowongan</a></li>
          <li><a href="/cara-daftar/">Cara Daftar</a></li>
          <li><a href="/galeri/">Galeri Kenangan</a></li>
          <li><a href="/tentang/">Tentang Saka</a></li>
          <li><a href="/mitra/">Sekolah Mitra</a></li>
          <li><a href="/jurusan/">Semua Jurusan</a></li>
          <li><a href="/jurusan/dkv/">DKV</a></li>
          <li><a href="/jurusan/rpl/">RPL</a></li>
          <li><a href="/jurusan/tkj/">TKJ</a></li>
          <li><a href="/jurusan/bisnis-digital/">Bisnis Digital</a></li>
        </ul>
      </div>

      <!-- Col 3: Divisi Industri -->
      <div class="col-6 col-lg-2">
        <div class="footer-heading">Divisi Praktik</div>
        <ul class="footer-links">
          <li><a href="/divisi/">Semua Divisi</a></li>
          <li><a href="/divisi/digital-marketing/">Digital Marketing</a></li>
          <li><a href="/divisi/seo-website/">SEO & Website</a></li>
          <li><a href="/divisi/social-media/">Social Media</a></li>
          <li><a href="/divisi/foto-video-produk/">Foto & Video</a></li>
          <li><a href="/divisi/content-creator/">Content Creator</a></li>
          <li><a href="/divisi/desain-grafis/">Desain Grafis</a></li>
          <li><a href="/divisi/packaging/">Packaging</a></li>
        </ul>
      </div>

      <!-- Col 4: Panduan & Dokumen -->
      <div class="col-6 col-lg-2">
        <div class="footer-heading">Panduan Dokumen</div>
        <ul class="footer-links">
          <li><a href="/dokumen-pkl/">Pusat Dokumen</a></li>
          <li><a href="/dokumen-pkl/surat-lamaran/">Surat Lamaran</a></li>
          <li><a href="/dokumen-pkl/surat-pengantar/">Surat Pengantar</a></li>
          <li><a href="/dokumen-pkl/cv-magang/">CV Magang</a></li>
          <li><a href="/dokumen-pkl/jurnal-harian/">Jurnal Harian</a></li>
          <li><a href="/dokumen-pkl/laporan-pkl/">Laporan Akhir</a></li>
          <li><a href="/persiapan-pkl/">Persiapan PKL</a></li>
          <li><a href="/pkl-malang/">PKL di Malang</a></li>
        </ul>
      </div>

      <!-- Col 5: Kontak & Verifikasi -->
      <div class="col-6 col-lg-3">
        <div class="footer-heading">Kanal Kontak Resmi</div>
        <address class="footer-links not-italic small text-secondary">
          <p class="mb-2">
            <i class="bi bi-geo-alt text-primary me-2"></i>
            <a href={mapsLink} target="_blank" rel="noopener">{SITE.address.full}</a>
          </p>
          <p class="mb-2">
            <i class="bi bi-whatsapp text-success me-2"></i>
            <a href={waLink()} target="_blank" rel="noopener">{SITE.phoneDisplay}</a>
          </p>
          <p class="mb-2">
            <i class="bi bi-envelope text-primary me-2"></i>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
          <p class="mb-0">
            <i class="bi bi-clock me-2"></i>Senin - Jumat: 08.00 - 16.00 WIB
          </p>
        </address>
        <div class="mt-3">
          <a href="/kontak/" class="btn btn-sm btn-outline-secondary text-white rounded-pill px-3">
            Halaman Kontak Lengkap
          </a>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
      <div>
        &copy; {currentYear} {SITE.name}. Informasi disajikan untuk keperluan panduan Praktik Kerja Lapangan.
      </div>
      <div>
        <a href="/sitemap-index.xml" class="me-3">Sitemap</a>
        <a href="/faq/" class="me-3">FAQ</a>
        <a href="/galeri/" class="me-3">Galeri</a>
        <a href="/tentang/" class="me-3">Tentang</a>
        <a href="/blog/">Blog</a>
      </div>
    </div>
  </div>
</footer>
