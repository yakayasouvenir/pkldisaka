---
import { NAV, SITE, waLink } from '../data/site';

interface Props {
  path?: string;
}

const { path = '/' } = Astro.props;

// Active matching with trailing slash tolerance
const normalize = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const currentPath = normalize(path);

const isActive = (href: string) => {
  const normHref = normalize(href);
  if (normHref === '/') return currentPath === '/';
  return currentPath === normHref || currentPath.startsWith(normHref);
};

const isParentActive = (item: (typeof NAV)[number]) => {
  if (isActive(item.href)) return true;
  if (item.children) {
    return item.children.some((c) => isActive(c.href));
  }
  return false;
};

// Icon map for top-level navigation items
const navIcons: Record<string, string> = {
  'Beranda': 'bi-house-door-fill',
  'Program': 'bi-grid-fill',
  'Jurusan': 'bi-mortarboard-fill',
  'Divisi': 'bi-briefcase-fill',
  'Dokumen PKL': 'bi-file-earmark-text-fill',
  'PKL Malang': 'bi-geo-alt-fill',
  'Tentang': 'bi-info-circle-fill',
  'FAQ': 'bi-question-circle-fill',
  'Kontak': 'bi-telephone-fill',
};
---

<header class="site-header" id="siteHeader">
  <div class="site-header-inner">
    <div class="container-fluid px-3 px-xl-4 header-container">
      <!-- 1. BRAND LOGO -->
      <a class="header-brand" href="/" aria-label="Pkldisaka - Beranda">
        <span class="brand-mark">
          <img src="/images/saka.webp" alt="Logo Saka" width="32" height="32" class="brand-logo-img" />
        </span>
        <span class="brand-text">Pkl<span>disaka</span></span>
      </a>

      <!-- 2. DESKTOP NAVIGATION (Visible on >= 992px) -->
      <nav class="desktop-nav d-none d-lg-flex align-items-center" aria-label="Navigasi Desktop">
        <ul class="desktop-menu list-unstyled mb-0 d-flex align-items-center gap-1">
          {NAV.map((item) => (
            item.children ? (
              <li class="desktop-nav-item dropdown-parent">
                <button
                  type="button"
                  class:list={['desktop-nav-link dropdown-toggle-btn', { active: isParentActive(item) }]}
                  aria-expanded="false"
                >
                  <span>{item.label}</span>
                  <i class="bi bi-chevron-down nav-chevron"></i>
                </button>
                <div class="desktop-dropdown-card">
                  <div class="dropdown-card-inner">
                    {item.children.map((child) => (
                      <a
                        class:list={['dropdown-sub-item', { active: isActive(child.href) }]}
                        href={child.href}
                      >
                        {child.icon && (
                          <span class="dropdown-sub-icon">
                            <i class={`bi ${child.icon}`}></i>
                          </span>
                        )}
                        <div class="dropdown-sub-text">
                          <div class="dropdown-sub-title">{child.label}</div>
                          {child.desc && <div class="dropdown-sub-desc">{child.desc}</div>}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              </li>
            ) : (
              <li class="desktop-nav-item">
                <a
                  class:list={['desktop-nav-link', { active: isActive(item.href) }]}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          ))}
        </ul>
      </nav>

      <!-- 3. DESKTOP CTA BUTTON -->
      <div class="header-cta d-none d-lg-block">
        <a class="btn-primary-saka header-btn" href="/cara-daftar/">
          <i class="bi bi-journal-check"></i>
          <span>Cara Daftar</span>
        </a>
      </div>

      <!-- 4. MOBILE HAMBURGER TOGGLER (Visible on < 992px) -->
      <button
        class="mobile-toggler-btn d-lg-none"
        type="button"
        id="mobileMenuToggle"
        aria-label="Buka navigasi menu"
        aria-expanded="false"
        aria-controls="mobileNavPanel"
      >
        <span class="toggler-icon-wrap">
          <i class="bi bi-list menu-icon-open"></i>
          <i class="bi bi-x-lg menu-icon-close d-none"></i>
        </span>
        <span class="toggler-text">Menu</span>
      </button>
    </div>
  </div>

  <!-- 5. DEDICATED FULL-VIEWPORT MOBILE NAV PANEL (Permanently anchored below fixed header) -->
  <div class="mobile-nav-panel" id="mobileNavPanel" aria-hidden="true">
    <div class="mobile-nav-inner">
      <!-- Announcement & Active Period Badge -->
      <div class="mobile-status-pill mb-3">
        <span class="pulse-dot"></span>
        <span class="status-text">Pendaftaran PKL & Magang SMK/Kampus Dibuka</span>
      </div>

      <!-- Quick Action Cards (Cara Daftar & WA Cepat) -->
      <div class="row g-2 mb-3">
        <div class="col-6">
          <a href="/cara-daftar/" class="mobile-quick-card card-primary">
            <div class="quick-icon"><i class="bi bi-journal-check"></i></div>
            <div class="quick-meta">
              <span class="quick-title">Cara Daftar</span>
              <span class="quick-sub">Alur & Syarat</span>
            </div>
          </a>
        </div>
        <div class="col-6">
          <a href={waLink()} target="_blank" rel="noopener" class="mobile-quick-card card-whatsapp">
            <div class="quick-icon"><i class="bi bi-whatsapp"></i></div>
            <div class="quick-meta">
              <span class="quick-title">WhatsApp</span>
              <span class="quick-sub">Respon Cepat</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Main Navigation Groups -->
      <div class="mobile-menu-list">
        {NAV.map((item, idx) => (
          item.children ? (
            <div class="mobile-nav-group">
              <button
                type="button"
                class:list={['mobile-group-toggle', { 'is-active': isParentActive(item) }]}
                data-target={`#mobileGroup-${idx}`}
                aria-expanded="false"
              >
                <div class="d-flex align-items-center gap-2">
                  <span class="mobile-cat-icon">
                    <i class={`bi ${navIcons[item.label] || 'bi-folder-fill'}`}></i>
                  </span>
                  <span class="mobile-group-title">{item.label}</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="mobile-badge-count">{item.children.length}</span>
                  <i class="bi bi-chevron-down mobile-chevron"></i>
                </div>
              </button>
              <div class="mobile-group-collapse" id={`mobileGroup-${idx}`}>
                <div class="mobile-sub-list">
                  {item.children.map((child) => (
                    <a
                      class:list={['mobile-sub-link', { active: isActive(child.href) }]}
                      href={child.href}
                    >
                      <div class="d-flex align-items-start gap-2">
                        {child.icon ? (
                          <i class={`bi ${child.icon} mobile-sub-ico`}></i>
                        ) : (
                          <i class="bi bi-arrow-right-short mobile-sub-ico"></i>
                        )}
                        <div class="mobile-sub-text">
                          <div class="sub-label">{child.label}</div>
                          {child.desc && <div class="sub-desc">{child.desc}</div>}
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <div class="mobile-nav-single">
              <a
                class:list={['mobile-single-link', { active: isActive(item.href) }]}
                href={item.href}
              >
                <span class="mobile-cat-icon">
                  <i class={`bi ${navIcons[item.label] || 'bi-link-45deg'}`}></i>
                </span>
                <span>{item.label}</span>
              </a>
            </div>
          )
        ))}
      </div>

      <!-- Quick Contact & Studio Info -->
      <div class="mobile-info-card mt-4">
        <div class="info-head">
          <i class="bi bi-geo-alt-fill text-danger me-1"></i>
          <strong>Lokasi Studio Saka</strong>
        </div>
        <p class="info-address mb-2">
          {SITE.address.full}
        </p>
        <div class="info-schedule">
          <i class="bi bi-clock me-1 text-primary"></i>
          <span>Senin - Jumat: 08.00 - 16.00 WIB</span>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Fixed Header Bar (Always pinned to top of viewport) */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: var(--header-height, 64px);
    z-index: 1050;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(220, 226, 234, 0.85);
    box-shadow: 0 2px 14px rgba(15, 23, 42, 0.06);
    display: flex;
    align-items: center;
  }

  .site-header-inner {
    width: 100%;
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Brand Logo */
  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-mark {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    display: block;
  }

  .brand-text {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text);
    white-space: nowrap;
    letter-spacing: -0.02em;
  }

  .brand-text span {
    color: var(--color-primary);
  }

  /* Desktop Nav Items */
  .desktop-menu {
    flex-wrap: nowrap;
  }

  .desktop-nav-item {
    position: relative;
  }

  .desktop-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--color-text);
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .desktop-nav-link:hover,
  .desktop-nav-link:focus,
  .desktop-nav-link.active {
    color: var(--color-primary);
    background-color: var(--color-primary-light);
  }

  .nav-chevron {
    font-size: 0.72rem;
    transition: transform 0.2s ease;
  }

  /* Desktop Dropdown Card: Tata Letak Kotak 2 Kolom (Grid) */
  .desktop-dropdown-card {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 580px;
    max-width: calc(100vw - 32px);
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 16px;
    box-shadow: 0 20px 42px -10px rgba(18, 30, 49, 0.16), 0 4px 14px rgba(0, 0, 0, 0.04);
    padding: 0.75rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px);
    transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
    z-index: 1050;
  }

  /* Area bridge tak terlihat untuk mencegah dropdown tertutup saat kursor berpindah */
  .desktop-dropdown-card::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
  }

  /* Hanya 1 dropdown yang tampil via hover atau class is-open (focus-within dihapus agar tidak nyangkut) */
  .dropdown-parent:hover .desktop-dropdown-card,
  .dropdown-parent.is-open .desktop-dropdown-card {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .dropdown-parent.is-open .dropdown-toggle-btn {
    background-color: var(--color-primary-light);
    color: var(--color-primary);
  }

  .dropdown-parent.is-open .nav-chevron,
  .dropdown-parent:hover .nav-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown yang berada di sisi kanan menu otomatis rata kanan agar tidak terpotong */
  .desktop-nav-item:nth-child(n+5) .desktop-dropdown-card {
    left: auto;
    right: 0;
  }

  .dropdown-card-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem 0.5rem;
  }

  .dropdown-sub-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .dropdown-sub-item:hover {
    background-color: var(--color-primary-light);
    border-color: rgba(26, 86, 219, 0.08);
  }

  .dropdown-sub-item.active {
    background-color: var(--color-primary-light);
    border-color: rgba(26, 86, 219, 0.18);
  }

  .dropdown-sub-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
    margin-top: 1px;
    transition: all 0.15s ease;
  }

  .dropdown-sub-item:hover .dropdown-sub-icon,
  .dropdown-sub-item.active .dropdown-sub-icon {
    background: var(--color-primary);
    color: #ffffff;
    transform: scale(1.05);
  }

  .dropdown-sub-text {
    min-width: 0;
    flex: 1;
  }

  .dropdown-sub-title {
    font-weight: 600;
    font-size: 0.88rem;
    line-height: 1.3;
    color: var(--color-heading, #1e293b);
    transition: color 0.15s ease;
  }

  .dropdown-sub-item:hover .dropdown-sub-title,
  .dropdown-sub-item.active .dropdown-sub-title {
    color: var(--color-primary);
  }

  .dropdown-sub-desc {
    font-size: 0.75rem;
    color: var(--color-muted);
    line-height: 1.35;
    margin-top: 2px;
  }

  /* Header CTA Button */
  .header-btn {
    padding: 0.45rem 1.1rem;
    font-size: 0.88rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Modern Mobile Toggler Button */
  .mobile-toggler-btn {
    height: 42px;
    padding: 0 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: #ffffff;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    transition: all 0.18s ease;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.05);
  }

  .mobile-toggler-btn:hover,
  .mobile-toggler-btn:focus {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
    color: var(--color-primary);
    outline: none;
  }

  .toggler-icon-wrap {
    font-size: 1.25rem;
    line-height: 1;
    display: flex;
    align-items: center;
  }

  .toggler-text {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Dedicated Mobile Nav Panel */
  .mobile-nav-panel {
    display: none;
    position: fixed;
    top: var(--header-height, 64px);
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(100vh - var(--header-height, 64px));
    height: calc(100dvh - var(--header-height, 64px));
    background: #ffffff;
    z-index: 1049;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.18);
  }

  .mobile-nav-panel.is-open {
    display: block;
    animation: mobileSlideDown 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes mobileSlideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav-inner {
    padding: 1rem 1rem 3.5rem;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Status Announcement Pill */
  .mobile-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #166534;
    width: 100%;
    justify-content: center;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: pulseGlow 1.8s infinite;
    flex-shrink: 0;
  }

  @keyframes pulseGlow {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  /* Quick Action Cards */
  .mobile-quick-card {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .mobile-quick-card:active {
    transform: scale(0.98);
  }

  .mobile-quick-card.card-primary {
    background: linear-gradient(135deg, #2457A7, #183D78);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(36, 87, 167, 0.25);
  }

  .mobile-quick-card.card-whatsapp {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
  }

  .quick-icon {
    font-size: 1.35rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quick-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .quick-title {
    font-weight: 750;
    font-size: 0.88rem;
  }

  .quick-sub {
    font-size: 0.72rem;
    opacity: 0.9;
  }

  /* Mobile Nav Items & Accordions */
  .mobile-menu-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mobile-nav-group,
  .mobile-nav-single {
    border: 1px solid var(--color-border-subtle);
    border-radius: 10px;
    background: #ffffff;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .mobile-nav-group:hover,
  .mobile-nav-single:hover {
    border-color: rgba(36, 87, 167, 0.3);
  }

  .mobile-group-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.85rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s ease;
  }

  .mobile-group-toggle:hover,
  .mobile-group-toggle.is-active {
    background: #f8fafc;
  }

  .mobile-cat-icon {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .mobile-group-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .mobile-badge-count {
    background: #e2e8f0;
    color: #475569;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
  }

  .mobile-chevron {
    font-size: 0.8rem;
    color: #64748b;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-group-toggle.is-expanded .mobile-chevron {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .mobile-group-collapse {
    display: none;
    background: #f8fafc;
    border-top: 1px solid var(--color-border-subtle);
    padding: 0.4rem 0.5rem;
  }

  .mobile-group-collapse.is-expanded {
    display: block;
    animation: mobileGroupFade 0.2s ease-out;
  }

  @keyframes mobileGroupFade {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-sub-list {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mobile-sub-link {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.15s ease;
  }

  .mobile-sub-link:hover,
  .mobile-sub-link.active {
    background: #ffffff;
    color: var(--color-primary);
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.05);
  }

  .mobile-sub-ico {
    font-size: 0.95rem;
    color: var(--color-primary);
    margin-top: 2px;
    flex-shrink: 0;
  }

  .mobile-sub-text {
    line-height: 1.25;
  }

  .sub-label {
    font-weight: 650;
    font-size: 0.88rem;
  }

  .sub-desc {
    font-size: 0.74rem;
    color: var(--color-muted);
    margin-top: 2px;
  }

  .mobile-single-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 0.85rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .mobile-single-link:hover,
  .mobile-single-link.active {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  /* Info Card */
  .mobile-info-card {
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.85rem;
  }

  .info-head {
    font-size: 0.85rem;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  .info-address {
    font-size: 0.76rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .info-schedule {
    font-size: 0.76rem;
    font-weight: 600;
    color: #334155;
    display: flex;
    align-items: center;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // -------------------------------------------------------------
    // DESKTOP DROPDOWNS: Mencegah dropdown menumpuk / gabung bersamaan
    // -------------------------------------------------------------
    const desktopDropdowns = document.querySelectorAll('.desktop-nav-item.dropdown-parent');

    function closeAllDesktopDropdowns() {
      desktopDropdowns.forEach((item) => {
        item.classList.remove('is-open');
        const btn = item.querySelector('.dropdown-toggle-btn');
        if (btn) {
          btn.setAttribute('aria-expanded', 'false');
          btn.blur();
        }
      });
    }

    desktopDropdowns.forEach((item) => {
      const btn = item.querySelector('.dropdown-toggle-btn');

      if (btn) {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = item.classList.contains('is-open');
          closeAllDesktopDropdowns();
          if (!isOpen) {
            item.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      }

      // Saat mouse berpindah ke menu lain, tutup dropdown lain seketika
      item.addEventListener('mouseenter', () => {
        desktopDropdowns.forEach((other) => {
          if (other !== item) {
            other.classList.remove('is-open');
            const otherBtn = other.querySelector('.dropdown-toggle-btn');
            if (otherBtn) {
              otherBtn.setAttribute('aria-expanded', 'false');
              otherBtn.blur();
            }
          }
        });
      });

      item.addEventListener('mouseleave', () => {
        item.classList.remove('is-open');
        if (btn) {
          btn.setAttribute('aria-expanded', 'false');
          btn.blur();
        }
      });
    });

    // Tutup seluruh dropdown saat pengguna mengklik area luar navbar
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target && !target.closest('.desktop-nav')) {
        closeAllDesktopDropdowns();
      }
    });

    // Tutup seluruh dropdown saat tombol Escape ditekan
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllDesktopDropdowns();
      }
    });
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const navPanel = document.getElementById('mobileNavPanel');
    const iconOpen = document.querySelector('.menu-icon-open');
    const iconClose = document.querySelector('.menu-icon-close');

    if (toggleBtn && navPanel) {
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = navPanel.classList.contains('is-open');

        if (!isOpen) {
          navPanel.classList.add('is-open');
          navPanel.setAttribute('aria-hidden', 'false');
          toggleBtn.setAttribute('aria-expanded', 'true');
          iconOpen?.classList.add('d-none');
          iconClose?.classList.remove('d-none');
          document.documentElement.classList.add('mobile-menu-open');
          document.body.classList.add('mobile-menu-open');
        } else {
          closeMobileNav();
        }
      });
    }

    function closeMobileNav() {
      if (navPanel && navPanel.classList.contains('is-open')) {
        navPanel.classList.remove('is-open');
        navPanel.setAttribute('aria-hidden', 'true');
        toggleBtn?.setAttribute('aria-expanded', 'false');
        iconOpen?.classList.remove('d-none');
        iconClose?.classList.add('d-none');
        document.documentElement.classList.remove('mobile-menu-open');
        document.body.classList.remove('mobile-menu-open');
      }
    }

    // Accordion expand/collapse in mobile drawer
    const groupToggles = document.querySelectorAll('.mobile-group-toggle');
    groupToggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const targetCollapse = document.querySelector(targetId);
        if (!targetCollapse) return;

        const isExpanded = targetCollapse.classList.contains('is-expanded');

        // Close all other groups for clean accordion experience
        document.querySelectorAll('.mobile-group-collapse.is-expanded').forEach((col) => {
          if (col !== targetCollapse) {
            col.classList.remove('is-expanded');
            const otherBtn = document.querySelector(`[data-target="#${col.id}"]`);
            otherBtn?.classList.remove('is-expanded');
            otherBtn?.setAttribute('aria-expanded', 'false');
          }
        });

        targetCollapse.classList.toggle('is-expanded', !isExpanded);
        btn.classList.toggle('is-expanded', !isExpanded);
        btn.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      });
    });

    // Close when tapping on any link
    const mobileLinks = document.querySelectorAll('.mobile-sub-link, .mobile-single-link, .mobile-quick-card');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeMobileNav();
      });
    });

    // Close on resize to desktop (>= 992px)
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 992) {
        closeMobileNav();
      }
    });
  });
</script>
