---
interface Props {
  status?: string;
  targetDate?: string;
  note?: string;
}

const {
  status = 'Panduan Faktual',
  targetDate,
  note = 'Konten ini disusun berdasarkan standar tata kelola resmi dan panduan kurikulum vokasi.',
} = Astro.props;
---

<div class="status-notice" role="note">
  <div class="status-notice-icon">
    <i class="bi bi-shield-check"></i>
  </div>
  <div class="status-notice-text">
    <strong>Status Verifikasi: {status}</strong>
    {targetDate && <span class="ms-1 text-muted"> &middot; Target Editorial: {targetDate}</span>}
    <div>{note}</div>
  </div>
</div>
