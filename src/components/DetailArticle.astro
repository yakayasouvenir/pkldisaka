---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import ArticleMetadata from './ArticleMetadata.astro';
import StatusNotice from './StatusNotice.astro';
import RelatedLinks from './RelatedLinks.astro';
import FAQList from './FAQList.astro';
import CTASection from './CTASection.astro';
import { type PklPage, GROUPS_INFO } from '../data/pklData';
import { faqNode } from '../lib/schema';
import { waLink } from '../data/site';

interface Props {
  page: PklPage;
}

const { page } = Astro.props;
const groupInfo = GROUPS_INFO[page.group];

const crumbs = [
  { name: groupInfo.title, path: groupInfo.path },
  { name: page.h1, path: page.path },
];

const faqs = page.faqs || [];

import { getArticleVisuals } from '../data/visuals';

const articleVisual = getArticleVisuals(page.path);
const heroBg = articleVisual.src;
const featurePhoto = articleVisual.feature.src;
const galleryPhotos = articleVisual.gallery;
---

<BaseLayout
  title={page.title}
  description={page.metaDescription}
  path={page.path}
  crumbs={crumbs}
  schema={faqs.length > 0 ? [faqNode(page.path, faqs)] : []}
>
  <PageHero
    eyebrow={page.groupName}
    title={page.h1}
    lead={page.metaDescription}
    crumbs={crumbs}
    bgImage={heroBg}
  />

  <section class="content-section">
    <div class="container">
      <div class="row g-4 g-xl-5">
        <!-- Main Column (Konten Artikel) -->
        <div class="col-lg-8">
          <!-- Status Notice -->
          <StatusNotice
            status={page.status}
            targetDate={page.targetDate}
            note="Dokumen dan instruksi diselaraskan dengan tata kelola vokasi resmi pkldisaka.com."
          />

          <!-- Article Content Box -->
          <article class="article-content">
            <ArticleMetadata
              groupName={page.groupName}
              targetDate={page.targetDate}
              status={page.status}
            />

            <!-- Ringkasan awal (DESIGN.md Bab 4.D) -->
            <div class="article-summary-box">
              <div class="article-summary-title">
                <i class="bi bi-info-circle-fill me-1"></i>Ringkasan Panduan
              </div>
              <p class="article-summary-text">{page.summary}</p>
            </div>

            <!-- Interactive Feature Box: Tata Letak Split dengan Foto Compact & Standar Kompetensi (Foto 2) -->
            <div class="article-feature-box">
              <div class="row g-3 align-items-center">
                <div class="col-md-5">
                  <div class="article-feature-img-wrap">
                    <img
                      src={featurePhoto}
                      alt={articleVisual.feature.alt || `Praktik kerja nyata pada ${page.h1}`}
                      loading="lazy"
                      width="480"
                      height="300"
                    />
                    <span class="article-feature-badge">
                      <i class="bi bi-patch-check me-1"></i>{articleVisual.feature.badge || 'Praktik Nyata'}
                    </span>
                  </div>
                </div>
                <div class="col-md-7">
                  <h3 class="h6 fw-bold text-primary mb-2">Standar Kualitas & Kompetensi Kerja</h3>
                  <p class="small text-muted mb-2">
                    {articleVisual.feature.caption || 'Seluruh aktivitas penugasan disesuaikan dengan ritme industri terukur agar peserta siap memasuki dunia kerja profesional.'}
                  </p>
                  <div class="competency-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span><strong>Bimbingan Praktisi:</strong> Arahan teknis langsung dari staf industri berpengalaman.</span>
                  </div>
                  <div class="competency-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span><strong>Portofolio Otentik:</strong> Hasil karya dapat dijadikan portofolio profesional siswa.</span>
                  </div>
                  <div class="competency-item mb-0">
                    <i class="bi bi-check-circle-fill"></i>
                    <span><strong>Pengesahan Resmi:</strong> Penilaian transparan untuk laporan ke sekolah/kampus.</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Body Isi dengan H2 & H3 -->
            <div class="article-body">
              {page.sections.map((section, idx) => (
                <div id={`sec-${idx}`} class="mb-4 scroll-mt-header">
                  <h2>{section.heading}</h2>
                  <div style="white-space: pre-line;">{section.content}</div>

                  {section.bullets && section.bullets.length > 0 && (
                    <ul class="mt-3">
                      {section.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  )}

                  {section.note && (
                    <div class="callout-note mt-3">
                      <i class="bi bi-lightbulb text-primary me-2"></i>
                      <strong>Catatan Praktis:</strong> {section.note}
                    </div>
                  )}
                </div>
              ))}
            </div>

            <!-- Dokumentasi Foto Lapangan & Fasilitas Terkait (Foto 3 & 4) -->
            <div class="article-gallery-showcase my-4 p-3 p-md-4 rounded-4 bg-light border">
              <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div>
                  <h3 class="h6 fw-bold text-dark mb-0">
                    <i class="bi bi-camera-fill text-primary me-2"></i>Dokumentasi Aktivitas & Fasilitas Terkait
                  </h3>
                  <p class="small text-muted mb-0">Gambaran nyata ekosistem kerja, sarana penunjang, dan pendampingan di Saka Malang.</p>
                </div>
                <span class="badge bg-white text-primary border shadow-xs">
                  <i class="bi bi-images me-1"></i>Dokumentasi Nyata
                </span>
              </div>

              <div class="row g-3">
                {galleryPhotos.map((photo) => (
                  <div class="col-md-6">
                    <div class="gallery-photo-card h-100 bg-white rounded-3 overflow-hidden border shadow-xs d-flex flex-column">
                      <div class="position-relative">
                        <img
                          src={photo.src}
                          alt={photo.alt}
                          loading="lazy"
                          class="w-100 object-fit-cover"
                          style="height: 195px;"
                        />
                        <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 end-0 m-2">
                          <i class="bi bi-tag-fill me-1"></i>{photo.badge}
                        </span>
                      </div>
                      <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="fw-bold small text-dark mb-1">{photo.alt}</div>
                        <p class="small text-muted mb-0" style="line-height: 1.5;">{photo.caption}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Alur SOP & Pelaksanaan Praktik Industri Terstruktur -->
            <div class="sop-guide-box my-4 p-3 p-md-4 rounded-4 bg-white border shadow-xs">
              <div class="d-flex align-items-center gap-2 mb-3">
                <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                  <i class="bi bi-clipboard2-check-fill"></i>
                </div>
                <div>
                  <h3 class="h6 fw-bold text-dark mb-0">Alur Standar Operasional Prosedur (SOP) Industri</h3>
                  <p class="small text-muted mb-0">Tahapan pelaksanaan kerja terarah yang dilalui setiap peserta di Saka:</p>
                </div>
              </div>

              <div class="sop-steps-list d-flex flex-column gap-3">
                <div class="d-flex gap-3 align-items-start">
                  <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 26px; height: 26px; font-weight: 700; font-size: 0.8rem; margin-top: 2px;">1</div>
                  <div>
                    <div class="fw-bold text-dark small">Orientasi Divisi & Pengenalan Budaya Kerja</div>
                    <p class="small text-muted mb-0">Pemahaman tata tertib kantor, pengenalan tools kolaborasi (Trello, Slack/Drive), dan penentuan target kompetensi individu.</p>
                  </div>
                </div>
                <div class="d-flex gap-3 align-items-start">
                  <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 26px; height: 26px; font-weight: 700; font-size: 0.8rem; margin-top: 2px;">2</div>
                  <div>
                    <div class="fw-bold text-dark small">Pengerjaan Proyek Industri & Asistensi Rutin</div>
                    <p class="small text-muted mb-0">Eksekusi tugas nyata sesuai pembagian tim dengan pendampingan mentor untuk memastikan standar teknis memenuhi ekspektasi klien/pasar.</p>
                  </div>
                </div>
                <div class="d-flex gap-3 align-items-start">
                  <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 26px; height: 26px; font-weight: 700; font-size: 0.8rem; margin-top: 2px;">3</div>
                  <div>
                    <div class="fw-bold text-dark small">Verifikasi Portofolio & Pencatatan Jurnal Harian</div>
                    <p class="small text-muted mb-0">Review mingguan atas output kerja, penyusunan studi kasus, dan pembubuhan tanda tangan verifikasi mentor pada buku logbook/jurnal PKL.</p>
                  </div>
                </div>
                <div class="d-flex gap-3 align-items-start">
                  <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 26px; height: 26px; font-weight: 700; font-size: 0.8rem; margin-top: 2px;">4</div>
                  <div>
                    <div class="fw-bold text-dark small">Evaluasi Akhir & Penerbitan Sertifikat Resmi</div>
                    <p class="small text-muted mb-0">Presentasi hasil pencapaian kerja, pengisian formulir penilaian sekolah/kampus, dan penerbitan sertifikat magang berstandar industri.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Rubrik Evaluasi & Indikator Kelulusan -->
            <div class="evaluation-rubric-box my-4 p-3 p-md-4 rounded-4 bg-light border">
              <h3 class="h6 fw-bold text-dark mb-2">
                <i class="bi bi-award-fill text-warning me-2"></i>Rubrik Penilaian & Indikator Kelulusan
              </h3>
              <p class="small text-muted mb-3">Aspek penilaian pembimbing industri yang dijadikan rujukan nilai rapor/transkrip magang:</p>
              <div class="row g-2">
                <div class="col-sm-6">
                  <div class="p-2.5 bg-white rounded-3 border h-100">
                    <div class="fw-bold small text-dark"><i class="bi bi-check2-circle text-success me-1"></i> Kedisiplinan & Etika (25%)</div>
                    <div class="small text-muted" style="font-size: 0.78rem;">Ketaatan jam kerja, attitude komunikasi profesional, dan kerapian lingkungan kantor.</div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="p-2.5 bg-white rounded-3 border h-100">
                    <div class="fw-bold small text-dark"><i class="bi bi-check2-circle text-success me-1"></i> Keterampilan Teknis (35%)</div>
                    <div class="small text-muted" style="font-size: 0.78rem;">Ketelitian eksekusi, adaptasi teknologi, dan pemenuhan standar kualitas output proyek.</div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="p-2.5 bg-white rounded-3 border h-100">
                    <div class="fw-bold small text-dark"><i class="bi bi-check2-circle text-success me-1"></i> Inisiatif & Kerja Tim (20%)</div>
                    <div class="small text-muted" style="font-size: 0.78rem;">Keaktifan bertanya, kolaborasi lintas divisi, dan kemampuan menyelesaikan hambatan.</div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="p-2.5 bg-white rounded-3 border h-100">
                    <div class="fw-bold small text-dark"><i class="bi bi-check2-circle text-success me-1"></i> Laporan & Portofolio (20%)</div>
                    <div class="small text-muted" style="font-size: 0.78rem;">Kerapian jurnal harian, kelengkapan berkas pengesahan, dan portofolio karya nyata.</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tips Pembimbing Industri -->
            <div class="mentor-protip-box">
              <div class="mentor-protip-header">
                <i class="bi bi-chat-quote-fill"></i>
                <span>Tips dari Pembimbing Lapangan</span>
              </div>
              <p class="mentor-protip-text">
                Kunci sukses selama menjalani program PKL bukan sekadar menyelesaikan tugas teknis, melainkan keterbukaan dalam menerima masukan (*feedback*), kedisiplinan komunikasi, dan inisiatif mendokumentasikan progres harian secara rapi untuk laporan akhir.
              </p>
            </div>

            <!-- Related Links (DESIGN.md Bab 4.D) -->
            {page.relatedUrls && page.relatedUrls.length > 0 && (
              <RelatedLinks urls={page.relatedUrls} />
            )}
          </article>
        </div>

        <!-- Sidebar Column (Navigasi Cepat, Quick Info & CTA) -->
        <div class="col-lg-4">
          <aside class="detail-sidebar">
            <!-- 1. Quick CTA WhatsApp Card -->
            <div class="sidebar-widget sidebar-cta-card">
              <div class="d-inline-flex align-items-center gap-1.5 badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 mb-2 font-monospace" style="font-size: 0.72rem;">
                <i class="bi bi-patch-check-fill text-primary"></i>
                <span>Penerimaan Terbuka 2026/2027</span>
              </div>
              <h3 class="h6 fw-bold text-dark mb-2">Konsultasi Syarat & Kuota PKL</h3>
              <p class="small text-muted mb-3" style="font-size: 0.85rem; line-height: 1.5;">
                Pastikan ketersediaan kuota divisi dan kesesuaian jurusan Anda langsung dengan tim pembimbing Saka Malang.
              </p>
              <a
                href={waLink()}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary w-100 rounded-pill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm"
              >
                <i class="bi bi-whatsapp"></i>
                <span>Chat Tim Pembimbing</span>
              </a>
              <div class="d-flex align-items-center justify-content-center gap-2 mt-2 text-muted" style="font-size: 0.74rem;">
                <i class="bi bi-lightning-charge-fill text-warning"></i>
                <span>Respon Cepat • Bebas Biaya 100%</span>
              </div>
            </div>

            <!-- 2. Table of Contents (Daftar Isi) jika sections > 1 -->
            {page.sections && page.sections.length > 1 && (
              <div class="sidebar-widget">
                <div class="sidebar-widget-title">
                  <i class="bi bi-list-nested text-primary"></i>
                  <span>Daftar Isi Panduan</span>
                </div>
                <ul class="sidebar-toc-list">
                  {page.sections.map((sec, idx) => (
                    <li>
                      <a href={`#sec-${idx}`} class="sidebar-toc-link">
                        <span class="toc-number">{String(idx + 1).padStart(2, '0')}</span>
                        <span class="toc-title">{sec.heading}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- 3. Standar & Fakta Cepat PKL -->
            <div class="sidebar-widget">
              <div class="sidebar-widget-title">
                <i class="bi bi-shield-check text-success"></i>
                <span>Standar Pelaksanaan PKL</span>
              </div>
              <div class="sidebar-facts-list">
                <div class="sidebar-fact-item">
                  <span class="fact-label">Lokasi:</span>
                  <span class="fact-val">Kota Malang, Jatim</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">Biaya Masuk:</span>
                  <span class="fact-val text-success">Gratis 100%</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">Durasi PKL:</span>
                  <span class="fact-val">3 – 6 Bulan</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">Pembimbing:</span>
                  <span class="fact-val">Praktisi 1-on-1</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">Dokumen Akhir:</span>
                  <span class="fact-val">Sertifikat & Nilai</span>
                </div>
              </div>
            </div>

            <!-- 4. Pintasan Direktori -->
            <div class="sidebar-widget">
              <div class="sidebar-widget-title">
                <i class="bi bi-grid-3x3-gap text-primary"></i>
                <span>Pusat Informasi Terkait</span>
              </div>
              <div class="d-flex flex-wrap gap-1.5">
                <a href="/cara-daftar/" class="badge bg-light text-secondary border p-2 text-decoration-none rounded-pill hover-badge">
                  <i class="bi bi-journal-check me-1"></i>Cara Daftar
                </a>
                <a href="/jurusan/" class="badge bg-light text-secondary border p-2 text-decoration-none rounded-pill hover-badge">
                  <i class="bi bi-mortarboard me-1"></i>Kesesuaian Jurusan
                </a>
                <a href="/divisi/" class="badge bg-light text-secondary border p-2 text-decoration-none rounded-pill hover-badge">
                  <i class="bi bi-diagram-3 me-1"></i>Pilihan Divisi
                </a>
                <a href="/dokumen-pkl/" class="badge bg-light text-secondary border p-2 text-decoration-none rounded-pill hover-badge">
                  <i class="bi bi-file-earmark-text me-1"></i>Format Dokumen
                </a>
                <a href="/mitra/" class="badge bg-light text-secondary border p-2 text-decoration-none rounded-pill hover-badge">
                  <i class="bi bi-buildings me-1"></i>Sekolah Mitra
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ jika ada -->
  {faqs.length > 0 && (
    <FAQList
      items={faqs}
      id={`faq-${page.slug}`}
      title="Pertanyaan yang Sering Diajukan"
      description="Jawaban atas pertanyaan umum yang berkaitan langsung dengan materi halaman ini."
    />
  )}

  <CTASection />
</BaseLayout>
