---
// src/pages/tempat-pkl-terdekat.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatusNotice from '../components/StatusNotice.astro';
import FAQList from '../components/FAQList.astro';
import CTASection from '../components/CTASection.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, waLink, mapsLink, mapsEmbedUrl } from '../data/site';
import { faqNode } from '../lib/schema';
import { getCollection } from 'astro:content';

const path = '/tempat-pkl-terdekat/';
const crumbs = [{ name: 'Tempat PKL Terdekat', path }];

// Ambil 4 artikel pendukung yang baru diposting
const allBlog = await getCollection('blog');
const supportSlugs = [
  'tempat-pkl-terdekat',
  'tempat-pkl-terdekat-dari-rumah',
  'tempat-pkl-sesuai-jurusan',
  'cara-mendaftar-pkl-di-malang',
];

const supportingArticles = supportSlugs
  .map((slug) => allBlog.find((b) => b.id === slug))
  .filter(Boolean);

const faqs = [
  {
    q: 'Bagaimana cara menentukan tempat PKL terdekat dari rumah?',
    a: 'Gunakan Google Maps dengan mengetik kata kunci spesifik seperti "PKL digital marketing", "studio IT", atau "kantor software" di sekitar domisili Anda. Pastikan untuk memverifikasi alamat fisik, jam operasional, ulasan peserta sebelumnya, dan kemudahan akses transportasi.',
  },
  {
    q: 'Apakah faktor jarak lebih penting daripada kesesuaian jurusan saat memilih tempat PKL?',
    a: 'Tidak. Memilih tempat PKL yang dekat memang menghemat ongkos dan waktu tempuh, namun kesesuaian kurikulum jurusan dan ketersediaan mentor industri tetap merupakan prioritas utama agar kompetensi kejuruan Anda berkembang maksimal.',
  },
  {
    q: 'Jurusan apa saja yang bisa mendaftar di PKL di Saka Malang?',
    a: 'PKL di Saka membuka divisi magang untuk jurusan Rekayasa Perangkat Lunak (RPL), Teknik Komputer & Jaringan (TKJ), Desain Komunikasi Visual (DKV), Bisnis Digital / Pemasaran, Manajemen Perkantoran, dan Teknik Grafika.',
  },
  {
    q: 'Berapa biaya pendaftaran tempat PKL terdekat di PKL di Saka Malang?',
    a: 'Pendaftaran dan seluruh proses bimbingan PKL di PKL di Saka 100% bebas biaya (gratis tanpa pungutan liar).',
  },
  {
    q: 'Di mana alamat kantor PKL di Saka dan rute terdekatnya?',
    a: 'Kantordan studio PKL di Saka berlokasi di Jl. Band. Palmerah No.D3-35B, Cemorokandang, Kedungkandang, Kota Malang. Sangat dekat dengan exit Tol Sawojajar/Madyopuro, Gor Ken Arok, dan kawasan pendidikan SMK se-Malang Raya.',
  },
];

const divisions = [
  {
    title: 'Web & Software Engineering',
    jurusan: 'RPL & Informatika',
    icon: 'bi-code-slash',
    desc: 'Pengembangan web modern, integrasi CMS, optimasi performa sistem, dan implementasi kode standar industri.',
    bg: '/images/21.webp',
  },
  {
    title: 'Desain Grafis & UI/UX',
    jurusan: 'DKV, Multimedia & Grafika',
    icon: 'bi-palette-fill',
    desc: 'Pembuatan aset visual komersial, identitas brand, banner promosi media sosial, dan materi kemasan profesional.',
    bg: '/images/12.webp',
  },
  {
    title: 'Digital Marketing & SEO',
    jurusan: 'Bisnis Digital & Pemasaran',
    icon: 'bi-megaphone-fill',
    desc: 'Riset kata kunci, optimasi search engine on-page & off-page, content marketing, dan operasional marketplace online.',
    bg: '/images/20.webp',
  },
  {
    title: 'IT Support & Jaringan',
    jurusan: 'TKJ & Sistem Jaringan',
    icon: 'bi-hdd-network-fill',
    desc: 'Konfigurasi infrastruktur jaringan studio, manajemen server lokal, perawatan perangkat komputer, dan keamanan data.',
    bg: '/images/10.webp',
  },
];
---

<BaseLayout
  title="Tempat PKL Terdekat di Malang untuk SMK dan Mahasiswa | PKL di Saka"
  description="Cari tempat PKL terdekat di Malang yang terpercaya, bebas biaya, dan sesuai jurusan? Dapatkan panduan lengkap lokasi magang strategis, divisi kejuruan, dan pendaftaran di PKL di Saka."
  path={path}
  crumbs={crumbs}
  schema={[faqNode(path, faqs)]}
>
  <PageHero
    eyebrow="PUSAT INFORMASI PRAKTIK KERJA LAPANGAN"
    title="Tempat PKL Terdekat di Malang yang Sesuai Jurusan & Berstandar Industri"
    lead="Temukan tempat PKL terdekat dari domisili Anda di kawasan Malang Raya. Dapatkan pengalaman kerja industri riil pada proyek nyata, bimbingan mentor berdedikasi, fasilitas kerja lengkap, dan legalitas administrasi sekolah yang tertib 100% tanpa biaya."
    crumbs={crumbs}
    bgImage="/images/blog/pkl-terdekat-1.webp"
  />

  <section class="content-section">
    <div class="container">
      <div class="row g-4 g-xl-5">
        <!-- Main Content Column -->
        <div class="col-lg-8">
          <StatusNotice
            status="Penerimaan Kuota Magang Terbuka & Faktual"
            targetDate="Tahun Ajaran 2026/2027"
            note="Penerimaan siswa PKL di Saka diproses transparan berdasarkan kuota divisi industri dan verifikasi surat pengantar resmi sekolah."
          />

          <article class="article-content">
            <!-- Ringkasan Eksekutif / Callout -->
            <div class="article-summary-box mb-4">
              <div class="article-summary-title">
                <i class="bi bi-geo-alt-fill text-danger me-2"></i>Mengapa Memilih Tempat PKL Terdekat di PKL di Saka Malang?
              </div>
              <p class="article-summary-text mb-0">
                Memilih <strong>tempat PKL terdekat</strong> memberikan efisiensi jarak tempuh, penghematan biaya transportasi harian, dan kenyamanan mobilitas bagi siswa SMK maupun mahasiswa. Namun, kedekatan lokasi harus diimbangi dengan kurikulum magang yang tepat. Di <strong><a href="/" class="text-decoration-none fw-bold text-primary">PKL di Saka</a></strong>, peserta mendapatkan perpaduan terbaik: lokasi kantor studio yang strategis dan mudah diakses di Malang Raya, disertai bimbingan proyek langsung dari mentor industri yang relevan dengan kompetensi keahlian kejuruan sekolah.
              </p>
            </div>

            <!-- Visual Feature Box -->
            <div class="article-feature-box mb-5">
              <div class="row g-3 align-items-center">
                <div class="col-md-5">
                  <div class="article-feature-img-wrap">
                    <img
                      src="/images/blog/pkl-terdekat-2.webp"
                      alt="Bimbingan proyek PKL bersama mentor industri di studio kerja PKL di Saka"
                      loading="lazy"
                      width="480"
                      height="300"
                    />
                    <span class="article-feature-badge">
                      <i class="bi bi-shield-check me-1"></i>Bebas Biaya 100%
                    </span>
                  </div>
                </div>
                <div class="col-md-7">
                  <h3 class="h6 fw-bold text-primary mb-2">Bimbingan Intensif & Berkelanjutan</h3>
                  <p class="small text-muted mb-3">
                    Peserta tidak sekadar menjalankan rutinitas administratif, melainkan dilibatkan langsung dalam portofolio nyata sesuai standar Dunia Usaha dan Dunia Industri (DUDI).
                  </p>
                  <div class="competency-item mb-2">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    <span><strong>Legalitas Tertib:</strong> Penerbitan surat balasan, jurnal berkala, dan sertifikat resmi.</span>
                  </div>
                  <div class="competency-item mb-2">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    <span><strong>Mentor Berpengalaman:</strong> Pendampingan teknis harian agar siswa memahami standar industri.</span>
                  </div>
                  <div class="competency-item mb-0">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    <span><strong>Lokasi Aksesibel:</strong> Jalur mudah dilewati kendaraan roda dua, angkutan, maupun transportasi online.</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Konten Utama: 5 Standar Tempat PKL Terdekat yang Ideal -->
            <h2 class="h4 fw-bold text-dark mb-3">Kriteria Penting Memilih Tempat PKL Terdekat</h2>
            <p class="text-secondary mb-3" style="line-height: 1.75;">
              Sebelum memutuskan mengajukan surat permohonan ke industri terdekat, pastikan Anda meneliti 4 aspek fundamental berikut agar masa magang berjalan produktif:
            </p>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <div class="p-3 border rounded-3 bg-white h-100 shadow-xs">
                  <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold">
                    <i class="bi bi-compass-fill fs-5"></i>
                    <span>1. Kemudahan Akses & Transportasi</span>
                  </div>
                  <p class="small text-muted mb-0">
                    Lokasi yang terhubung dengan jalan utama atau angkutan umum memudahkan kedisiplinan jam masuk kerja dan meminimalkan keletihan di jalan.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <div class="p-3 border rounded-3 bg-white h-100 shadow-xs">
                  <div class="d-flex align-items-center gap-2 mb-2 text-success fw-bold">
                    <i class="bi bi-mortarboard-fill fs-5"></i>
                    <span>2. Kesesuaian Kurikulum Jurusan</span>
                  </div>
                  <p class="small text-muted mb-0">
                    Pastikan perusahaan memiliki divisi penugasan yang linear dengan kompetensi keahlian Anda (seperti koding untuk RPL, visual untuk DKV, dan jaringan untuk TKJ).
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <div class="p-3 border rounded-3 bg-white h-100 shadow-xs">
                  <div class="d-flex align-items-center gap-2 mb-2 text-warning-emphasis fw-bold">
                    <i class="bi bi-laptop-fill fs-5"></i>
                    <span>3. Fasilitas Penunjang Nyata</span>
                  </div>
                  <p class="small text-muted mb-0">
                    Ketersediaan koneksi internet berkecepatan tinggi, ruang kerja nyaman, perangkat penunjang, dan modul kerja yang sistematis.
                  </p>
                </div>
              </div>
              <div class="col-md-6">
                <div class="p-3 border rounded-3 bg-white h-100 shadow-xs">
                  <div class="d-flex align-items-center gap-2 mb-2 text-info-emphasis fw-bold">
                    <i class="bi bi-cash-coin fs-5"></i>
                    <span>4. Transparansi Bebas Pungli</span>
                  </div>
                  <p class="small text-muted mb-0">
                    Perusahaan profesional tidak memungut biaya pendaftaran atau iuran bulanan. Di <a href="/" class="text-decoration-none fw-semibold">PKL di Saka</a>, seluruh program 100% bebas biaya.
                  </p>
                </div>
              </div>
            </div>

            <!-- Pilihan Divisi Kejuruan di PKL di Saka -->
            <h2 class="h4 fw-bold text-dark mt-4 mb-3">Pilihan Divisi Kejuruan di Tempat PKL di Saka Malang</h2>
            <p class="text-secondary mb-3">
              Kami memfasilitasi berbagai konsentrasi keahlian vokasi agar setiap peserta mendapatkan portofolio yang relevan dengan masa depan karier mereka:
            </p>

            <div class="row g-3 mb-5">
              {divisions.map((div) => (
                <div class="col-md-6">
                  <div class="card h-100 border rounded-3 overflow-hidden shadow-xs hover-shadow transition-all">
                    <div style={`background-image: url('${div.bg}'); height: 110px; background-size: cover; background-position: center; position: relative;`}>
                      <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(11, 42, 111, 0.75);"></div>
                      <div class="position-absolute top-0 start-0 w-100 h-100 p-3 d-flex justify-content-between align-items-start text-white">
                        <span class="badge bg-white text-dark font-monospace small">{div.jurusan}</span>
                        <i class={`bi ${div.icon} fs-4`}></i>
                      </div>
                    </div>
                    <div class="card-body p-3">
                      <h3 class="h6 fw-bold text-dark mb-1">{div.title}</h3>
                      <p class="small text-muted mb-0" style="font-size: 0.85rem; line-height: 1.5;">{div.desc}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Peta Lokasi Interaktif & Navigasi -->
            <h2 class="h4 fw-bold text-dark mb-2">Peta Lokasi Kantor Studio PKL di Saka Malang</h2>
            <p class="text-secondary small mb-3">
              Alamat: <strong>{SITE.address.full}</strong>. Lokasi tenang, kondusif untuk belajar, dan mudah dijangkau dari berbagai penjuru Kota Malang maupun Kabupaten Malang.
            </p>
            <div class="ratio ratio-16x9 rounded-3 overflow-hidden border mb-3 shadow-xs">
              <iframe
                src={mapsEmbedUrl}
                title="Peta Lokasi Tempat PKL Terdekat di Malang - PKL di Saka"
                loading="lazy"
                style="border:0;"
                allowfullscreen=""
              ></iframe>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-5">
              <a href={mapsLink} target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm rounded-pill">
                <i class="bi bi-geo-alt me-1"></i> Buka Rute di Google Maps
              </a>
              <a href={waLink('Halo Tim PKL di Saka, saya ingin menanyakan petunjuk arah dan ketersediaan kuota PKL terdekat.')} target="_blank" rel="noopener noreferrer" class="btn btn-success btn-sm rounded-pill text-white">
                <i class="bi bi-whatsapp me-1"></i> Konfirmasi Kuota via WhatsApp
              </a>
            </div>

            <!-- ==================================================================== -->
            <!-- 4 ARTIKEL PENDUKUNG (INTERNAL LINKING STRATEGIS UNTUK MENDUKUNG HALAMAN INI) -->
            <!-- ==================================================================== -->
            <div class="p-4 rounded-3 border bg-light mb-5">
              <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold">
                <i class="bi bi-journal-bookmark-fill fs-5"></i>
                <h2 class="h5 fw-bold mb-0">Panduan Lengkap Terkait Tempat PKL Terdekat</h2>
              </div>
              <p class="small text-muted mb-4">
                Pelajari rujukan komprehensif yang telah disusun oleh tim mentor industri untuk memandu persiapan magang Anda dari awal hingga tuntas:
              </p>

              <div class="row g-3">
                {supportingArticles.map((art) => (
                  <div class="col-md-6">
                    <div class="card h-100 border bg-white rounded-3 shadow-xs hover-shadow transition-all">
                      <div class="row g-0 h-100 align-items-center">
                        <div class="col-4 p-2">
                          <img
                            src={art?.data.image || '/images/13.webp'}
                            alt={art?.data.imageAlt || art?.data.title}
                            class="img-fluid rounded-2 object-fit-cover w-100"
                            style="height: 85px;"
                            loading="lazy"
                          />
                        </div>
                        <div class="col-8 p-2 ps-1">
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 0.65rem;">
                            {art?.data.category}
                          </span>
                          <h3 class="h6 fw-bold mb-1 mt-1 text-truncate-2" style="font-size: 0.85rem; line-height: 1.35;">
                            <a href={`/blog/${art?.id}/`} class="text-decoration-none text-dark hover-primary">
                              {art?.data.title}
                            </a>
                          </h3>
                          <a href={`/blog/${art?.id}/`} class="small text-primary text-decoration-none fw-semibold" style="font-size: 0.75rem;">
                            Baca Selengkapnya &rarr;
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- FAQ SECTION -->
            <div class="mt-4">
              <div class="mb-3">
                <span class="section-heading-eyebrow">Tanya Jawab Lokasi & Pendaftaran</span>
                <h2 class="h4 fw-bold text-dark mb-1">FAQ &mdash; Pertanyaan Seputar Tempat PKL Terdekat</h2>
                <p class="small text-muted mb-0">Jawaban praktis dan transparan mengenai lokasi, transportasi, dan prosedur pendaftaran magang.</p>
              </div>
              <FAQList faqs={faqs} />
            </div>
          </article>
        </div>

        <!-- Sidebar Column -->
        <div class="col-lg-4">
          <aside class="detail-sidebar sticky-top" style="top: 2rem;">
            <!-- CTA Card -->
            <div class="sidebar-widget sidebar-cta-card">
              <div class="d-inline-flex align-items-center gap-1.5 badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 mb-2 font-monospace" style="font-size: 0.72rem;">
                <i class="bi bi-patch-check-fill text-primary"></i>
                <span>Respon Cepat Tim Industri</span>
              </div>
              <h3 class="h6 fw-bold text-dark mb-2">Konsultasi Tempat PKL Terdekat</h3>
              <p class="small text-muted mb-3" style="font-size: 0.85rem; line-height: 1.5;">
                Ingin memastikan ketersediaan kuota magang terdekat untuk periode sekolah Anda? Diskusikan langsung dengan tim pembimbing kami.
              </p>
              <a
                href={waLink('Halo Tim PKL di Saka, saya mencari tempat PKL terdekat di Malang untuk jurusan saya. Apakah kuotanya masih tersedia?')}
                class="btn btn-primary w-100 rounded-pill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm"
                target="_blank"
                rel="noopener noreferrer"
              >
                <i class="bi bi-whatsapp"></i>
                <span>Hubungi via WhatsApp</span>
              </a>
              <div class="d-flex align-items-center justify-content-center gap-2 mt-2 text-muted" style="font-size: 0.74rem;">
                <i class="bi bi-shield-check text-success"></i>
                <span>Gratis 100% • Bebas Pungutan Liar</span>
              </div>
            </div>

            <!-- Fast Facts Widget -->
            <div class="sidebar-widget">
              <div class="sidebar-widget-title">
                <i class="bi bi-geo-alt-fill text-primary"></i>
                <span>Profil Lokasi & Fasilitas</span>
              </div>
              <div class="sidebar-facts-list">
                <div class="sidebar-fact-item">
                  <span class="fact-label">Kota / Lokasi:</span>
                  <span class="fact-val">Kota Malang, Jatim</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">Akses Rute:</span>
                  <span class="fact-val">Dekat Exit Tol Sawojajar</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">Biaya Pendaftaran:</span>
                  <span class="fact-val text-success fw-bold">Gratis 100%</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">Konektivitas:</span>
                  <span class="fact-val">High Speed WiFi Studio</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">Output Akhir:</span>
                  <span class="fact-val">Portofolio & Sertifikat</span>
                </div>
              </div>
            </div>

            <!-- Quick Navigation Widget -->
            <div class="sidebar-widget">
              <div class="sidebar-widget-title">
                <i class="bi bi-link-45deg text-primary"></i>
                <span>Navigasi Penting</span>
              </div>
              <div class="d-flex flex-column gap-2">
                <a href="/cara-daftar/" class="text-decoration-none p-2 border rounded bg-white hover-shadow d-flex align-items-center justify-content-between">
                  <span class="small fw-semibold text-dark">Alur & Syarat Cara Daftar</span>
                  <i class="bi bi-arrow-right text-primary small"></i>
                </a>
                <a href="/lowongan-pkl/" class="text-decoration-none p-2 border rounded bg-white hover-shadow d-flex align-items-center justify-content-between">
                  <span class="small fw-semibold text-dark">Cek Kuota Lowongan PKL</span>
                  <i class="bi bi-arrow-right text-primary small"></i>
                </a>
                <a href="/program-pkl/fasilitas/" class="text-decoration-none p-2 border rounded bg-white hover-shadow d-flex align-items-center justify-content-between">
                  <span class="small fw-semibold text-dark">Fasilitas Bimbingan Studio</span>
                  <i class="bi bi-arrow-right text-primary small"></i>
                </a>
                <a href="/galeri/" class="text-decoration-none p-2 border rounded bg-white hover-shadow d-flex align-items-center justify-content-between">
                  <span class="small fw-semibold text-dark">Galeri Kegiatan Siswa</span>
                  <i class="bi bi-arrow-right text-primary small"></i>
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section Bottom -->
  <CTASection
    title="Siapkan Tempat PKL Terdekat Anda Bersama PKL di Saka"
    lead="Jangan biarkan slot divisi favorit Anda terisi penuh. Amankan kuota tempat PKL terdekat dari sekarang dengan membawa surat pengantar resmi dari pihak sekolah."
    primaryBtn={{ label: 'Daftar PKL Sekarang', href: '/cara-daftar/' }}
    secondaryBtn={{ label: 'Tanya Kuota via WhatsApp', href: waLink('Halo Tim PKL di Saka, saya ingin memastikan kuota tempat PKL terdekat untuk periode magang sekolah saya.'), isExternal: true }}
  />
</BaseLayout>

