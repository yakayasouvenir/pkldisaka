---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StatusNotice from '../components/StatusNotice.astro';
import FAQList from '../components/FAQList.astro';
import CTASection from '../components/CTASection.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { getPageByPath } from '../data/pklData';
import { faqNode } from '../lib/schema';
import { waLink } from '../data/site';

const page = getPageByPath('/cara-daftar/')!;
const crumbs = [{ name: page.h1, path: page.path }];
---

<BaseLayout
  title={page.title}
  description={page.metaDescription}
  path={page.path}
  crumbs={crumbs}
  schema={page.faqs ? [faqNode(page.path, page.faqs)] : []}
>
  <PageHero
    eyebrow={page.groupName}
    title={page.h1}
    lead={page.summary}
    crumbs={crumbs}
    bgImage="/images/9.webp"
  />

  <section class="content-section">
    <div class="container">
      <div class="row g-4 g-xl-5">
        <div class="col-lg-8">
          <StatusNotice
            status={page.status}
            targetDate={page.targetDate}
            note="Pendaftaran gratis dan tidak dipungut biaya apapun. Hindari pihak-pihak yang meminta pungutan di luar prosedur resmi."
          />

          <article class="article-content">
            <div class="article-summary-box">
              <div class="article-summary-title">
                <i class="bi bi-info-circle-fill me-1"></i>Ringkasan Prosedur Pendaftaran
              </div>
              <p class="article-summary-text">{page.summary}</p>
            </div>

            <!-- Feature Box Prosedur Pendaftaran -->
            <div class="article-feature-box">
              <div class="row g-3 align-items-center">
                <div class="col-md-5">
                  <div class="article-feature-img-wrap">
                    <img
                      src="/images/24.webp"
                      alt="Siswa SMK menyerahkan berkas surat pengantar pendaftaran PKL kepada mentor Saka"
                      loading="lazy"
                      width="480"
                      height="300"
                    />
                    <span class="article-feature-badge">
                      <i class="bi bi-check2-all me-1"></i>Gratis 100%
                    </span>
                  </div>
                </div>
                <div class="col-md-7">
                  <h3 class="h6 fw-bold text-primary mb-2">Tertib Administrasi & Transparan</h3>
                  <p class="small text-muted mb-2">
                    Seluruh proses penerimaan tidak dipungut biaya apapun. Pastikan berkas pengantar dari sekolah dipersiapkan secara resmi.
                  </p>
                  <div class="competency-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span><strong>Surat Pengantar Sekolah:</strong> Dokumen wajib bertanda tangan kepala sekolah/BKK.</span>
                  </div>
                  <div class="competency-item mb-0">
                    <i class="bi bi-check-circle-fill"></i>
                    <span><strong>Konfirmasi Resmi:</strong> Surat balasan dikirimkan dalam 2-4 hari kerja.</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="article-body">
              {page.sections.map((sec, idx) => (
                <div id={`sec-${idx}`} class="mb-4 scroll-mt-header">
                  <h2>{sec.heading}</h2>
                  <div style="white-space: pre-line;">{sec.content}</div>
                  {sec.bullets && (
                    <ul class="mt-3">
                      {sec.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}

              <!-- Dokumentasi Foto Alur Penerimaan (Foto 3 & 4) -->
              <div class="my-4 p-3 p-md-4 rounded-4 bg-light border">
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                  <div>
                    <h3 class="h6 fw-bold text-dark mb-0">
                      <i class="bi bi-camera-fill text-primary me-2"></i>Dokumentasi Alur Penerimaan & Suasana Onboarding
                    </h3>
                    <p class="small text-muted mb-0">Tahapan verifikasi berkas dan pengenalan ruang kerja di studio Saka.</p>
                  </div>
                  <span class="badge bg-white text-primary border shadow-xs">
                    <i class="bi bi-images me-1"></i>Dokumentasi Nyata
                  </span>
                </div>

                <div class="row g-3">
                  <div class="col-md-6">
                    <div class="bg-white rounded-3 overflow-hidden border shadow-xs h-100 d-flex flex-column">
                      <div class="position-relative">
                        <img
                          src="/images/3.webp"
                          alt="Verifikasi berkas surat pengantar dan wawancara pengenalan kompetensi di Saka"
                          loading="lazy"
                          class="w-100 object-fit-cover"
                          style="height: 195px;"
                        />
                        <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 end-0 m-2">
                          <i class="bi bi-check-circle me-1"></i>Verifikasi Berkas
                        </span>
                      </div>
                      <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="fw-bold small text-dark mb-1">Verifikasi Berkas & Wawancara Minat</div>
                        <p class="small text-muted mb-0">Pemeriksaan legalitas surat pengantar sekolah dan diskusi ringan mengenai divisi minat serta ekspektasi belajar peserta.</p>
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="bg-white rounded-3 overflow-hidden border shadow-xs h-100 d-flex flex-column">
                      <div class="position-relative">
                        <img
                          src="/images/22.webp"
                          alt="Penyambutan dan orientasi ruang kerja peserta magang di Saka"
                          loading="lazy"
                          class="w-100 object-fit-cover"
                          style="height: 195px;"
                        />
                        <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 end-0 m-2">
                          <i class="bi bi-door-open me-1"></i>Hari Pertama
                        </span>
                      </div>
                      <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="fw-bold small text-dark mb-1">Hari Pertama & Pengenalan Mentor</div>
                        <p class="small text-muted mb-0">Peserta yang diterima disambut hangat, diperkenalkan ke rekan satu tim, dan langsung mendapatkan penjelasan deskripsi proyek awal.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Checklist Kesiapan Hari Pertama Masuk PKL -->
              <div class="my-4 p-3 p-md-4 rounded-4 bg-white border shadow-xs">
                <h3 class="h6 fw-bold text-dark mb-2">
                  <i class="bi bi-card-checklist text-primary me-2"></i>Checklist Masuk Kerja Hari Pertama
                </h3>
                <p class="small text-muted mb-3">Hal-hal yang perlu disiapkan peserta saat hadir di hari pertama magang:</p>
                <div class="row g-2">
                  <div class="col-sm-6">
                    <div class="p-2.5 bg-light rounded-3 border h-100">
                      <div class="fw-bold small text-dark">1. Pakaian & Kerapian</div>
                      <div class="small text-muted" style="font-size: 0.8rem;">Seragam kejuruan sekolah / kemeja berkerah rapi, celana kain/gelap, dan sepatu tertutup.</div>
                    </div>
                  </div>
                  <div class="col-sm-6">
                    <div class="p-2.5 bg-light rounded-3 border h-100">
                      <div class="fw-bold small text-dark">2. Berkas Fisik Cetak</div>
                      <div class="small text-muted" style="font-size: 0.8rem;">Membawa 1 rangkap fisik surat pengantar bertanda tangan basah dan buku jurnal/logbook sekolah.</div>
                    </div>
                  </div>
                  <div class="col-sm-6">
                    <div class="p-2.5 bg-light rounded-3 border h-100">
                      <div class="fw-bold small text-dark">3. Perangkat Pendukung</div>
                      <div class="small text-muted" style="font-size: 0.8rem;">Laptop pribadi (disarankan untuk divisi RPL, DKV & Digital Marketing) beserta charger dan mouse.</div>
                    </div>
                  </div>
                  <div class="col-sm-6">
                    <div class="p-2.5 bg-light rounded-3 border h-100">
                      <div class="fw-bold small text-dark">4. Waktu Kehadiran</div>
                      <div class="small text-muted" style="font-size: 0.8rem;">Hadir 15 menit sebelum pukul 08.00 WIB untuk absensi kedatangan dan briefing pagi bersama mentor.</div>
                    </div>
                  </div>
                </div>
              </div>

              <h2 class="mt-4 mb-3">Tautan Berkas Pendukung</h2>
              <div class="row g-3">
                <div class="col-md-4">
                  <a href="/dokumen-pkl/surat-pengantar/" class="p-3 border rounded text-decoration-none d-block bg-white hover-shadow">
                    <div class="fw-bold text-primary"><i class="bi bi-file-earmark-check me-1"></i>Surat Pengantar</div>
                    <div class="small text-muted">Format resmi dari pihak sekolah/BKK.</div>
                  </a>
                </div>
                <div class="col-md-4">
                  <a href="/dokumen-pkl/cv-magang/" class="p-3 border rounded text-decoration-none d-block bg-white hover-shadow">
                    <div class="fw-bold text-primary"><i class="bi bi-person-badge me-1"></i>Format CV Magang</div>
                    <div class="small text-muted">Contoh CV 1 halaman untuk pemula.</div>
                  </a>
                </div>
                <div class="col-md-4">
                  <a href="/dokumen-pkl/portofolio-dkv/" class="p-3 border rounded text-decoration-none d-block bg-white hover-shadow">
                    <div class="fw-bold text-primary"><i class="bi bi-collection me-1"></i>Portofolio Desain</div>
                    <div class="small text-muted">Khusus pendaftar DKV & Multimedia.</div>
                  </a>
                </div>
              </div>
            </div>

            <RelatedLinks urls={page.relatedUrls} />
          </article>
        </div>

        <!-- Sidebar Cara Daftar -->
        <div class="col-lg-4">
          <aside class="detail-sidebar">
            <div class="sidebar-widget sidebar-cta-card">
              <div class="d-inline-flex align-items-center gap-1.5 badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 mb-2 font-monospace" style="font-size: 0.72rem;">
                <i class="bi bi-send-fill text-primary"></i>
                <span>Jalur Pengajuan Cepat</span>
              </div>
              <h3 class="h6 fw-bold text-dark mb-2">Kirim Berkas Pendaftaran</h3>
              <p class="small text-muted mb-3" style="font-size: 0.85rem; line-height: 1.5;">
                Sudah mengantongi surat rekomendasi sekolah? Langsung konfirmasi jadwal dan divisi Anda melalui WhatsApp resmi.
              </p>
              <a
                href={waLink('Halo Admin PKL di Saka, saya ingin konsultasi pendaftaran magang.')}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary w-100 rounded-pill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm"
              >
                <i class="bi bi-whatsapp"></i>
                <span>Kirim via WhatsApp</span>
              </a>
              <div class="d-flex align-items-center justify-content-center gap-2 mt-2 text-muted" style="font-size: 0.74rem;">
                <i class="bi bi-shield-check text-success"></i>
                <span>Verifikasi Berkas Resmi & Bebas Biaya</span>
              </div>
            </div>

            <div class="sidebar-widget">
              <div class="sidebar-widget-title">
                <i class="bi bi-check2-square text-primary"></i>
                <span>Checklist Berkas Wajib</span>
              </div>
              <ul class="sidebar-toc-list">
                <li class="sidebar-toc-link">
                  <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                  <span>Surat Pengantar / Permohonan resmi dari Sekolah atau Kampus</span>
                </li>
                <li class="sidebar-toc-link">
                  <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                  <span>Curriculum Vitae (CV) ringkas 1 halaman</span>
                </li>
                <li class="sidebar-toc-link">
                  <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                  <span>Portofolio karya desain/proyek (khusus DKV/RPL)</span>
                </li>
              </ul>
            </div>

            <div class="sidebar-widget">
              <div class="sidebar-widget-title">
                <i class="bi bi-hourglass-split text-warning"></i>
                <span>Tahapan Seleksi Cepat</span>
              </div>
              <div class="sidebar-facts-list">
                <div class="sidebar-fact-item">
                  <span class="fact-label">1. Kirim Berkas:</span>
                  <span class="fact-val">Email / WA Resmi</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">2. Wawancara:</span>
                  <span class="fact-val">Online / Tatap Muka</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">3. Surat Balasan:</span>
                  <span class="fact-val text-primary">2 – 4 Hari Kerja</span>
                </div>
                <div class="sidebar-fact-item">
                  <span class="fact-label">4. Orientasi:</span>
                  <span class="fact-val">Hari Pertama PKL</span>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  {page.faqs && (
    <FAQList
      items={page.faqs}
      id="faq-cara-daftar"
      title="Pertanyaan Seputar Pendaftaran"
    />
  )}

  <CTASection
    title="Sudah Siap dengan Berkas Anda?"
    description="Kirimkan berkas permohonan PKL Anda via WhatsApp untuk pengecekan kuota awal."
    primaryHref={waLink('Halo Admin PKL di Saka, saya sudah menyiapkan berkas pengajuan magang.')}
    primaryText="Kirim Berkas via WhatsApp"
  />
</BaseLayout>
