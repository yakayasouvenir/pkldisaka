---
// src/pages/mitra.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StatusNotice from '../components/StatusNotice.astro';
import FAQList from '../components/FAQList.astro';
import CTASection from '../components/CTASection.astro';
import { SCHOOL_PARTNERS, PARTNERSHIP_BENEFITS } from '../data/partners';
import { faqNode } from '../lib/schema';
import { waLink } from '../data/site';

const crumbs = [{ name: 'Sekolah Mitra', path: '/mitra/' }];

const faqs = [
  {
    q: 'Bagaimana cara sekolah atau kampus mengajukan kemitraan PKL dengan Saka?',
    a: 'Pihak sekolah (Kepala Sekolah, Koordinator BKK, atau Hubin) dapat mengirimkan surat permohonan kemitraan atau MoU resmi melalui email info@pkldisaka.com atau berkoordinasi via WhatsApp resmi kami.',
  },
  {
    q: 'Apakah ada kuota khusus bagi sekolah yang telah menjadi mitra?',
    a: 'Sekolah mitra memperoleh prioritas jadwal konfirmasi kuota lebih awal sebelum kalender akademik dimulai, dengan tetap mengutamakan kelengkapan berkas siswa pemohon.',
  },
  {
    q: 'Apakah guru pembimbing dari sekolah diperkenankan melakukan monitoring langsung?',
    a: 'Sangat diperkenankan. Kami menyambut kunjungan monitoring guru pembimbing sekolah ke kantor/studio kami di Malang dengan konfirmasi jadwal sebelumnya.',
  },
  {
    q: 'Bagaimana mekanisme evaluasi dan pengisian nilai akhir siswa dari sekolah?',
    a: 'Mentor industri akan mengisi blangko penilaian resmi yang dibawa siswa dari sekolah, melampirkan lembar kehadiran, serta menerbitkan Sertifikat PKL resmi dari Saka.',
  },
];
---

<BaseLayout
  title="Sekolah & Institusi Mitra PKL di Saka Malang"
  description="Daftar sekolah SMK dan institusi perguruan tinggi vokasi yang muridnya pernah atau bekerja sama dalam PKL dan magang industri di Saka Malang."
  path="/mitra/"
  crumbs={crumbs}
  schema={[faqNode('/mitra/', faqs)]}
>
  <PageHero
    eyebrow="Ekosistem Kemitraan Vokasi"
    title="Sekolah & Institusi Mitra PKL di Saka"
    lead="Membangun sinergi berkelanjutan bersama SMK Negeri, SMK Swasta, dan Perguruan Tinggi Vokasi di Jawa Timur untuk mencetak talenta digital berstandar industri."
    crumbs={crumbs}
    bgImage="/images/6.webp"
  />

  <section class="content-section">
    <div class="container">
      <StatusNotice
        status="Informasi Kemitraan Vokasi"
        note="Data sekolah dan institusi di halaman ini mencerminkan riwayat penempatan siswa PKL dan koordinasi resmi bersama BKK/Hubin sekolah."
      />

      <!-- 1. MANFAAT KEMITRAAN BAGI SEKOLAH -->
      <div class="mb-5">
        <div class="text-center mx-auto mb-4" style="max-width: 720px;">
          <span class="section-heading-eyebrow">Nilai Tambah Kerja Sama</span>
          <h2 class="section-heading-title">Mengapa Sekolah Bermitra dengan Saka?</h2>
          <p class="section-heading-desc">
            Kami memastikan setiap siswa yang dikirimkan memperoleh pengalaman kerja otentik, lingkungan aman, dan bimbingan terstruktur.
          </p>
        </div>

        <div class="row g-4">
          {PARTNERSHIP_BENEFITS.map((b) => (
            <div class="col-md-6 col-lg-3">
              <div class="saka-card h-100 p-4">
                <div class="saka-card-icon mb-3">
                  <i class={`bi ${b.icon}`}></i>
                </div>
                <h3 class="h6 fw-bold mb-2">{b.title}</h3>
                <p class="small text-muted mb-0">{b.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 2. DAFTAR SEKOLAH & INSTITUSI MITRA -->
      <div class="mb-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
          <div>
            <span class="section-heading-eyebrow">Riwayat & Jaringan</span>
            <h2 class="section-heading-title mb-0">Institusi Sekolah & Kampus Mitra</h2>
          </div>
          <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
            <i class="bi bi-buildings me-1"></i> {SCHOOL_PARTNERS.length} Institusi Pendidikan Terdaftar
          </div>
        </div>

        <div class="partner-showcase-bg">
          <div class="row g-4">
            {SCHOOL_PARTNERS.map((p) => (
              <div class="col-md-6 col-lg-4">
                <div class="partner-card-glass h-100 p-4 d-flex flex-column">
                  <!-- Header: Logo Sekolah & Meta Info -->
                  <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="partner-logo-container">
                      <img
                        src={p.logo}
                        alt={`Logo ${p.name}`}
                        class="partner-school-logo-img"
                        width="46"
                        height="46"
                        loading="lazy"
                      />
                    </div>
                    <div class="flex-grow-1 min-w-0">
                      <div class="d-flex align-items-center justify-content-between gap-1 mb-1">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 0.68rem;">
                          {p.type}
                        </span>
                        <span class="small text-muted" style="font-size: 0.76rem;">
                          <i class="bi bi-geo-alt text-danger me-1"></i>{p.city}
                        </span>
                      </div>
                      <h3 class="h6 fw-bold text-dark mb-0 line-clamp-2" style="font-size: 0.98rem; line-height: 1.35;">
                        {p.name}
                      </h3>
                    </div>
                  </div>

                  <p class="small text-muted mb-3 flex-grow-1" style="font-size: 0.86rem; line-height: 1.55;">
                    {p.description}
                  </p>

                  <div class="pt-3 border-top mt-auto" style="border-color: rgba(226, 232, 240, 0.8) !important;">
                    <div class="small fw-semibold text-secondary mb-1" style="font-size: 0.78rem;">Peminatan / Jurusan:</div>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                      {p.focusDepartments.map((d) => (
                        <span class="badge bg-white text-secondary border font-monospace shadow-2xs" style="font-size: 0.7rem; font-weight: 500;">
                          {d}
                        </span>
                      ))}
                    </div>
                    <div class="small text-muted" style="font-size: 0.78rem;">
                      <i class="bi bi-patch-check-fill text-primary me-1"></i>
                      <strong>Program:</strong> {p.partnershipType}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- 3. ALUR PENGAJUAN KERJA SAMA BARU (UNTUK GURU & HUBIN) -->
      <div class="p-4 p-lg-5 border rounded-4 bg-light mb-5">
        <div class="row g-4 align-items-center">
          <div class="col-lg-6">
            <span class="section-heading-eyebrow">Khusus Guru BKK & Koordinator PKL</span>
            <h2 class="h3 fw-bold mb-3">Ingin Menjalin Kemitraan Resmi untuk Sekolah Anda?</h2>
            <p class="text-muted mb-4">
              Saka membuka pintu selebar-lebarnya bagi SMK dan kampus vokasi baru yang ingin menempatkan peserta didiknya. Kami siap menyelaraskan penugasan proyek dengan Capaian Pembelajaran sekolah Anda.
            </p>
            <div class="d-flex flex-wrap gap-3">
              <a href={waLink('Halo Tim Kemitraan Saka, saya Koordinator BKK/Hubin sekolah ingin mendiskusikan peluang kerja sama penempatan PKL.')} class="btn-primary-saka" target="_blank" rel="noopener">
                <i class="bi bi-whatsapp"></i>
                <span>Hubungi Divisi Kemitraan</span>
              </a>
              <a href="/cara-daftar/" class="btn-secondary-saka">
                <i class="bi bi-file-earmark-text"></i>
                <span>Prosedur Pengajuan</span>
              </a>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="bg-white p-4 rounded-3 border shadow-sm">
              <h3 class="h6 fw-bold text-dark mb-3"><i class="bi bi-diagram-3-fill text-primary me-2"></i>4 Langkah Sederhana Kemitraan:</h3>
              <div class="d-flex align-items-start gap-3 mb-3">
                <div class="badge bg-primary rounded-circle p-2 px-3 fw-bold">1</div>
                <div>
                  <div class="fw-bold small">Koordinasi Awal</div>
                  <div class="small text-muted">Hubungi narahubung resmi kami untuk memeriksa kuota divisi dan jadwal semester.</div>
                </div>
              </div>
              <div class="d-flex align-items-start gap-3 mb-3">
                <div class="badge bg-primary rounded-circle p-2 px-3 fw-bold">2</div>
                <div>
                  <div class="fw-bold small">Penerbitan Surat Pengantar</div>
                  <div class="small text-muted">Sekolah menerbitkan surat resmi permohonan PKL yang mencantumkan nama siswa dan jurusan.</div>
                </div>
              </div>
              <div class="d-flex align-items-start gap-3 mb-3">
                <div class="badge bg-primary rounded-circle p-2 px-3 fw-bold">3</div>
                <div>
                  <div class="fw-bold small">Penerbitan Surat Balasan</div>
                  <div class="small text-muted">Saka menerbitkan surat konfirmasi penerimaan resmi berkop surat untuk arsip BKK sekolah.</div>
                </div>
              </div>
              <div class="d-flex align-items-start gap-3">
                <div class="badge bg-primary rounded-circle p-2 px-3 fw-bold">4</div>
                <div>
                  <div class="fw-bold small">Pelaksanaan & Monitoring</div>
                  <div class="small text-muted">Peserta memulai orientasi kerja dan guru pembimbing dapat memonitor progres kapan saja.</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. FAQ KEMITRAAN SEKOLAH -->
  <FAQList
    items={faqs}
    id="faq-mitra"
    title="Pertanyaan Seputar Kemitraan Sekolah & Kampus"
    description="Rangkuman hal-hal penting yang sering ditanyakan oleh pihak BKK, Hubin, dan guru pembimbing sekolah."
  />

  <CTASection
    title="Siapkan Peserta Didik Anda Menuju Dunia Kerja Industri"
    description="Diskusikan kuota dan jadwal penempatan PKL sekolah Anda bersama tim kemitraan Saka sekarang."
    primaryHref="/cara-daftar/"
    primaryText="Pelajari Syarat Berkas"
    secondaryHref={waLink('Halo Saka, saya ingin menanyakan kerja sama kemitraan PKL sekolah.')}
    secondaryText="Chat WhatsApp Kemitraan"
  />
</BaseLayout>
