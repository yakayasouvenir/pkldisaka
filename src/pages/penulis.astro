---
// src/pages/penulis.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StatusNotice from '../components/StatusNotice.astro';
import CTASection from '../components/CTASection.astro';
import { getCollection } from 'astro:content';

const crumbs = [
  { name: 'Blog', path: '/blog/' },
  { name: 'Penulis', path: '/penulis/' },
];

const allPosts = await getCollection('blog');
const authorName = 'Mochammad Evan Pratama';

// Filter articles written by Mochammad Evan Pratama
const authorPosts = allPosts
  .filter((p) => p.data.author === authorName)
  .sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime());

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(d));
---

<BaseLayout
  title={`${authorName} - Profil Penulis & Praktisi Vokasi | pkldisaka.id`}
  description={`Profil profesional ${authorName}, praktisi industri digital dan pembina program vokasi di CV Saudagar Kaya Abadi Malang. Kumpulan artikel dan panduan magang kejuruan.`}
  path="/penulis/"
  crumbs={crumbs}
>
  <PageHero
    eyebrow="Profil Penulis & Praktisi Industri"
    title={authorName}
    lead="Praktisi industri digital, pembina program vokasi SMK, dan reviewer kurikulum magang terapan di CV Saudagar Kaya Abadi Malang."
    crumbs={crumbs}
    bgImage="/images/blog-hero.webp"
  />

  <section class="content-section py-4 py-md-5">
    <div class="container">
      <!-- Modern Mobile-First Author Profile Card -->
      <div class="author-hero-card mb-4 mb-md-5">
        <div class="row g-4 align-items-center">
          <div class="col-12 col-md-auto text-center text-md-start">
            <div class="position-relative d-inline-block">
              <img
                src="/images/penulis-evan.webp"
                alt={`Foto profil resmi ${authorName}`}
                class="author-avatar-img shadow-sm"
                width="140"
                height="140"
              />
              <span class="author-verified-badge" title="Terverifikasi Praktisi Industri">
                <i class="bi bi-patch-check-fill"></i>
              </span>
            </div>
          </div>
          
          <div class="col-12 col-md">
            <div class="d-flex flex-wrap justify-content-center justify-content-md-start align-items-center gap-2 mb-2">
              <span class="badge bg-primary text-white font-monospace px-3 py-1">Penulis Artikel</span>
              <span class="badge bg-light text-secondary border font-monospace px-3 py-1">Saka Malang</span>
            </div>
            
            <h1 class="h3 fw-bold text-dark text-center text-md-start mb-1">{authorName}</h1>
            
            <div class="text-primary fw-semibold text-center text-md-start mb-3" style="font-size: 0.95rem;">
              Penulis Artikel & Reviewer Vokasi Industri CV Saudagar Kaya Abadi
            </div>
            
            <p class="text-muted text-center text-md-start mb-3" style="line-height: 1.7; font-size: 0.92rem;">
              Mochammad Evan Pratama aktif membina peserta didik vokasi tingkat SMK dan perguruan tinggi dalam program Praktik Kerja Lapangan (PKL) di Kota Malang. Berfokus pada penyiapan talenta muda di bidang Rekayasa Perangkat Lunak (RPL), Teknik Komputer dan Jaringan (TKJ), Desain Komunikasi Visual (DKV), serta Pemasaran Digital agar memiliki portofolio proyek terstandar dan mentalitas kerja profesional.
            </p>

            <!-- Quick Stats in Mobile/Desktop -->
            <div class="author-stats-bar mb-3">
              <div class="stat-item">
                <span class="stat-number">{authorPosts.length}</span>
                <span class="stat-label">Artikel Terbit</span>
              </div>
              <div class="stat-item">
                <span class="stat-number">4+</span>
                <span class="stat-label">Jurusan Binaan</span>
              </div>
              <div class="stat-item">
                <span class="stat-number">100%</span>
                <span class="stat-label">Standar Vokasi</span>
              </div>
            </div>
            
            <!-- Skill Tags Pills -->
            <div class="d-flex flex-wrap justify-content-center justify-content-md-start gap-1">
              <span class="badge bg-light-subtle text-dark border px-2 py-1 small">Rekayasa Perangkat Lunak</span>
              <span class="badge bg-light-subtle text-dark border px-2 py-1 small">Teknik Komputer & Jaringan</span>
              <span class="badge bg-light-subtle text-dark border px-2 py-1 small">SEO & Web Development</span>
              <span class="badge bg-light-subtle text-dark border px-2 py-1 small">CV Saudagar Kaya Abadi</span>
            </div>
          </div>
        </div>
      </div>

      <StatusNotice
        status="Arsip Karya & Panduan"
        note={`Menampilkan seluruh ${authorPosts.length} artikel panduan resmi yang ditulis oleh ${authorName} untuk membimbing siswa magang di Malang.`}
      />

      <!-- Articles Grid: Optimized for Mobile & Desktop -->
      <div class="row g-3 g-md-4 mb-5">
        {authorPosts.map((post, idx) => (
          <div class="col-12 col-md-6 d-flex">
            <article class="card author-article-card w-100 border-0 rounded-4 shadow-sm overflow-hidden d-flex flex-column">
              <!-- Compact horizontal on mobile, card on tablet+ -->
              <div class="row g-0 flex-grow-1 align-items-stretch">
                <!-- Image column -->
                <div class="col-4 col-sm-4 col-md-12">
                  <a href={`/blog/${post.id}/`} class="author-card-thumb d-block text-decoration-none h-100" aria-label={`Baca: ${post.data.title}`}>
                    <img
                      src={post.data.image}
                      alt={post.data.imageAlt}
                      class="author-post-img"
                      loading="lazy"
                      width="600"
                      height="340"
                    />
                    <span class="badge bg-primary text-white position-absolute top-0 start-0 m-2 d-none d-md-inline-block shadow-xs" style="font-size: 0.75rem;">
                      {post.data.category}
                    </span>
                  </a>
                </div>

                <!-- Content column -->
                <div class="col-8 col-sm-8 col-md-12 d-flex flex-column">
                  <div class="card-body p-3 p-md-4 d-flex flex-column flex-grow-1">
                    <div class="d-flex flex-wrap align-items-center gap-2 small text-muted mb-1 mb-md-2" style="font-size: 0.75rem;">
                      <span class="badge bg-primary-subtle text-primary border-0 d-inline-block d-md-none" style="font-size: 0.7rem;">
                        {post.data.category}
                      </span>
                      <span><i class="bi bi-calendar3 me-1"></i>{formatDate(post.data.published)}</span>
                      <span class="d-none d-sm-inline">&bull;</span>
                      <span class="d-none d-sm-inline"><i class="bi bi-clock me-1"></i>{post.data.readingTime}</span>
                    </div>

                    <h2 class="h6 fw-bold mb-1 mb-md-2 author-post-title">
                      <a href={`/blog/${post.id}/`} class="text-dark text-decoration-none">
                        {post.data.title}
                      </a>
                    </h2>

                    <p class="text-muted small mb-2 mb-md-3 flex-grow-1 author-post-desc d-none d-sm-block" style="line-height: 1.5; font-size: 0.84rem;">
                      {post.data.description}
                    </p>

                    <div class="d-flex align-items-center justify-content-between pt-2 pt-md-3 border-top mt-auto">
                      <span class="small text-muted d-none d-md-inline" style="font-size: 0.78rem;">
                        <i class="bi bi-person-fill text-primary me-1"></i>{post.data.author}
                      </span>
                      <a
                        href={`/blog/${post.id}/`}
                        class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 text-decoration-none w-100 w-md-auto justify-content-center"
                        style="font-size: 0.8rem; padding: 0.35rem 0.75rem;"
                      >
                        <span>Baca Panduan</span>
                        <i class="bi bi-arrow-right"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  /* Mobile-first modern styling for Penulis page */
  .author-hero-card {
    background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 1.25rem;
    padding: 1.5rem;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
  }

  @media (min-width: 768px) {
    .author-hero-card {
      padding: 2.25rem;
    }
  }

  .author-avatar-img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    border: 4px solid #ffffff;
    box-shadow: 0 8px 16px -4px rgba(37, 99, 235, 0.2);
  }

  @media (min-width: 768px) {
    .author-avatar-img {
      width: 140px;
      height: 140px;
    }
  }

  .author-verified-badge {
    position: absolute;
    bottom: 5px;
    right: 5px;
    background: #ffffff;
    color: #2563eb;
    border-radius: 50%;
    font-size: 1.4rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .author-stats-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 0.85rem 1.25rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.85rem;
    max-width: 420px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .author-stats-bar {
      margin: 0 0 1rem 0;
      justify-content: flex-start;
    }
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-weight: 800;
    font-size: 1.15rem;
    color: #1e293b;
    line-height: 1.2;
  }

  .stat-label {
    display: block;
    font-size: 0.72rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  /* Article cards */
  .author-article-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.85) !important;
  }

  .author-article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -6px rgba(15, 23, 42, 0.08) !important;
  }

  .author-card-thumb {
    position: relative;
    overflow: hidden;
    background-color: #f1f5f9;
  }

  .author-post-img {
    width: 100%;
    height: 100%;
    min-height: 110px;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  @media (min-width: 768px) {
    .author-post-img {
      height: 200px;
    }
  }

  .author-article-card:hover .author-post-img {
    transform: scale(1.04);
  }

  .author-post-title {
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .author-post-title a:hover {
    color: #2563eb !important;
  }

  .author-post-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
