---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StatusNotice from '../components/StatusNotice.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { getPageByPath } from '../data/pklData';
import { SITE, mapsLink, waLink } from '../data/site';

const page = getPageByPath('/kontak/')!;
const crumbs = [{ name: page.h1, path: page.path }];
---

<BaseLayout
  title={page.title}
  description={page.metaDescription}
  path={page.path}
  crumbs={crumbs}
>
  <PageHero
    eyebrow={page.groupName}
    title={page.h1}
    lead={page.summary}
    crumbs={crumbs}
    bgImage="/images/9.webp"
  />

  <section class="content-section">
    <div class="container">
      <StatusNotice
        status={page.status}
        targetDate={page.targetDate}
        note="Pastikan seluruh komunikasi terkait administrasi PKL hanya dilakukan melalui kanal resmi yang tertera di halaman ini."
      />

      <div class="row g-4 mb-5">
        <!-- Col 1: Kontak Resmi -->
        <div class="col-lg-6">
          <div class="saka-card p-4">
            <h2 class="h5 fw-bold mb-3"><i class="bi bi-headset text-primary me-2"></i>Kanal Komunikasi Terverifikasi</h2>
            
            <div class="d-flex align-items-start gap-3 mb-3">
              <div class="saka-card-icon mb-0 flex-shrink-0" style="width: 40px; height: 40px;">
                <i class="bi bi-whatsapp text-success"></i>
              </div>
              <div>
                <div class="fw-bold">WhatsApp Resmi Pelayanan</div>
                <div class="small text-muted">{SITE.phoneDisplay} (Senin - Jumat, 08.00 - 16.00 WIB)</div>
                <a href={waLink()} target="_blank" rel="noopener" class="btn btn-sm btn-outline-success mt-2 rounded-pill">
                  Buka Chat WhatsApp
                </a>
              </div>
            </div>

            <div class="d-flex align-items-start gap-3 mb-3">
              <div class="saka-card-icon mb-0 flex-shrink-0" style="width: 40px; height: 40px;">
                <i class="bi bi-envelope text-primary"></i>
              </div>
              <div>
                <div class="fw-bold">Email Koordinasi Berkas</div>
                <div class="small text-muted">{SITE.email}</div>
                <a href={`mailto:${SITE.email}`} class="btn btn-sm btn-outline-primary mt-2 rounded-pill">
                  Kirim Email
                </a>
              </div>
            </div>

            <div class="d-flex align-items-start gap-3">
              <div class="saka-card-icon mb-0 flex-shrink-0" style="width: 40px; height: 40px;">
                <i class="bi bi-geo-alt text-danger"></i>
              </div>
              <div>
                <div class="fw-bold">Wilayah Operasional</div>
                <div class="small text-muted">{SITE.address.full}</div>
                <small class="text-muted d-block mt-1">
                  <em>*Pertemuan tatap muka hanya dilayani dengan konfirmasi janji temu sebelumnya.</em>
                </small>
              </div>
            </div>
          </div>
        </div>

        <!-- Col 2: Formulir Pertanyaan (DESIGN.md Bab 4.H) -->
        <div class="col-lg-6">
          <div class="saka-card p-4">
            <h2 class="h5 fw-bold mb-3"><i class="bi bi-chat-left-text text-primary me-2"></i>Formulir Pertanyaan & Verifikasi</h2>
            <p class="small text-muted mb-3">
              Kirimkan pesan Anda secara langsung. Seluruh data identitas hanya digunakan untuk keperluan koordinasi administrasi magang.
            </p>

            <form id="contactForm" onsubmit="event.preventDefault(); alert('Terima kasih. Pesan Anda telah dicatat, tim kami akan merespons melalui email/WhatsApp yang dicantumkan.');">
              <div class="mb-3">
                <label for="fullName" class="form-label small fw-semibold">Nama Lengkap *</label>
                <input type="text" id="fullName" class="form-control form-control-sm" required placeholder="Contoh: Budi Santoso" />
              </div>

              <div class="mb-3">
                <label for="institution" class="form-label small fw-semibold">Asal Sekolah / Perguruan Tinggi *</label>
                <input type="text" id="institution" class="form-control form-control-sm" required placeholder="Contoh: SMKN 4 Malang" />
              </div>

              <div class="mb-3">
                <label for="contactInfo" class="form-label small fw-semibold">Nomor WhatsApp / Email Aktif *</label>
                <input type="text" id="contactInfo" class="form-control form-control-sm" required placeholder="08xxxxxxxxxx atau email@gmail.com" />
              </div>

              <div class="mb-3">
                <label for="messageText" class="form-label small fw-semibold">Pesan / Pertanyaan *</label>
                <textarea id="messageText" class="form-control form-control-sm" rows="3" required placeholder="Tuliskan pertanyaan seputar kuota divisi atau alur berkas..."></textarea>
              </div>

              <button type="submit" class="btn-primary-saka w-100 py-2">
                <i class="bi bi-send me-1"></i>Kirim Pesan
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Dokumentasi Foto Lokasi & Ruang Pertemuan (Foto 2 & 3) -->
      <div class="my-5 p-3 p-md-4 rounded-4 bg-light border">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
          <div>
            <h3 class="h6 fw-bold text-dark mb-0">
              <i class="bi bi-camera-fill text-primary me-2"></i>Dokumentasi Ruang Konsultasi & Studio Kerja
            </h3>
            <p class="small text-muted mb-0">Area penerimaan berkas, ruang diskusi, dan fasilitas pendukung di Saka.</p>
          </div>
          <span class="badge bg-white text-primary border shadow-xs">
            <i class="bi bi-building me-1"></i>Fasilitas Fisik
          </span>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <div class="bg-white rounded-3 overflow-hidden border shadow-xs h-100 d-flex flex-column">
              <div class="position-relative">
                <img
                  src="/images/3.webp"
                  alt="Penyerahan surat pengantar dan verifikasi berkas PKL di Saka"
                  loading="lazy"
                  class="w-100 object-fit-cover"
                  style="height: 195px;"
                />
                <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 end-0 m-2">
                  <i class="bi bi-chat-dots-fill me-1"></i>Ruang Asistensi
                </span>
              </div>
              <div class="p-3 d-flex flex-column flex-grow-1">
                <div class="fw-bold small text-dark mb-1">Ruang Asistensi & Pertemuan Guru</div>
                <p class="small text-muted mb-0">Digunakan untuk penyerahan surat pengantar fisik dari guru pembimbing sekolah serta monitoring berkala peserta magang.</p>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="bg-white rounded-3 overflow-hidden border shadow-xs h-100 d-flex flex-column">
              <div class="position-relative">
                <img
                  src="/images/10.webp"
                  alt="Fasilitas ruang kerja studio dan workstation laptop di Saka"
                  loading="lazy"
                  class="w-100 object-fit-cover"
                  style="height: 195px;"
                />
                <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 end-0 m-2">
                  <i class="bi bi-laptop me-1"></i>Studio Kerja
                </span>
              </div>
              <div class="p-3 d-flex flex-column flex-grow-1">
                <div class="fw-bold small text-dark mb-1">Studio Kerja Kolaboratif</div>
                <p class="small text-muted mb-0">Area utama tempat peserta PKL berkolaborasi menyelesaikan penugasan harian dan berdiskusi langsung dengan mentor industri.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="article-content">
        <h2 class="h5 fw-bold mb-3">Panduan Akses Transportasi & Janji Temu</h2>
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <div class="p-3 bg-white rounded-3 border">
              <div class="fw-bold small text-dark mb-1"><i class="bi bi-train-front text-primary me-1"></i>Dari Stasiun Malang Kota Baru</div>
              <p class="small text-muted mb-0">Berjarak sekitar 15-20 menit berkendara via angkutan umum atau ojek online ke arah Blimbing / Kedungkandang.</p>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 bg-white rounded-3 border">
              <div class="fw-bold small text-dark mb-1"><i class="bi bi-bus-front text-primary me-1"></i>Dari Terminal Arjosari</div>
              <p class="small text-muted mb-0">Berjarak sekitar 10-15 menit berkendara melalui jalur lingkar timur kota dengan akses jalan yang nyaman dan bebas macet.</p>
            </div>
          </div>
        </div>

        <h2 class="h5 fw-bold mb-2">Etika Berkomunikasi & Konfirmasi Kunjungan</h2>
        <p class="text-muted">
          Untuk menjaga ketertiban proses kerja industri, seluruh kunjungan tatap muka (termasuk guru pembimbing yang ingin mengantar/menjemput siswa atau survei tempat) <strong>wajib mengonfirmasi janji temu minimal 1 hari sebelumnya</strong> melalui WhatsApp resmi pelayanan kami.
        </p>
        <RelatedLinks urls={page.relatedUrls} />
      </div>
    </div>
  </section>
</BaseLayout>
