<script>
  function setupCopyButton() {
    const copyBtn = document.getElementById('copyDocBtn');
    const copyBottomBtn = document.getElementById('copyDocBottomBtn');
    const copyText = document.getElementById('copyBtnText');
    const paper = document.getElementById('naskah-dokumen');

    function performCopy() {
      if (!paper) return;
      const textToCopy = paper.innerText;
      navigator.clipboard.writeText(textToCopy).then(() => {
        if (copyText) copyText.innerText = 'Naskah Tersalin!';
        if (copyBtn) copyBtn.classList.replace('btn-outline-primary', 'btn-success');
        if (copyBottomBtn) copyBottomBtn.innerText = '✓ Berhasil Disalin ke Clipboard!';

        setTimeout(() => {
          if (copyText) copyText.innerText = 'Salin Seluruh Naskah';
          if (copyBtn) copyBtn.classList.replace('btn-success', 'btn-outline-primary');
          if (copyBottomBtn) copyBottomBtn.innerHTML = '<i class="bi bi-clipboard-check me-1"></i>Salin Seluruh Naskah ke Clipboard';
        }, 3000);
      }).catch(err => {
        console.error('Gagal menyalin:', err);
      });
    }

    if (copyBtn) copyBtn.addEventListener('click', performCopy);
    if (copyBottomBtn) copyBottomBtn.addEventListener('click', performCopy);
  }

  document.addEventListener('DOMContentLoaded', setupCopyButton);
</script>

