---
// src/pages/dokumen-pkl/laporan-pkl.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import StatusNotice from '../../components/StatusNotice.astro';
import FAQList from '../../components/FAQList.astro';
import CTASection from '../../components/CTASection.astro';
import { faqNode } from '../../lib/schema';

const crumbs = [
  { name: 'Dokumen PKL', path: '/dokumen-pkl/surat-lamaran/' },
  { name: 'Contoh Laporan PKL SMK', path: '/dokumen-pkl/laporan-pkl/' },
];

const faqs = [
  {
    q: 'Apakah dokumen contoh laporan PKL SMK ini sesuai dengan format aslinya?',
    a: 'Ya, seluruh halaman dokumen di bawah ini ditampilkan sama persis 100% dengan file asli Microsoft Word dan PDF, lengkap dari Halaman Judul, Motto, Lembar Persembahan, Kata Pengantar, Daftar Isi, Bab I Pendahuluan, Bab II Tinjauan DUDI, Bab III Dokumentasi Belajar Nyata (13 Kegiatan), Bab IV Penutup, hingga Lampiran.',
  },
  {
    q: 'Bagaimana cara mengunduh dokumen laporan PKL ini?',
    a: 'Anda dapat mengklik tombol "Download PDF" untuk berkas siap cetak, atau tombol "Download Word (.docx)" untuk mendapatkan file mentah yang dapat diedit di laptop Anda.',
  },
  {
    q: 'Apakah format laporan ini berlaku untuk semua jurusan SMK?',
    a: 'Format baku ini bersifat universal dan memenuhi standar kurikulum SMK. Untuk Bab III, Anda tinggal menyesuaikan dokumentasi aktivitas sesuai divisi jurusan Anda (RPL, TKJ, DKV, Multimedia, atau Pemasaran).',
  },
];

// 32 Halaman Dokumen Asli yang dirender 100% presisi
const totalPages = 32;
const docPages = Array.from({ length: totalPages }, (_, i) => ({
  pageNumber: i + 1,
  src: `/images/laporan-pages/page_${i + 1}.jpg`,
  alt: `Dokumen Asli Laporan PKL SMK Halaman ${i + 1}`,
}));
---

<BaseLayout
  title="Contoh Laporan PKL SMK Lengkap Doc & PDF Sesuai Standar Industri | pkldisaka.id"
  description="Dokumen asli contoh laporan PKL SMK lengkap dan benar: Cover, Lembar Pengesahan, Bab I Pendahuluan, Bab II Tinjauan DUDI, Bab III Hasil Belajar, Bab IV Penutup, dan Lampiran."
  path="/dokumen-pkl/laporan-pkl/"
  crumbs={crumbs}
  schema={[faqNode('/dokumen-pkl/laporan-pkl/', faqs)]}
>
  <PageHero
    eyebrow="DOKUMEN & FORMAT BAKU PKL"
    title="Contoh Laporan PKL SMK Lengkap (Dokumen Asli)"
    lead="Format dan tata letak naskah laporan Praktik Kerja Lapangan (PKL) SMK presisi 100% sesuai dokumen asli. Dapat langsung dibaca di halaman ini atau diunduh dalam format PDF & Word."
    crumbs={crumbs}
    bgImage="/images/9.webp"
  />

  <section class="content-section py-5">
    <div class="container">
      <div class="row g-4 g-xl-5 justify-content-center">
        <div class="col-lg-10">
          <StatusNotice
            status="Naskah Resmi Sesuai Dokumen Asli"
            targetDate="10/01/2026"
            note="Dokumen di bawah ini merupakan pratinjau halaman asli dari Template_Laporan_PKL_Universal (32 Halaman Lengkap). Tidak ada teks yang terpotong atau rusak."
          />

          <!-- Quick Action Toolbar / Pilihan Aksi Atas -->
          <div class="card border-primary-subtle shadow-sm mb-4 bg-white rounded-3 overflow-hidden">
            <div class="card-body p-3 p-md-4">
              <div class="row align-items-center g-3">
                <div class="col-md-6">
                  <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary-subtle p-3 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
                      <i class="bi bi-file-earmark-text-fill fs-3 text-primary"></i>
                    </div>
                    <div>
                      <h2 class="h5 fw-bold text-dark mb-1">Pilihan Format Dokumen Asli</h2>
                      <p class="text-muted small mb-0">Total 32 halaman lengkap siap pakai untuk panduan penyusunan laporan sekolah.</p>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 text-md-end">
                  <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-2">
                    <a
                      href="/Template_Laporan_PKL_Universal.pdf"
                      target="_blank"
                      class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1.5 shadow-xs fw-semibold"
                    >
                      <i class="bi bi-file-pdf"></i>
                      <span>Buka File PDF</span>
                    </a>
                    <a
                      href="/Template_Laporan_PKL_Universal.pdf"
                      download="Template_Laporan_PKL_Universal.pdf"
                      class="btn btn-danger btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1.5 shadow-xs text-white fw-semibold"
                    >
                      <i class="bi bi-download"></i>
                      <span>Download PDF</span>
                    </a>
                    <a
                      href="/Template_Laporan_PKL_Universal.docx"
                      download="Template_Laporan_PKL_Universal.docx"
                      class="btn btn-primary-saka btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1.5 shadow-xs text-decoration-none fw-semibold"
                    >
                      <i class="bi bi-file-word"></i>
                      <span>Download Word (.docx)</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Document Exact Pages Container (Hanya 1 Tampilan Dokumen Asli Lengkap & Presisi) -->
          <div class="doc-viewer-wrapper bg-light p-3 p-md-4 rounded-4 border shadow-sm mb-5">
            <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom text-muted small">
              <span class="d-flex align-items-center gap-2 fw-semibold text-dark">
                <i class="bi bi-journal-bookmark-fill text-primary"></i> Pratinjau Naskah Dokumen Asli (32 Halaman)
              </span>
              <span>Tata Letak Standar Kertas A4</span>
            </div>

            <!-- List of exact 32 document pages -->
            <div class="pages-list d-flex flex-column gap-4 align-items-center">
              {docPages.map((page) => (
                <div class="paper-page bg-white rounded-2 shadow-sm border position-relative overflow-hidden w-100" style="max-width: 820px;">
                  <div class="page-badge position-absolute top-0 end-0 bg-dark text-white px-2 py-1 small rounded-bottom-start opacity-75" style="font-size: 0.75rem; z-index: 2;">
                    Halaman {page.pageNumber}
                  </div>
                  <img
                    src={page.src}
                    alt={page.alt}
                    loading={page.pageNumber <= 3 ? "eager" : "lazy"}
                    decoding="async"
                    class="img-fluid w-100 d-block"
                    style="height: auto;"
                  />
                </div>
              ))}
            </div>
          </div>

          <!-- FAQ Component -->
          <FAQList faqs={faqs} />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Global Section -->
  <CTASection />
</BaseLayout>

<style>
  .paper-page {
    border-color: #cbd5e1 !important;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .paper-page:hover {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.05);
  }
</style>
