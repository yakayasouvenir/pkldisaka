---
// src/pages/dokumen-pkl/laporan-pkl.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import StatusNotice from '../../components/StatusNotice.astro';
import FAQList from '../../components/FAQList.astro';
import CTASection from '../../components/CTASection.astro';
import { faqNode } from '../../lib/schema';

const crumbs = [
  { name: 'Dokumen PKL', path: '/dokumen-pkl/surat-lamaran/' },
  { name: 'Contoh Laporan PKL SMK', path: '/dokumen-pkl/laporan-pkl/' },
];

const faqs = [
  {
    q: 'Apakah naskah contoh laporan PKL SMK ini sesuai dengan dokumen aslinya?',
    a: 'Ya, tata letak, susunan bab, halaman judul, motto, persembahan, kata pengantar, daftar isi, 13 dokumentasi kegiatan bergambar, hingga lampiran telah ditransformasikan sama persis sesuai dokumen asli Word (.docx).',
  },
  {
    q: 'Bagaimana cara mengunduh atau menyalin naskah ini?',
    a: 'Anda dapat langsung menekan tombol \'Download Dokumen Asli (.docx)\' untuk mendapatkan file Word aslinya, atau menekan tombol \'Salin Seluruh Naskah\' untuk menyalin teks ke clipboard.',
  },
  {
    q: 'Bagaimana cara menyesuaikan bagian di dalam kurung siku [ ]?',
    a: 'Cukup ganti bagian seperti [Nama Peserta], [NIS/NIM], [Nama Sekolah], dan [Nama Perusahaan/Instansi] dengan identitas resmi Anda masing-masing.',
  },
];
---

<BaseLayout
  title="Contoh Laporan PKL SMK Lengkap Doc & Panduan Penulisan Laporan Akhir | pkldisaka.id"
  description="Dokumen naskah lengkap contoh laporan PKL SMK asli: Halaman Judul, Motto, Persembahan, Kata Pengantar, Daftar Isi, Bab I s/d Bab IV, 13 Dokumentasi Kerja, dan Lampiran."
  path="/dokumen-pkl/laporan-pkl/"
  crumbs={crumbs}
  schema={[faqNode('/dokumen-pkl/laporan-pkl/', faqs)]}
>
  <PageHero
    eyebrow="DOKUMEN & FORMAT BAKU PKL"
    title="Contoh Laporan PKL SMK Lengkap (Dokumen Asli Word / Doc)"
    lead="Format dan tata letak asli naskah portofolio serta laporan akhir Praktik Kerja Lapangan (PKL) SMK sesuai standar industri. Teks dan dokumen dapat langsung diunduh atau disalin."
    crumbs={crumbs}
    bgImage="/images/9.webp"
  />

  <section class="content-section py-5">
    <div class="container">
      <div class="row g-4 g-xl-5 justify-content-center">
        <!-- Main Document Reader (Exact Paper Styled) -->
        <div class="col-lg-10">
          <StatusNotice
            status="Naskah Resmi Sesuai Dokumen Asli"
            targetDate="10/01/2026"
            note="Dokumen di bawah ini disusun sama persis dengan berkas asli Template_Laporan_PKL_Universal.docx. Bagian dalam tanda kurung siku [...] dapat disesuaikan dengan data Anda."
          />

          <!-- Quick Action Toolbar / Pilihan Aksi Atas -->
          <div class="card border-primary-subtle shadow-sm mb-4 bg-white rounded-3 overflow-hidden">
            <div class="card-body p-3 p-md-4">
              <div class="row align-items-center g-3">
                <div class="col-md-6">
                  <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary-subtle p-3 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
                      <i class="bi bi-file-earmark-pdf-fill fs-3 text-danger"></i>
                    </div>
                    <div>
                      <h2 class="h5 fw-bold text-dark mb-1">Dokumen Asli Laporan PKL SMK</h2>
                      <p class="text-muted small mb-0">Tata letak, margin, halaman, dan ukuran 100% presisi sesuai dokumen asli.</p>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 text-md-end">
                  <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-2">
                    <a
                      href="/Template_Laporan_PKL_Universal.pdf"
                      target="_blank"
                      class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1.5 shadow-xs fw-semibold"
                    >
                      <i class="bi bi-file-pdf"></i>
                      <span>Buka Tab Baru (PDF)</span>
                    </a>
                    <a
                      href="/Template_Laporan_PKL_Universal.pdf"
                      download="Template_Laporan_PKL_Universal.pdf"
                      class="btn btn-danger btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1.5 shadow-xs text-white fw-semibold"
                    >
                      <i class="bi bi-download"></i>
                      <span>Download PDF</span>
                    </a>
                    <a
                      href="/Template_Laporan_PKL_Universal.docx"
                      download="Template_Laporan_PKL_Universal.docx"
                      class="btn btn-primary-saka btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1.5 shadow-xs text-decoration-none fw-semibold"
                    >
                      <i class="bi bi-file-word"></i>
                      <span>Download Word (.docx)</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Embedded Exact PDF Viewer Container -->
          <div class="pdf-viewer-wrapper bg-dark p-2 p-md-3 rounded-4 shadow-lg mb-5 border border-secondary-subtle">
            <div class="d-flex align-items-center justify-content-between px-2 py-2 mb-2 text-white-50 border-bottom border-secondary small">
              <span class="d-flex align-items-center gap-2 text-white">
                <i class="bi bi-book"></i> Pratinjau Dokumen Asli (Tampilan PDF Standar Resmi)
              </span>
              <a href="/Template_Laporan_PKL_Universal.pdf" target="_blank" class="text-info text-decoration-none small">
                <i class="bi bi-arrows-fullscreen"></i> Layar Penuh
              </a>
            </div>
            <div class="ratio ratio-16x9" style="min-height: 850px;">
              <iframe
                src="/Template_Laporan_PKL_Universal.pdf#toolbar=1&navpanes=1&scrollbar=1&view=FitH"
                title="Dokumen Asli Template Laporan PKL Universal"
                class="rounded-3 border-0 w-100 h-100"
                style="background-color: #525659;"
              >
                <div class="p-4 text-center text-white">
                  <p>Browser Anda tidak mendukung pratinjau PDF langsung.</p>
                  <a href="/Template_Laporan_PKL_Universal.pdf" class="btn btn-primary">Klik di sini untuk melihat PDF</a>
                </div>
              </iframe>
            </div>
          </div>

          <!-- Document Paper Container (Identical to docx) -->
          <div
            id="naskah-dokumen"
            class="doc-paper-container bg-white p-4 p-md-5 rounded-4 border shadow-sm mb-5 font-serif"
            style="border-color: #cbd5e1 !important; line-height: 1.8; color: #1e293b;"
          >
            <div class="doc-body-exact">
              <h1>DOKUMENTASI PORTOFOLIO PRAKTIK KERJA LAPANGAN</h1><p><strong>DI  [NAMA PERUSAHAAN / INSTANSI]</strong></p><p><strong> </strong></p><p><em>Disusun Sebagai Salah Satu Syarat Penilaian Kenaikan Kelas </em></p><p><strong> </strong></p><p><strong> </strong></p><p><strong>  </strong></p><p><img src="/images/dokumen-pkl/doc_img_1.jpeg" /></p><p><strong> </strong></p><p><strong> </strong></p><p><strong> </strong></p><p><strong>Oleh: </strong></p><p><strong> </strong></p><p> [NAMA PESERTA]</p><p>[NIS/NIM/NOMOR INDUK]</p><p> [KELAS/PROGRAM]</p><p>                                [JURUSAN/PROGRAM STUDI]</p><h1>PEMERINTAH PROVINSI JAWA TIMUR DINAS PENDIDIKAN [NAMA SEKOLAH / PERGURUAN TINGGI] </h1><p>[Website dan email resmi sekolah/kampus]</p><p><strong><img src="/images/dokumen-pkl/doc_img_2.jpeg" /></strong></p><h2>MOTTO </h2><ol><li>"<em>Kesuksesan itu bukan ditunggu, tetapi diwujudkan</em>." </li><li>"<em>Tidak ada hal yang sia-sia dalam belajar karena ilmu akan bermanfaat pada waktunya</em>." </li><li>"<em>Tak pernah ada kata terlambat untuk menjadi apa yang kamu  impikan</em>."<a id="_Toc228016827"></a><a id="_Toc228016978"></a><a id="_Toc228211579"></a></li></ol><h2>PERSEMBAHAN</h2><p>Dengan penuh rasa syukur ke hadirat Tuhan Yang Maha Esa atas segala rahmat, karunia, serta kesehatan yang diberikan, sehingga penulis dapat menyelesaikan kegiatan Praktik Kerja Lapangan (PKL) dan penyusunan laporan ini dengan baik.</p><p>Laporan Praktik Kerja Lapangan ini penulis persembahkan kepada:</p><ol><li>Kedua orang tua tercinta yang selalu memberikan doa, dukungan, perhatian, semangat, serta motivasi kepada penulis selama menjalani kegiatan PKL hingga penyusunan laporan ini dapat terselesaikan. </li><li>Bapak/Ibu guru, khususnya guru pembimbing PKL, yang telah memberikan arahan, bimbingan, serta ilmu yang sangat bermanfaat kepada penulis selama proses pelaksanaan PKL dan penyusunan laporan. </li><li>Pimpinan dan seluruh karyawan perusahaan tempat pelaksanaan PKL yang telah memberikan kesempatan kepada penulis untuk belajar secara langsung di dunia kerja, serta memberikan pengalaman, wawasan, dan pengetahuan baru yang sangat berguna. </li><li>Teman-teman seperjuangan yang telah memberikan bantuan, dukungan, dan kerja sama selama kegiatan PKL berlangsung, sehingga setiap kegiatan dapat dijalani dengan baik. </li><li>Semua pihak yang tidak dapat disebutkan satu per satu yang telah membantu penulis baik secara langsung maupun tidak langsung dalam pelaksanaan PKL maupun penyusunan laporan ini. </li></ol><p>Penulis menyadari bahwa selama pelaksanaan PKL hingga penyusunan laporan ini masih terdapat banyak kekurangan. Oleh karena itu, penulis berharap pengalaman dan ilmu yang diperoleh selama kegiatan PKL dapat menjadi bekal yang bermanfaat untuk pengembangan kemampuan serta persiapan memasuki dunia kerja di masa mendatang.</p><h1>KATA PENGANTAR</h1><p>`	Dengan mengucapkan puji syukur kehadirat Allah SWT yang senantiasa melimpahkan rahmat, berkah, dan karunia-Nya, sehingga penulis dapat menyelesaikan laporan dokumentasi portofolio Praktik Kerja Lapangan (PKL) di [Nama Perusahaan / Instansi] dengan baik dan tepat waktu. Laporan dokumentasi ini disusun berdasarkan kegiatan yang telah dilaksanakan selama penulis menjalani Praktik Kerja Lapangan di perusahaan tersebut. Penyusunan laporan ini bertujuan sebagai bentuk pertanggung jawaban atas pelaksanaan PKL serta sebagai salah satu syarat dan acuan dalam pelaksanaan ujian setelah kegiatan praktik kerja di dunia usaha selesai dilaksanakan. Selama proses pelaksanaan PKL hingga penyusunan laporan ini, penulis memperoleh banyak bantuan, dukungan, bimbingan, serta kerja sama dari berbagai pihak. Oleh karena itu, pada kesempatan ini penulis ingin menyampaikan ucapan terima kasih kepada:</p><ol><li>[Nama Kepala Sekolah/Pimpinan Kampus] selaku Kepala [Nama Sekolah / Perguruan Tinggi]. </li><li>[Nama Ketua Program/Jurusan] selaku Ketua Konsentrasi Keahlian [JURUSAN/PROGRAM STUDI]. </li><li>[Nama Pimpinan Perusahaan] selaku pimpinan perusahaan [Nama Perusahaan / Instansi]. </li><li>[Nama Guru/Dosen Pembimbing]  selaku guru pembimbing selama pelaksanaan Praktik Kerja Lapangan. </li><li>[Nama Pembimbing Industri] selaku pembimbing dari pihak industri. </li><li>Seluruh staff dan karyawan [Nama Perusahaan / Instansi] yang telah memberikan pengalaman, arahan, dan bantuan selama kegiatan PKL berlangsung. </li><li>Dewan guru beserta staff [Nama Sekolah / Perguruan Tinggi] atas bimbingan dan ilmu yang telah diberikan selama penulis menempuh pendidikan. </li><li>Teman-teman yang telah membantu dan memberikan dukungan hingga laporan Praktik Kerja Lapangan ini dapat terselesaikan dengan baik. </li></ol><p>Penulis menyadari bahwa laporan ini masih memiliki kekurangan. Oleh karena itu, penulis mengharapkan kritik dan saran yang membangun demi perbaikan laporan di masa mendatang. Semoga laporan Praktik Kerja Lapangan ini dapat bermanfaat bagi semua pihak.</p><p>[Kota], [Tanggal Bulan Tahun]</p><p>                               [NAMA PESERTA] </p><h2>DAFTAR ISI</h2><p>Daftar Gambar ......................................................................................................v</p><p>BAB I PENDAHULUAN ....................................................................................1<br />1.1 Latar Belakang PKL .......................................................................................1<br />1.2 Pengertian PKL ..............................................................................................1<br />1.3 Tujuan dan Manfaat PKL ...............................................................................1</p><p>1.4 Manfaat PKL...................................................................................................2<br />1.5 Manfaat Penulisan Dokumentasi Portofolio PKL …......................................2</p><p>BAB II TINJAAN UMUM ..................................................................................3<br />2.1 Tempat dan Waktu Pelaksanaan PKL .............................................................3<br />2.2 Sejarah Singkat Dunia Usaha dan Dunia Industri (DUDI) ............................3<br />2.3 Struktur Organisasi DUDI ..............................................................................4<br />2.4 Tata Tertib, Keselamatan, dan Kesehatan Kerja (K3) ....................................5<br />2.5 Prosedur PKL .................................................................................................5</p><p>2.6 Etika dan Perilaku...........................................................................................5</p><p>2.7 Pelanggaran dan Sanksi .................................................................................6</p><p>BAB III PROSES DAN HASIL BELAJAR DI DUDI .......................................7<br />3.1 Pekerjaan yang Dilakukan di DUDI ..............................................................7<br />3.2 Dokumentasi Kegiatan PKL ..........................................................................7<br />3.3 Hambatan Selama PKL dan Pemecahan Masalah .........................................15</p><p>BAB IV PENUTUP .............................................................................................16<br />4.1. Kesimpulan ...................................................................................................16</p><h2>DAFTAR GAMBAR</h2><p>2.2 Gambar Logo [Nama Perusahaan / Instansi]...................................................................3</p><p>2.3 Gambar Struktur Organisasi DUDIKA......................................................................4</p><p>3.2.1 GambarMembuat tampilan web di Blogger…........................................................7</p><p>3.2.2 Gambar Pembuatan Desain Visual Menggunakan Ai.............................................8</p><p>3.2.3 Gambar Monitoring Website Menggunakan Google Search Console....................8</p><p>3.2.4 Gambar Doa Sebelum Belajar.................................................................................9</p><p>3.2.5 Gambar Piket...........................................................................................................9</p><p>3.2.6 Gambar Membuat Artikel……………………………………………....................10</p><p>3.2.7 Gambar Memasukkan Tali dan Inner ke Safety Box…………………....................11</p><p>3.2.8 Gambar Packing Safetybox………………………….………………....................12</p><p>3.2.9 Gambar Membuat Konten..………………………….………………....................12</p><p>3.2.10 Gambar Promosi Lewat Google Local Guide.…………………….......................13</p><p>3.2.11 Gambar Membuat Goal Framework..……..…….……………….........................13</p><p>3.2.12 Gambar Mempelajari Content Pillar ,Cluster,Support..……………....................14</p><p>3.2.13 Gambar Membantu Merakit Totebage…………….....……………....................15</p><h1>BAB I  </h1><h2>PENDAHULUAN </h2><h3>1.1 Latar Belakang </h3><p>Praktik Kerja Lapangan (PKL) adalah suatu bentuk penyelenggaraan pendidikan keahlian profesional, yang memadukan secara sistematik dan sinkron antara program pendidikan di sekolah dan program pengusahaan yang diperoleh melalui kegiatan bekerja langsung di dunia kerja untuk mencapai suatu tingkat keahlian profesional. </p><p>Praktik Kerja Lapangan dilaksanakan untuk memenuhi kebutuhan tenaga kerja yang profesional dibidangnya. Melalui Praktik Kerja Lapangan diharapkan dapat menciptakan tenaga kerja yang profesional tersebut. Dimana para siswa yang melaksanakan Pendidikan tersebut diharapkan dapat menerapkan ilmu yang didapat dan sekaligus mempelajari dunia industri. </p><h3>1.2 Pengertian PKL </h3><p>Praktik Kerja Lapangan (PKL) adalah kegiatan pendidikan, pelatihan dan pembelajaran yang dilaksanakan di Dunia Usaha atau Dunia Industri dalam upaya pendekatan ataupun untuk meningkatkan mutu siswa-siswi Sekolah Menengah Kejuruan (SMK) dengan kompetensi (kemampuan) siswa sesuai bidangnya dan juga menambah bekal untuk masa-masa mendatang guna memasuki dunia kerja yang semakin banyak serta ketat dalam persaingannya seperti di masa sekarang ini. </p><p>Disamping dunia usaha, Praktik Kerja Lapangan (PKL) Dapat memberikan keuntungan pada pelaksanaan itu sendiri yaitu sekolah, karena keahlian yang tidak diajarkan di sekolah bisa didapat didunia usaha , sehingga dengan adanya Praktik Kerja Lapangan (PKL) dapat meningkatkan mutu dan relevensi Pendidikan Menengah Atas yang dapat diarahkan untuk mengembangkan suatu sistem yang mantap antara dunia pendidikan dan dunia usaha. </p><p> </p><h3>1.3 Tujuan PKL </h3><ol><li>Memberikan pengalaman kerja secara langsung/nyata kepada peserta didik dalam rangka menanamkan dan menginternalisasi iklim kerja positif yang berorientasi pada peduli mutu, waktu, proses, biaya, dan hasil kerja. </li><li>Memberikan kesempatan kepada peserta didik untuk membangun dan mengembangkan karakter sesuai dengan nilai-nilai positif yang tumbuh dan diperlukan oleh masyarakat, khususnya di dunia kerja yang ditekuni. </li><li>Menghasilkan lulusan yang kompeten, yang memiliki tingkat pengetahuan, keterampilan, dan etos kerja yang sesuai dengan tuntutan dunia kerja. </li><li>Memperoleh hubungan keterkaitan dan kesepadanan (Link and Match) Sekolah Menengah Kejuruan (SMK/MAK ) dengan dunia kerja. </li><li>Meningkatkan efisiensi proses pendidikan dan pelatihan lulusan yang berkualitas dan profesional. </li><li>Memberi pengakuan dan penghargaan terhadap pengalaman kerja sebagai bagian dari proses pendidikan dan pelatihan. </li></ol><h3>1.4 Manfaat PKL</h3><p>Manfaat yang di dapat dari pelaksanaan Praktik Kerja Lapangan (PKL) bagi para siswa adalah sebagai berikut: </p><ol><li>Menambah ketrampilan, pengetahuan, gagasan seputar dunia usaha serta industri yang profesional dan handal. </li><li>Membantu mengasah keterampilan yang sebelumnya telah diberikan di sekolah. </li><li>Membentuk pola pikir siswa agar terkonstruktif secara baik serta memberikan pengalaman dalam dunia industri maupun dunia kerja. </li></ol><p> </p><h3>1.5 Manfaat Penulisan Dokumentasi Portofolio PKL </h3><ol><li>Salah satu bukti bahwa telah mengikuti program Praktik Kerja Lapangan (PKL) dengan baik. </li><li>Salah satu bentuk pertangggung jawaban dari siswa setelah mengikuti program Praktik Kerja Lapangan (PKL) sesuai keahliannya masing-masing. </li><li>Meningkatkan kemampuan siswa dalam hal menulis laporan yang bersifat resmi dan penting, sehingga siswa dapat lebih memperhatikan kosakata dan penulisan kata yang baik. </li></ol><p> </p><h1>BAB II </h1><h2> TINJAUAN UMUM  </h2><h3>2.1 Tempat dan Waktu Pelaksanaan PKL </h3><p>Waktu pelaksaan Praktik Kerja Lapangan (PKL) pada tahun 2025 dilaksanakan mulai tanggal 5 Januari 2026 sampai 27 Juni 2026, sesuai jadwal yang telah ditentukan. Dalam melaksanakan Praktik Kerja Lapangan (PKL) di [NAMA PERUSAHAAN / INSTANSI] yang berlokasi di Jl. Contoh Industri No. 10, Kelurahan Contoh, Kecamatan Contoh, Kota Contoh, Indonesia 12345 menggunakan sistem 5 (lima) hari kerja yaitu hari senin – jum’at di mulai pukul 08.00-16.00 WIB. </p><h3>2.2 Sejarah Singkat Perusahaan / Instansi</h3><p><img src="/images/dokumen-pkl/doc_img_3.jpeg" /></p><p><strong>Gambar 2.2</strong></p><ol><li>1. [Tahun berdiri]: [Nama perusahaan/instansi] didirikan oleh [Nama pendiri] dan bergerak di bidang [Bidang usaha/layanan utama].</li><li>2. [Tahun perkembangan]: Perusahaan/instansi mengembangkan layanan atau kegiatan pada bidang [Jelaskan perkembangan, produk, atau layanan].</li></ol><p>ABADI/[NAMA UNIT / DIVISI] merupakan digital marketing strategi yang meliputi Blog Marketing atau Web 2.0, Video Marketing, Social Media Marketing, Forum Marketing, SEO, Design dan Pelatihan Digital Marketing. Peserta magang diharapkan sesudah mengikuti program magang di CV [NAMA PERUSAHAAN / INSTANSI]/[NAMA UNIT / DIVISI], para peserta akan dapat mengusai ilmuilmu praktis seputar dunia digital marketing, sehingga menimbulkan atau memunculkan kreativitas mereka dalam bersaing di dunia Bisnis ataupun Enterpreneur. </p><ol><li>3. [Tahun perubahan]: [Jelaskan perubahan nama, struktur, layanan, atau perkembangan penting jika ada.]</li><li>4. [Tahun hingga sekarang]: [Jelaskan kondisi, kegiatan utama, perkembangan, dan kontribusi perusahaan/instansi saat ini.]</li><li>5. Visi dan Misi:</li><li>a. Visi:</li></ol><p>[Tuliskan visi perusahaan/instansi.]</p><ol><li>b. Misi:</li></ol><p>[Tuliskan misi perusahaan/instansi.]</p><p><strong>					</strong></p><h3>2.3 Struktur Organisasi DUDIKA </h3><p>Struktur organisasi di [Nama Perusahaan/Instansi] terdiri atas [jabatan/divisi utama]. Setiap bagian memiliki tugas dan tanggung jawab sesuai bidangnya. Sesuaikan uraian dan bagan struktur organisasi dengan tempat PKL masing-masing.</p><p> <img src="/images/dokumen-pkl/doc_img_4.png" /></p><p>					<strong>Gambar 2.3</strong></p><h3>2.4 Tata Tertib, Keselamatan dan Kesehatan Kerja (K3) </h3><ol><li>Ketentuan biaya/fasilitas selama PKL mengikuti kebijakan [Nama Perusahaan/Instansi].</li><li>Contoh fasilitas yang dapat disesuaikan dengan tempat PKL:</li><li>Air galon;</li><li>Wifi</li><li>PC</li><li>Selama mengikuti dan melaksanakan PKL siswa diwajibkan untuk :</li><li>Berpakaian bebas rapi dan sopan; </li><li>Melaksanakan PKL sesuai dengan jadwal yang sudah dibuat; </li><li>Hadir tepat waktu.</li></ol><h3>2.5 Prosedur Pkl </h3><p>Praktik kerja lapangan PKL mempunyai prosedur kegiatan baik prosedur kegiatan sebelum dan selama praktik. Berikut ini hal-hal yang bisa di persiapkan oleh siswa sebelum PKL: </p><ol><li>Siswa mempersiapkan diri terkait dengan kompetensi atau kemampuan di bidang keahlian</li><li>Belajar berinteraksi dengan teman dan mulai menghapus semua sifat buruk serta perilaku jelek</li><li>Siswa mengikuti pembekalan teknisi dari guru pembimbing sesuai setandar prosedur</li><li>Siswa mempersiapkan berkas yang di butuhkan untuk PKL</li><li>Siswa menghubungi dan konsultasi dengan pihak Perusahaan tempat PKL untuk mengetahui hal-hal umum mengenai Perusahaan tersebut</li><li>Siswa menyiapkan transportasi untuk mobilisasi dalam PKL</li><li>Siswa menyiapkan jurnal dan cara pengisiannya.</li></ol><h3>2.6 Etika dan Perilaku </h3><ol><li>Karyawan wajib bersikap sopan dan ramah kepada sesama karyawan</li><li>Tidak diperbolehkan menyalahgunakan fasilitas perusahaan, termasuk perangkat komputer, akun, maupun akses sistem untuk kepentingan pribadi.</li><li>Karyawan harus bekerja secara jujur, disiplin, dan bertanggung jawab dalam menyelesaikan tugas </li></ol><h3>2.7 Pelanggaran dan Sanksi </h3><ol><li>Setiap pelanggaran terhadap tata tertib dikenakan sanksi sesuai peraturan dan kebijakan [Nama Perusahaan/Instansi], mulai dari teguran hingga tindakan lain yang ditetapkan.</li><li>Tindakan yang merusak citra perusahaan atau mengakibatkan kerugian besar dapat berujung pada sanksi berat. <strong> </strong></li><li>Setiap karyawan harus menjaga kebersihan area kerja masing-masing serta memastikan lingkungan kerja aman dan nyaman bagi semua orang. </li></ol><p> </p><p> </p><h1>BAB III  </h1><h2>PROSES DAN HASIL BELAJAR DI TEMPAT PKL</h2><p><strong> </strong></p><h3>3.1 Pekerjaan yang Dilakukan di Tempat PKL</h3><p>Contoh pekerjaan berikut berasal dari laporan sumber. Ganti, hapus, atau tambahkan kegiatan agar sesuai dengan jurusan, program studi, dan tugas nyata selama PKL:</p><ol><li>Doa </li><li>Piket </li><li>Membuat goal framewok</li><li>Membuat artikel  </li><li>Membuat web di blogger</li><li>Melakukan pembuatan desain visual menggunakan AI</li><li>Mempelajari artikel pillar , cluster dan support</li><li>Mempelajari Cara Promosi Lewat Google Local Guide</li><li>Mempelajari Cara Memantau perkembangan Website Menggunakan Google Search Console </li><li>Membuat konten </li><li>Packing safety box</li><li>Membantu membuat box souvenir / totebage untuk kliens</li></ol><p><a id="_Toc228211596"></a></p><h3>Dokumentasi Kegiatan PKL</h3><p><img src="/images/dokumen-pkl/doc_img_5.png" /></p><p>				<strong>Gambar 3.2.1</strong></p><p><strong>1.   Membuat web di Blogger</strong><br />         Melakukan pembuatan dan pengembangan tampilan website perusahaan menggunakan Blogger dengan menyesuaikan tata letak, desain, menu navigasi, serta elemen visual agar website terlihat lebih menarik, profesional, responsif, dan mendukung kebutuhan promosi perusahaan.Contoh web yang dibuat: <a href="https://www.corporategiftindo.com">https://www.corporategiftindo.com</a></p><p><img src="/images/dokumen-pkl/doc_img_6.png" /></p><p>				<strong>Gambar 3.2.2</strong></p><p><strong>2. Melakukan Pembuatan Desain Visual Menggunakan AI</strong><br />         untuk awalan membuat generate foto yaitu menggunakan mentahan foto box atau barang dengan background jelek lalu di masukan di gpt / gemini / dremina dengan promp untuk mengubah desain bacground atau boxnya atau barangnya</p><p><img src="/images/dokumen-pkl/doc_img_7.png" /></p><p>				<strong>Gambar 3.2.3</strong></p><p><strong>3. Melakukan Monitoring Website Menggunakan Google Search Console</strong><br />        Melakukan pemantauan performa website melalui Google Search Console dengan menganalisis data seperti jumlah klik, tayangan, CTR, dan posisi pencarian untuk mengetahui perkembangan website serta mendukung optimasi SEO.</p><p><img src="/images/dokumen-pkl/doc_img_8.jpeg" /></p><p>	      <strong>Gambar 3.2.4</strong></p><p><strong>4. Doa Sebelum Belajar</strong></p><p>Sebelum memulai kegiatan, kami selalu melakukan doa bersama terlebih dahulu. Tujuannya agar kegiatan yang dilakukan berjalan lancar dan diberikan kemudahan selama belajar maupun bekerja. Selain itu, doa bersama juga membuat suasana menjadi lebih tenang dan menambah rasa kebersamaan antar anggota.</p><p><img src="/images/dokumen-pkl/doc_img_9.png" /> </p><p>		      <strong>Gambar 3.2.5</strong></p><p><strong>5. Piket</strong></p><p>Kegiatan piket dilakukan setelah pekerjaan selesai dengan membersihkan area kerja, seperti menyapu lantai, membuang sampah, dan merapikan ruangan. Kegiatan ini bertujuan untuk menjaga kebersihan dan kenyamanan tempat kerja agar tetap rapi dan enak digunakan. Dari kegiatan piket saya belajar untuk lebih peduli terhadap kebersihan lingkungan dan bertanggung jawab terhadap fasilitas yang digunakan bersama.</p><p><img src="/images/dokumen-pkl/doc_img_10.jpeg" /></p><p>		         <strong>Gambar 3.2.6</strong></p><p><strong>6. Membuat artikel di blogger untuk keperluan web</strong></p><p>Pada kegiatan ini saya membuat artikel untuk kebutuhan website perusahaan. Artikel yang dibuat berisi informasi seputar produk dan kegiatan perusahaan agar dapat menarik minat pembaca. Dalam prosesnya, saya mencari referensi terlebih dahulu, kemudian menyusun isi artikel dengan bahasa yang mudah dipahami dan menarik. Dari kegiatan ini saya belajar bagaimana cara menulis artikel yang rapi, informatif, dan sesuai untuk kebutuhan website</p><p><img src="/images/dokumen-pkl/doc_img_11.jpeg" /></p><p><strong>Gambar 3.2.7</strong></p><p><strong>7. Memasukkan Tali dan Inner ke Safety Box</strong></p><p>Kegiatan ini dilakukan dengan memasukkan tali dan inner ke dalam safety box sebelum produk dikemas. Proses pengerjaan harus dilakukan dengan teliti agar isi di dalam box lengkap dan tersusun rapi. Selain melatih ketelitian, kegiatan ini juga mengajarkan pentingnya kerja sama dan tanggung jawab dalam menyelesaikan pekerjaan sesuai target.</p><p><img src="/images/dokumen-pkl/doc_img_12.jpeg" /></p><p>		     <strong>Gambar 3.2.8</strong></p><p><strong>8. Packing Safety Box</strong></p><p>Setelah safety box selesai dirakit, tahap selanjutnya yaitu packing atau pengemasan. Pada kegiatan ini saya membantu melipat, menyusun, dan mengemas safety box agar siap digunakan atau dikirim. Packing dilakukan dengan rapi supaya box tidak rusak dan tetap dalam kondisi baik. Dari kegiatan ini saya belajar pentingnya kerapian dan ketelitian dalam proses pengemasan produk.</p><p><img src="/images/dokumen-pkl/doc_img_13.png" /></p><p><strong>Gambar 3.2.9</strong></p><p><strong>9.Membuat konten</strong></p><p>Pada kegiatan ini saya membuat konten untuk media sosial perusahaan sebagai salah satu bentuk promosi digital. Konten yang dibuat berupa video kegiatan di tempat PKL yang kemudian diunggah ke media sosial seperti TikTok agar lebih menarik perhatian audiens.</p><p><img src="/images/dokumen-pkl/doc_img_14.png" /></p><p><strong>Gambar 3.2.10</strong></p><p><strong>10.Promosi Lewat Google Local Guide</strong></p><p> Kegiatan Google Local Guide berfungsi membantu perusahaan dalam meningkatkan promosi dan kepercayaan pelanggan melalui Google Maps dengan cara memberikan ulasan, rating, foto, serta informasi tempat secara digital. Aktivitas ini dapat membuat perusahaan lebih mudah ditemukan oleh calon pelanggan, meningkatkan citra bisnis, serta membantu perusahaan mengetahui penilaian pelanggan terhadap pelayanan dan fasilitas yang diberikan.</p><p><img src="/images/dokumen-pkl/doc_img_15.png" /></p><p><strong> Gambar 3.2.11</strong></p><p><strong>11.Membuat Goal framework </strong></p><p>    Kegiatan membuat <em>goal framework</em> ini dilakukan Ketika pertma masuk DUDI untuk menentukan target dan arah pengembangan diri dalam satu tahun ke depan, yaitu membuat website portofolio sebagai media untuk menampilkan hasil karya dan kemampuan yang dimiliki. Dengan adanya perencanaan ini, saya menjadi lebih terarah dalam belajar, mengembangkan skill di bidang website dan digital, serta memiliki tujuan yang jelas untuk meningkatkan pengalaman dan kualitas diri di dunia kerja maupun industri kreatif.</p><p><img src="/images/dokumen-pkl/doc_img_16.png" /></p><p><strong>Gambar 3.2.12</strong></p><p><strong>12.Mempelajari Content Pillar ,Cluster,Support</strong></p><p>   Kegiatan pada gambar tersebut berkaitan dengan penyusunan strategi konten website menggunakan metode <em>pillar page</em>, <em>cluster content</em>, dan <em>support content</em>. Dalam kegiatan ini, saya mempelajari cara menentukan topik utama sebagai pusat pembahasan, kemudian membuat beberapa konten pendukung yang saling terhubung agar informasi lebih terstruktur dan mudah dipahami. Selain itu, saya juga belajar membuat <em>support content</em> sebagai konten tambahan untuk membantu meningkatkan jangkauan, memperkuat SEO website, serta menarik lebih banyak pengunjung melalui pencarian di Google dan media digital lainnya.</p><p><img src="/images/dokumen-pkl/doc_img_17.jpeg" /></p><p><strong>Gambar 3.2.13</strong></p><ol><li><strong>Membantu Merakit Totebag</strong></li></ol><p>Kegiatan ini adalah proses pembuatan dan perakitan totebag secara manual mulai dari pemasangan tali, pengecekan desain, hingga penataan totebag agar siap digunakan dan dibagikan. Kegiatan ini melatih kerja sama, ketelitian, dan keterampilan dalam proses produksi merchandise<strong>.</strong></p><h3><a id="_Toc228211600"></a>Hambatan Selama PKL dan Pemecahan Masalah</h3><ol><li>Hambatan</li><li>Cukup sulit beradaptasi dengan lingkungan sekitar dan orang lain saat awal masuk PKL.</li><li>Keterbatasan pengetahuan untuk menghadapi hal baru ditempat PKL.</li><li>Pemecahan masalah</li><li>Berani bergaul dengan orang lain di lingkungan PKL</li><li>Lebih percaya diri dan ada kemampuan untuk berkomunikasi di lingkungan PKL.</li><li>Berani bertanya jika ada masalah dalam pengerjaan tugas/bingung dalam mengerjakan tugas.</li></ol><h1>BAB IV </h1><h2> PENUTUP       <br />                                                                                                        </h2><h3><a id="_Toc228211602"></a>Kesimpulan</h3><p>Setelah melaksanakan Praktik Kerja Lapangan (PKL) selama kurang lebih 6 bulan di [NAMA PERUSAHAAN / INSTANSI], penulis memperoleh banyak pengalaman, pengetahuan, serta keterampilan baru yang tidak didapatkan secara langsung di sekolah. Melalui kegiatan PKL ini, penulis dapat memahami bagaimana dunia kerja yang sebenarnya, mulai dari kedisiplinan, tanggung jawab, kerja sama tim, hingga cara menyelesaikan pekerjaan sesuai target dan standar perusahaan.</p><p>Selama PKL, penulis mempelajari berbagai bidang pekerjaan seperti pembuatan artikel website, pengelolaan web Blogger, dasar-dasar SEO, pembuatan konten visual, serta proses produksi dan pengemasan produk. Dari kegiatan tersebut, penulis menjadi lebih memahami pentingnya kreativitas, ketelitian, komunikasi, dan kemampuan beradaptasi dalam lingkungan kerja profesional.</p><p>Selain meningkatkan kemampuan teknis, PKL juga memberikan pengalaman dalam membentuk sikap kerja yang lebih mandiri, disiplin, percaya diri, dan bertanggung jawab. Penulis menyadari bahwa dunia industri membutuhkan tidak hanya kemampuan akademik, tetapi juga etika kerja dan kemampuan bekerja sama dengan orang lain.</p><p>Dengan adanya kegiatan PKL ini, penulis berharap pengalaman dan ilmu yang telah diperoleh dapat menjadi bekal yang bermanfaat untuk menghadapi dunia kerja maupun untuk melanjutkan pendidikan ke jenjang yang lebih tinggi. PKL juga menjadi pengalaman berharga yang membantu penulis mempersiapkan diri menjadi sumber daya manusia yang lebih kompeten, profesional, dan siap bersaing di era digital.</p><p>  </p><p> </p><p> </p><p> </p><p><strong>LAMPIRAN</strong></p><p><strong><img src="/images/dokumen-pkl/doc_img_18.png" /></strong></p><p><strong><img src="/images/dokumen-pkl/doc_img_19.png" /></strong></p><p><strong><img src="/images/dokumen-pkl/doc_img_20.png" /></strong></p><p><strong><img src="/images/dokumen-pkl/doc_img_21.png" /></strong></p><p><strong><img src="/images/dokumen-pkl/doc_img_22.png" /></strong></p><p><strong><img src="/images/dokumen-pkl/doc_img_23.png" /></strong></p><p><strong><img src="/images/dokumen-pkl/doc_img_24.png" /></strong></p><p><strong><img src="/images/dokumen-pkl/doc_img_25.png" /></strong></p><p><strong><img src="/images/dokumen-pkl/doc_img_26.jpeg" /></strong></p>
