---
// src/pages/blog/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { SITE, mapsLink, waLink } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      allPosts: posts,
    },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth === 2);

const path = `/blog/${post.id}/`;
const absUrl = new URL(path, SITE.url).toString();

const crumbs = [
  { name: 'Blog', path: '/blog/' },
  { name: post.data.title, path },
];

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(d));

// Define explicit topical clusters for 100% matched related articles
const TOPIC_CLUSTERS = [
  {
    name: 'informatika',
    ids: [
      'rekomendasi-tempat-magang-informatika-di-malang',
      'pekerjaan-anak-magang-informatika-malang',
      'tips-memilih-tempat-magang-informatika-malang',
      'cara-daftar-magang-informatika-malang',
    ],
  },
  {
    name: 'grafika',
    ids: [
      'rekomendasi-tempat-pkl-grafika-malang',
      'kegiatan-pkl-jurusan-grafika',
      'tips-persiapan-pkl-jurusan-grafika',
      'perbedaan-pkl-grafika-sekolah-dan-industri',
    ],
  },
  {
    name: 'dkv',
    ids: [
      'tempat-pkl-jurusan-dkv-malang',
      'kegiatan-pkl-jurusan-dkv',
      'portofolio-dkv-untuk-pkl',
      'syarat-cara-daftar-pkl-dkv-malang',
    ],
  },
  {
    name: 'rpl',
    ids: [
      'tempat-pkl-rpl-di-malang',
      'kegiatan-pkl-jurusan-rpl',
      'skill-sebelum-pkl-rpl',
      'contoh-laporan-pkl-rpl',
      'apa-yang-dikerjakan-anak-magang-web-developer',
    ],
  },
  {
    name: 'tkj',
    ids: [
      'tempat-pkl-tkj-di-malang',
      'kegiatan-pkl-jurusan-tkj',
      'persiapan-pkl-tkj',
      'cara-memilih-tempat-pkl-tkj',
      'tempat-pkl-rpl-tkj-malang',
    ],
  },
  {
    name: 'lokasi-terdekat',
    ids: [
      'tempat-pkl-terdekat',
      'tempat-pkl-terdekat-dari-rumah',
      'tempat-pkl-di-malang',
      'tempat-pkl-sesuai-jurusan',
    ],
  },
  {
    name: 'pendaftaran-panduan',
    ids: [
      'cara-daftar-magang-di-malang',
      'cara-mendaftar-pkl-di-malang',
      'cara-mencari-tempat-pkl-smk-malang',
      'panduan-membuat-portofolio-untuk-magang',
    ],
  },
];

// Contextual & Topical Relevance Matching
const currentCluster = TOPIC_CLUSTERS.find((c) => c.ids.includes(post.id));

let relatedPosts = [];
if (currentCluster) {
  relatedPosts = allPosts.filter((p) => currentCluster.ids.includes(p.id) && p.id !== post.id).slice(0, 4);
}

// Fallback or fill remaining with semantic category and token scoring
if (relatedPosts.length < 4) {
  const existingIds = new Set([post.id, ...relatedPosts.map((p) => p.id)]);
  const currentTokens = `${post.id} ${post.data.title}`.toLowerCase().split(/[^a-z0-9]+/);

  const scoredRemaining = allPosts
    .filter((p) => !existingIds.has(p.id))
    .map((p) => {
      let score = 0;
      if (p.data.category === post.data.category) score += 6;
      const otherTokens = `${p.id} ${p.data.title}`.toLowerCase().split(/[^a-z0-9]+/);
      const commonTokens = currentTokens.filter((t) => t.length > 3 && otherTokens.includes(t));
      score += commonTokens.length * 3;
      return { post: p, score };
    })
    .sort((a, b) => b.score - a.score)
    .map((x) => x.post);

  relatedPosts = [...relatedPosts, ...scoredRemaining].slice(0, 4);
}

// Comprehensive Structured Data (AEO & 2026-2027 Standards matching reference)
const schemas: any[] = [
  {
    '@type': 'BlogPosting',
    '@id': `${absUrl}#article`,
    headline: post.data.title,
    description: post.data.description,
    image: [new URL(post.data.image, SITE.url).toString()],
    datePublished: post.data.published.toISOString(),
    dateModified: (post.data.updated || post.data.published).toISOString(),
    inLanguage: 'id-ID',
    url: absUrl,
    isPartOf: {
      '@type': 'Blog',
      '@id': `${SITE.url}/blog/#blog`,
      name: 'Blog & Panduan Edukasi PKL Saka Malang',
      url: `${SITE.url}/blog/`,
    },
    author: {
      '@type': 'Organization',
      name: post.data.author,
      url: SITE.url,
      description: post.data.authorRole,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE.brandName,
      url: SITE.url,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon.svg', SITE.url).toString(),
      },
    },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '.blog-summary-text', '.blog-prose h2', '.blog-prose p'],
    },
    keywords: post.data.keywords.join(', '),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${absUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog & Panduan', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: absUrl },
    ],
  },
];

if (post.data.faq && post.data.faq.length > 0) {
  schemas.push({
    '@type': 'FAQPage',
    '@id': `${absUrl}#faq`,
    isPartOf: { '@id': `${absUrl}#article` },
    mainEntity: post.data.faq.map((f: { q: string; a: string }) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  });
}
---

<BaseLayout
  title={`${post.data.title} - Blog PKL Saka`}
  description={post.data.description}
  path={path}
  crumbs={crumbs}
  schema={schemas}
  <main id="main-content" class="content-section pt-4">
    <div class="container">
      <div class="row g-4 g-xl-5">
        <article class="col-lg-8 blog-article-main">

          <!-- 1. BREADCRUMB -->
          <nav aria-label="Breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
          <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Beranda</a></li>
          <li class="breadcrumb-item"><a href="/blog/" class="text-decoration-none">Blog</a></li>
          <li class="breadcrumb-item active text-truncate" aria-current="page" style="max-width: 320px;">
            {post.data.title}
          </li>
        </ol>
      </nav>

      <!-- 2. EYEBROW & H1 HEADLINE -->
      <span class="section-heading-eyebrow text-uppercase mb-2 d-inline-block">
        {post.data.eyebrow}
      </span>
      <h1 class="h2 fw-bold text-dark mb-3" style="line-height: 1.35; letter-spacing: -0.01em;">
        {post.data.title}
      </h1>

      <!-- 3. ARTICLE METADATA BAR -->
      <div class="d-flex flex-wrap align-items-center gap-2 text-muted small mb-4 pb-3 border-bottom">
        <span>Ditulis oleh <a href="/penulis/" class="text-dark fw-bold text-decoration-none border-bottom border-primary pb-1" title="Lihat profil penulis">{post.data.author}</a></span>
        <span>&bull;</span>
        <span>{formatDate(post.data.published)}</span>
        <span>&bull;</span>
        <span>Waktu Baca: {post.data.readingTime}</span>
        <span>&bull;</span>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">
          {post.data.category}
        </span>
      </div>

      <!-- 4. FEATURED COVER IMAGE WITH CAPTION (SAMPUL ARTIKEL BERFOTO) -->
      <figure class="blog-featured-figure mb-4">
        <div class="blog-featured-img-wrap border">
          <img
            src={post.data.image}
            alt={post.data.imageAlt || post.data.title}
            class="blog-featured-img"
            width="840"
            height="472"
            loading="eager"
          />
        </div>
        <figcaption class="text-center text-muted small mt-2 fst-italic">
          📸 {post.data.imageCaption}
        </figcaption>
      </figure>

      <!-- 5. SUMMARY CALLOUT BOX (PANDUAN SINGKAT / POIN KUNCI) -->
      <div class="p-4 rounded-3 border mb-4 bg-light" style="border-color: rgba(226, 232, 240, 0.9) !important;">
        <div class="fw-bold mb-1 text-primary d-flex align-items-center gap-2">
          <i class="bi bi-lightbulb-fill text-warning"></i>
          <span>Panduan Singkat & Poin Kunci Jawaban:</span>
        </div>
        <p class="small text-secondary mb-0 blog-summary-text" style="line-height: 1.65; font-size: 0.92rem;">
          {post.data.answer}
        </p>
      </div>

      <!-- 6. TABLE OF CONTENTS (DAFTAR ISI PANDUAN OTOMATIS & DINAMIS) -->
      {tocHeadings.length > 0 && (
        <nav class="blog-toc" aria-label="Daftar Isi Artikel">
          <div class="blog-toc-title">
            <i class="bi bi-list-nested text-primary"></i>
            <span>Daftar Isi Pembahasan:</span>
          </div>
          <ul>
            {tocHeadings.map((h, idx) => (
              <li>
                <a href={`#${h.slug}`}>{idx + 1}. {h.text}</a>
              </li>
            ))}
            {post.data.faq && post.data.faq.length > 0 && (
              <li>
                <a href="#faq-artikel">{tocHeadings.length + 1}. FAQ &mdash; Pertanyaan Umum yang Sering Diajukan</a>
              </li>
            )}
          </ul>
        </nav>
      )}

      <!-- 7. ARTICLE PROSE (KONTEN LENGKAP ARTIKEL) -->
      <div class="blog-prose mb-5">
        <Content />
      </div>

      <!-- 8. FAQ ACCORDION SECTION (PERTANYAAN UMUM) -->
      {post.data.faq && post.data.faq.length > 0 && (
        <div id="faq-artikel" class="mb-5 pt-3">
          <div class="mb-3">
            <span class="section-heading-eyebrow">Tanya Jawab Terkait</span>
            <h2 class="h4 fw-bold text-dark mb-1">FAQ &mdash; Pertanyaan Praktis Pembaca</h2>
            <p class="small text-muted mb-0">Jawaban transparan dari tim mentor industri Saka untuk menjawab keraguan siswa dan pihak sekolah.</p>
          </div>

          <div class="accordion accordion-faq" id="articleFaqAccordion">
            {post.data.faq.map((item: { q: string; a: string }, idx: number) => {
              const collapseId = `faqCollapse-${idx}`;
              const headingId = `faqHeading-${idx}`;
              return (
                <div class="accordion-item">
                  <h3 class="accordion-header" id={headingId}>
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target={`#${collapseId}`}
                      aria-expanded="false"
                      aria-controls={collapseId}
                    >
                      {item.q}
                    </button>
                  </h3>
                  <div
                    id={collapseId}
                    class="accordion-collapse collapse"
                    aria-labelledby={headingId}
                    data-bs-parent="#articleFaqAccordion"
                  >
                    <div class="accordion-body">
                      {item.a}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- 9. HIGH-CONVERTING WHATSAPP CTA BANNER (MIRIP DENGAN LINK CONTOH) -->
      <div class="p-4 p-md-5 rounded-4 mb-5 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
        <div class="row align-items-center g-4">
          <div class="col-md-8 text-center text-md-start">
            <div class="small text-white-50 text-uppercase fw-semibold mb-2" style="letter-spacing: 0.06em;">
              Ingin Praktik Langsung di Proyek Nyata?
            </div>
            <h3 class="h4 text-white fw-bold mb-2" style="line-height: 1.35;">
              Konsultasikan Minat Jurusan & Jadwal PKL Anda
            </h3>
            <p class="small text-white-50 mb-0" style="line-height: 1.6;">
              Diskusikan ketersediaan kuota divisi magang di Saka Malang bersama tim pembina kami. Bebas biaya pendaftaran dan rasio bimbingan terjaga.
            </p>
          </div>
          <div class="col-md-4 text-center">
            <a
              href={waLink(`Halo Tim Mentor Saka, saya telah membaca artikel '${post.data.title}' dan ingin menanyakan ketersediaan kuota PKL.`)}
              class="btn btn-light text-primary fw-bold px-4 py-3 rounded-pill d-inline-flex align-items-center justify-content-center gap-2 w-100 shadow-sm"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="bi bi-whatsapp text-success fs-5"></i>
              <span>Konsultasi WhatsApp</span>
            </a>
            <div class="small text-white-50 mt-2" style="font-size: 0.78rem;">
              0813-3432-1383 &middot; Respon Cepat Tim Pembina
            </div>
          </div>
        </div>
      </div>

      <!-- 10. AUTHOR BIO CARD (TENTANG PENULIS) -->
      <div class="border rounded-4 p-4 mb-5 bg-light" style="border-color: rgba(226, 232, 240, 0.9) !important;">
        <div class="d-flex gap-4 align-items-start flex-column flex-sm-row">
          <div class="flex-shrink-0">
            <a href="/penulis/" title={`Lihat profil ${post.data.author}`}>
              <img
                src="/images/penulis-evan.webp"
                alt={`Foto profil ${post.data.author}`}
                class="rounded-circle shadow-sm border border-2 border-white"
                style="width: 80px; height: 80px; object-fit: cover; object-position: top;"
                width="80"
                height="80"
              />
            </a>
          </div>
          <div class="flex-grow-1">
            <div class="small text-muted text-uppercase fw-semibold mb-1" style="letter-spacing: 0.05em; font-size: 0.75rem;">
              Tentang Penulis
            </div>
            <div class="fw-bold fs-6 text-dark mb-1">
              <a href="/penulis/" class="text-dark text-decoration-none border-bottom border-primary pb-1" title="Lihat profil dan artikel penulis">
                {post.data.author}
              </a>
            </div>
            <div class="small text-primary fw-semibold mb-2">
              Penulis Artikel & Reviewer Vokasi Industri CV Saudagar Kaya Abadi
            </div>
            <p class="small text-muted mb-3" style="line-height: 1.65;">
              Mochammad Evan Pratama aktif membina peserta didik vokasi tingkat SMK dan perguruan tinggi dalam program Praktik Kerja Lapangan (PKL) di Kota Malang. Berfokus pada penyiapan talenta muda di bidang Rekayasa Perangkat Lunak (RPL), Teknik Komputer dan Jaringan (TKJ), Desain Komunikasi Visual (DKV), serta Pemasaran Digital agar memiliki portofolio proyek terstandar dan mentalitas kerja profesional.
            </p>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
              <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-white text-secondary border font-monospace">Penulis Artikel</span>
                <span class="badge bg-white text-secondary border font-monospace">Vokasi Industri</span>
                <span class="badge bg-white text-secondary border font-monospace">Saka Malang</span>
              </div>
              <a href="/penulis/" class="small fw-bold text-primary text-decoration-none">
                Lihat Profil & Semua Artikel Penulis &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- 11. LOKASI KAMI (LOKASI WORKSHOP & SENTRA MAGANG SAKA MALANG) -->
      <div class="border-top pt-4 mb-5">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
          <div>
            <span class="section-heading-eyebrow mb-1 d-inline-block">Sentra Operasional Vokasi</span>
            <h3 class="h5 fw-bold text-dark mb-0">
              <i class="bi bi-geo-alt-fill text-danger me-1"></i> Lokasi Kami
            </h3>
          </div>
          <a
            href={mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5"
          >
            <i class="bi bi-geo-alt"></i>
            <span>Buka Petunjuk Arah di Google Maps</span>
          </a>
        </div>

        <div class="card border border-light-subtle rounded-4 p-3 p-md-4 shadow-sm" style="background-color: #f8fafc;">
          <div class="row align-items-center g-3">
            <div class="col-12 col-md-8">
              <div class="d-flex align-items-start gap-3">
                <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.35rem;">
                  <i class="bi bi-building"></i>
                </div>
                <div class="flex-grow-1" style="min-width: 0;">
                  <h4 class="fw-bold text-dark mb-1 fs-6" style="word-break: normal; white-space: normal;">
                    CV Saudagar Kaya Abadi (SAKA Souvenir)
                  </h4>
                  <p class="small text-muted mb-2" style="line-height: 1.55; word-break: normal; white-space: normal;">
                    {SITE.address.full}
                  </p>
                  <div class="small text-secondary font-monospace" style="font-size: 0.78rem;">
                    <i class="bi bi-clock me-1 text-primary"></i> Jam Kerja: Senin - Jumat, 08.00 - 16.00 WIB
                  </div>
                </div>
              </div>
            </div>
            <div class="col-12 col-md-4 text-md-end">
              <a
                href={mapsLink}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary btn-sm rounded-pill px-3.5 py-2 fw-semibold w-100 w-md-auto shadow-sm d-inline-flex align-items-center justify-content-center gap-1.5"
              >
                <i class="bi bi-geo-alt-fill"></i>
                <span>Lokasi Kami &rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- 12. BACK BUTTON -->
      <div class="text-center pb-3">
        <a href="/blog/" class="btn btn-outline-secondary rounded-pill px-4 btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Kembali ke Daftar Semua Artikel Blog
        </a>
      </div>
    </article>

    <!-- SIDEBAR BLOG -->
    <div class="col-lg-4">
      <aside class="detail-sidebar">
        <!-- 1. Artikel Terkait -->
        {relatedPosts.length > 0 && (
          <div class="sidebar-widget">
            <div class="sidebar-widget-title mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
              <i class="bi bi-journal-text text-primary fs-5"></i>
              <span class="fw-bold fs-6 text-dark">Artikel Terkait</span>
            </div>
            <div class="d-flex flex-column gap-3">
              {relatedPosts.map((rel) => (
                <a
                  href={`/blog/${rel.id}/`}
                  class="text-decoration-none p-2.5 border rounded-3 bg-white hover-shadow d-flex align-items-start gap-3 transition-all"
                  style="border-color: #e2e8f0;"
                >
                  <div
                    class="rounded-3 overflow-hidden flex-shrink-0 border"
                    style="width: 76px; height: 76px; background-color: #f8fafc;"
                  >
                    <img
                      src={rel.data.image}
                      alt={rel.data.title}
                      width="76"
                      height="76"
                      class="w-100 h-100 object-fit-cover"
                      loading="lazy"
                    />
                  </div>
                  <div class="flex-grow-1" style="min-width: 0;">
                    <span
                      class="d-inline-block text-primary fw-semibold mb-1 font-monospace"
                      style="font-size: 0.68rem; letter-spacing: 0.03em;"
                    >
                      {rel.data.category}
                    </span>
                    <h4
                      class="fw-bold text-dark mb-0 line-clamp-3"
                      style="font-size: 0.82rem; line-height: 1.45; word-break: normal; white-space: normal;"
                    >
                      {rel.data.title}
                    </h4>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- 2. WhatsApp Quick Consultation -->
        <div class="sidebar-widget sidebar-cta-card">
          <div class="d-inline-flex align-items-center gap-1.5 badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 mb-2 font-monospace" style="font-size: 0.72rem;">
            <i class="bi bi-patch-check-fill text-primary"></i>
            <span>Tanya Tim Mentor Saka</span>
          </div>
          <h3 class="h6 fw-bold text-dark mb-2">Konsultasi Materi & Program PKL</h3>
          <p class="small text-muted mb-3" style="font-size: 0.85rem; line-height: 1.5;">
            Ingin mendalami materi ini langsung di proyek industri? Diskusikan ketersediaan kuota magang Anda dengan kami.
          </p>
          <a
            href={waLink(`Halo Tim Mentor Saka, saya telah membaca artikel '${post.data.title}' dan ingin berkonsultasi seputar magang.`)}
            class="btn btn-primary w-100 rounded-pill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="bi bi-whatsapp"></i>
            <span>Konsultasi via WhatsApp</span>
          </a>
          <div class="d-flex align-items-center justify-content-center gap-2 mt-2 text-muted" style="font-size: 0.74rem;">
            <i class="bi bi-shield-check text-success"></i>
            <span>Respon Cepat • Bebas Biaya 100%</span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
</main>
</BaseLayout>
