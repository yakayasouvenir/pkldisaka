---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import { GALERI_ITEMS, GALERI_CATEGORIES } from '../data/galeri';

const title = 'Kapsul Kenangan & Galeri PKL di Saka Malang | pkldisaka.com';
const description = 'Arsip dokumentasi visual, scrapbook foto kebersamaan, momen pelepasan siswa, dan kenang-kenangan alumni Praktik Kerja Lapangan (PKL) di Saka Kota Malang.';
const crumbs = [
  { name: 'Program PKL', path: '/program-pkl/' },
  { name: 'Galeri Kenangan' },
];

const featuredItem = GALERI_ITEMS[0]; // Pelepasan Sertifikat
const farewellItem = GALERI_ITEMS[1]; // Farewell
const studioItem = GALERI_ITEMS[2]; // Studio DKV
const mentorItem = GALERI_ITEMS[3]; // Mentoring RPL

const alumniNotes = [
  {
    name: 'Mochammad Evan Pratama',
    school: 'SMKN 11 Malang',
    batch: 'Batch 2025/2026',
    color: '#FEF3C7',
    border: '#F59E0B',
    rotate: '-1.8deg',
    quote: 'Briefing pagi jam 8 seru dan santai. Para mentor selalu menghargai ide kami dan membimbing step-by-step tanpa rasa takut salah. Ekosistem kerjanya beneran suportif!',
  },
  {
    name: 'Naila Sayidatul Khusnia',
    school: 'SMK NU Sunan Ampel',
    batch: 'Batch Ganjil 2024/2025',
    color: '#E0F2FE',
    border: '#0284C7',
    rotate: '1.5deg',
    quote: 'Jam kerjanya sangat teratur 08:00 - 16:00, Sabtu-Minggu libur, dan istirahat 1 jam sangat cukup buat sholat Dzuhur dan makan bareng. Suasananya family friendly banget!',
  },
  {
    name: 'Arbil Sepdwiasa R',
    school: 'SMKN 11 Malang',
    batch: 'Batch 2025/2026',
    color: '#DCFCE7',
    border: '#16A34A',
    rotate: '-1.2deg',
    quote: 'Mentor di Saka teliti banget ngajarin standar industri agensi, mulai dari tipografi sampai kerapian file master. Skill desain saya berkembang pesat selama 6 bulan di sini.',
  },
  {
    name: 'Muhammad Sahrul Ramdhani',
    school: 'SMKN 11 Malang',
    batch: 'Batch 2025/2026',
    color: '#FCE7F3',
    border: '#DB2777',
    rotate: '2deg',
    quote: 'Gak ada senioritas kaku sama sekali! Mentornya humble, ramah, dan selalu siap mendampingi kalau ada kendala teknis. Portofolio desain saya jadi tebal dan berbobot.',
  },
  {
    name: 'Kevin Pramudya',
    school: 'SMKN 11 Malang',
    batch: 'Batch 2025/2026',
    color: '#EDE9FE',
    border: '#8B5CF6',
    rotate: '-2deg',
    quote: 'Belajar desain kemasan langsung untuk produk komersial nyata. Pengalaman paling berkesan saat melihat hasil karya desain kita beneran dicetak dan diproduksi!',
  },
  {
    name: 'Kirani Wahyu Kusuma',
    school: 'SMK NU Sunan Ampel',
    batch: 'Batch Ganjil 2024/2025',
    color: '#FEF9C3',
    border: '#EAB308',
    rotate: '1.2deg',
    quote: 'Dikasih kebebasan berinovasi bikin konten kreatif dan video promosi. Suasana studio yang asik bikin hari-hari magang terasa cepat dan menyenangkan!',
  },
  {
    name: 'Amilatus Sholiha',
    school: 'SMK NU Sunan Ampel',
    batch: 'Batch Ganjil 2024/2025',
    color: '#FFEDD5',
    border: '#F97316',
    rotate: '-1.5deg',
    quote: 'Paling seru pas sesi foto produk dengan lighting studio profesional. Mentor gak pelit ilmu dan selalu berbagi tips praktis yang gak diajarkan di buku pelajaran sekolah.',
  },
  {
    name: 'Muhammad Maulana Ishaq',
    school: 'SMKN 1 Pasuruan',
    batch: 'Batch 2025/2026',
    color: '#CCFBF1',
    border: '#0D9488',
    rotate: '1.8deg',
    quote: 'Di Saka kami beneran dilibatkan pegang website dan SEO proyek live. Bukan disuruh fotokopi atau bikin kopi. Pengalaman teknisnya sangat berharga untuk karier!',
  },
  {
    name: 'Umar Khotob',
    school: 'SMKN 1 Pasuruan',
    batch: 'Batch 2025/2026',
    color: '#E0E7FF',
    border: '#4F46E5',
    rotate: '-2.2deg',
    quote: 'Fasilitas kerja sangat memadai, koneksi internet cepat dan stabil, serta teman-teman lintas sekolah saling support. Benar-benar tempat bertumbuh yang luar biasa.',
  },
  {
    name: 'Ahmad Ziyan Achwari',
    school: "SMK Mamba'ul Ihsan Gresik",
    batch: 'Batch 2025/2026',
    color: '#F1F5F9',
    border: '#64748B',
    rotate: '1.4deg',
    quote: 'Sebagai anak rantau dari Gresik yang PKL di Malang, Saka bikin saya merasa seperti rumah kedua. Bimbingan mentor hangat dan pelepasan magangnya dapet sertifikat resmi.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/galeri/"
  crumbs={crumbs}
>
  <!-- Hero Section Khusus Galeri (Scrapbook & Memory Capsule) -->
  <header class="memory-hero position-relative overflow-hidden text-white">
    <div class="memory-hero-ambient" aria-hidden="true"></div>
    <div class="container position-relative py-5" style="z-index: 2;">
      <!-- Breadcrumb -->
      <nav class="mb-3" aria-label="Breadcrumb">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item"><a href="/" class="text-white text-opacity-75 text-decoration-none">Beranda</a></li>
          <li class="breadcrumb-item"><a href="/program-pkl/" class="text-white text-opacity-75 text-decoration-none">Program PKL</a></li>
          <li class="breadcrumb-item active text-white fw-semibold" aria-current="page">Galeri Kenangan</li>
        </ol>
      </nav>

      <div class="row align-items-center g-4">
        <div class="col-lg-8">
          <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3 small fw-bold" style="background: rgba(245, 158, 11, 0.18); border: 1px solid rgba(245, 158, 11, 0.45); color: #fde047;">
            <i class="bi bi-stars"></i>
            <span>ARSIP VISUAL & KAPSUL WAKTU PKL SAKA</span>
          </div>
          <h1 class="display-5 fw-extrabold mb-3 memory-title text-white">
            <span class="memory-title-white">Jejak Karya, Tawa, &</span> <span class="text-gradient-gold">Kenangan Magang</span>
          </h1>
          <p class="lead mb-4 memory-lead" style="max-width: 680px; font-size: 1.12rem;">
            Bukan sekadar lembar absensi formal, inilah galeri autentik perjalanan siswa SMK dan mahasiswa vokasi di Kota Malang: dari gugupnya hari pertama orientasi, hangatnya bimbingan mentor, serunya studio produksi, hingga momen haru pelepasan kelulusan.
          </p>
          <div class="d-flex flex-wrap gap-3 align-items-center small memory-meta">
            <span class="d-flex align-items-center gap-1 text-white">
              <i class="bi bi-camera-fill text-warning"></i> 8+ Album Momen Otentik
            </span>
            <span class="d-none d-sm-inline text-white-50">•</span>
            <span class="d-flex align-items-center gap-1 text-white">
              <i class="bi bi-building text-info"></i> 10+ Sekolah & Kampus Mitra
            </span>
            <span class="d-none d-sm-inline text-white-50">•</span>
            <span class="d-flex align-items-center gap-1 text-white">
              <i class="bi bi-heart-fill text-danger"></i> 100% Cerita Nyata
            </span>
          </div>
        </div>

        <div class="col-lg-4 d-none d-lg-block">
          <!-- Mini Floating Keepsake Preview with Interactive Swap -->
          <div class="hero-polaroid-stack position-relative" id="heroPolaroidStack" title="Klik foto untuk menukar posisi">
            <!-- Card 1: Pelepasan 4.webp (Initially Front) -->
            <div
              class="hero-polaroid is-front"
              id="polaroidCard1"
              data-img="/images/4.webp"
              data-title="Momen Kelulusan & Pelepasan Siswa PKL"
              data-desc="Pemberian sertifikat resmi industri kepada peserta PKL berprestasi di Saka."
              data-meta={`${featuredItem.batch} • ${featuredItem.school}`}
            >
              <div class="tape-strip"></div>
              <img src="/images/4.webp" alt="Momen Pelepasan Siswa PKL" loading="eager" />
              <div class="polaroid-caption d-flex align-items-center justify-content-between">
                <div>
                  <span class="fw-bold d-block text-start">Momen Pelepasan Siswa ✨</span>
                  <span class="text-muted small text-start d-block">Batch Genap 2025/2026</span>
                </div>
                <button
                  type="button"
                  class="btn-polaroid-zoom view-trigger"
                  title="Perbesar foto"
                  data-img="/images/4.webp"
                  data-title="Momen Kelulusan & Pelepasan Siswa PKL"
                  data-desc="Pemberian sertifikat resmi industri kepada peserta PKL berprestasi di Saka."
                  data-meta={`${featuredItem.batch} • ${featuredItem.school}`}
                  aria-label="Perbesar foto pelepasan"
                >
                  <i class="bi bi-arrows-fullscreen"></i>
                </button>
              </div>
            </div>

            <!-- Card 2: Pelepasan 7.webp (Initially Back) -->
            <div
              class="hero-polaroid is-back"
              id="polaroidCard2"
              data-img="/images/7.webp"
              data-title="Pelepasan Murid Magang SMK NU & SMKN 11 Malang"
              data-desc="Sesi perpisahan hangat pelepasan murid magang SMK NU Sunan Ampel dan SMKN 11 Malang bersama para mentor industri di Saka."
              data-meta="Batch Ganjil 2024/2025 • SMK NU Sunan Ampel & SMKN 11 Malang"
            >
              <div class="tape-strip"></div>
              <img src="/images/7.webp" alt="Pelepasan Murid Magang SMK NU & SMKN 11 Malang" loading="eager" />
              <div class="polaroid-caption d-flex align-items-center justify-content-between">
                <div>
                  <span class="fw-bold d-block text-start">Pelepasan Murid Magang ✨</span>
                  <span class="text-muted small text-start d-block">SMK NU & SMKN 11 Malang</span>
                </div>
                <button
                  type="button"
                  class="btn-polaroid-zoom view-trigger"
                  title="Perbesar foto"
                  data-img="/images/7.webp"
                  data-title="Pelepasan Murid Magang SMK NU & SMKN 11 Malang"
                  data-desc="Sesi perpisahan hangat pelepasan murid magang SMK NU Sunan Ampel dan SMKN 11 Malang bersama para mentor industri di Saka."
                  data-meta="Batch Ganjil 2024/2025 • SMK NU Sunan Ampel & SMKN 11 Malang"
                  aria-label="Perbesar foto SMK NU & SMKN 11"
                >
                  <i class="bi bi-arrows-fullscreen"></i>
                </button>
              </div>
            </div>

            <!-- Interactive Hint Below Stack -->
            <div class="hero-polaroid-swap-pill">
              <i class="bi bi-arrow-left-right me-1 text-warning"></i>
              <span>Klik foto belakang untuk tukar</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- BAGIAN 1: BENTO COLLAGE SOROTAN (Bukan Sekadar Card Kotak Biasa) -->
  <section class="py-5 bg-slate-subtle">
    <div class="container">
      <div class="text-center mb-5">
        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 mb-2 fw-bold text-uppercase small">
          Sorotan Kenangan Emas
        </span>
        <h2 class="h3 fw-bold text-dark">Di Balik Lensa: Keseharian di Lingkungan Saka</h2>
        <p class="text-muted mx-auto" style="max-width: 600px;">
          Kolase visual yang merangkum dinamika kerja nyata, suasana bimbingan satu-lawan-satu, dan persahabatan antar peserta vokasi.
        </p>
      </div>

      <!-- Bento Grid Layout -->
      <div class="bento-grid">
        <!-- Bento 1: Grand Featured Showcase (Span 2 col, 2 row) -->
        <div class="bento-item bento-featured cursor-pointer view-trigger" data-img={featuredItem.image} data-title={featuredItem.title} data-desc={featuredItem.description} data-meta={`${featuredItem.batch} • ${featuredItem.school}`}>
          <img src={featuredItem.image} alt={featuredItem.title} class="bento-img" />
          <div class="bento-badge-tag">
            <i class="bi bi-award-fill me-1 text-warning"></i> Sorotan Utama
          </div>
          <div class="bento-overlay">
            <div class="bento-meta text-warning small fw-bold mb-1">
              <i class="bi bi-mortarboard-fill me-1"></i> {featuredItem.school}
            </div>
            <h3 class="h4 fw-bold text-white mb-2">{featuredItem.title}</h3>
            <p class="text-white-50 small mb-3 d-none d-md-block">{featuredItem.description}</p>
            <div class="d-inline-flex align-items-center gap-2 btn btn-sm btn-light rounded-pill px-3 py-1 fw-bold shadow-sm">
              <i class="bi bi-arrows-fullscreen"></i> Perbesar Foto
            </div>
          </div>
        </div>

        <!-- Bento 2: Farewell & Team Hangout -->
        <div class="bento-item bento-farewell cursor-pointer view-trigger" data-img={farewellItem.image} data-title={farewellItem.title} data-desc={farewellItem.description} data-meta={`${farewellItem.batch} • ${farewellItem.school}`}>
          <img src={farewellItem.image} alt={farewellItem.title} class="bento-img" />
          <div class="tape-strip-mini"></div>
          <div class="bento-overlay">
            <span class="badge bg-danger rounded-pill mb-2 small">Perayaan Farewell</span>
            <h4 class="h6 fw-bold text-white mb-1">{farewellItem.title}</h4>
            <span class="text-white-50 small">{farewellItem.school}</span>
          </div>
        </div>

        <!-- Bento 3: Studio Kreatif DKV -->
        <div class="bento-item bento-studio cursor-pointer view-trigger" data-img={studioItem.image} data-title={studioItem.title} data-desc={studioItem.description} data-meta={`${studioItem.batch} • ${studioItem.school}`}>
          <img src={studioItem.image} alt={studioItem.title} class="bento-img" />
          <div class="bento-overlay">
            <span class="badge bg-info text-dark rounded-pill mb-2 small">Studio Desain DKV</span>
            <h4 class="h6 fw-bold text-white mb-1">{studioItem.title}</h4>
            <span class="text-white-50 small">{studioItem.school}</span>
          </div>
        </div>

        <!-- Bento 4: Bimbingan Mentor -->
        <div class="bento-item bento-mentor cursor-pointer view-trigger" data-img={mentorItem.image} data-title={mentorItem.title} data-desc={mentorItem.description} data-meta={`${mentorItem.batch} • ${mentorItem.school}`}>
          <img src={mentorItem.image} alt={mentorItem.title} class="bento-img" />
          <div class="bento-overlay">
            <span class="badge bg-success rounded-pill mb-2 small">Bimbingan Mentor RPL</span>
            <h4 class="h6 fw-bold text-white mb-1">{mentorItem.title}</h4>
            <span class="text-white-50 small">{mentorItem.school}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BAGIAN 2: DINDING POLAROID SCRAPBOOK (Estetik & Unik dengan Efek Kemiringan Washi Tape) -->
  <section class="py-5 scrap-wall-section">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
        <div>
          <span class="badge bg-warning bg-opacity-25 text-dark rounded-pill px-3 py-1 mb-2 fw-bold text-uppercase small">
            <i class="bi bi-pin-angle-fill text-warning me-1"></i> Dinding Kenangan Siswa
          </span>
          <h2 class="h3 fw-bold text-dark mb-1">Koleksi Momen Pilihan Peserta</h2>
          <p class="text-muted mb-0 small">Klik foto mana saja untuk membuka detail kenangannya dalam mode layar penuh.</p>
        </div>

        <!-- Filter Kategori Aesthetic Pills -->
        <div class="d-flex flex-wrap gap-2" id="galleryFilter">
          {GALERI_CATEGORIES.map((cat, index) => (
            <button
              type="button"
              class:list={['scrap-filter-pill', index === 0 ? 'active' : '']}
              data-filter={cat.id}
            >
              {cat.id === 'all' && <i class="bi bi-grid-fill me-1"></i>}
              {cat.id === 'pelepasan' && <i class="bi bi-mortarboard-fill me-1"></i>}
              {cat.id === 'studio' && <i class="bi bi-camera-fill me-1"></i>}
              {cat.id === 'mentor' && <i class="bi bi-people-fill me-1"></i>}
              {cat.id === 'produksi' && <i class="bi bi-tools me-1"></i>}
              {cat.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Scrapbook Grid of Polaroids -->
      <div class="row g-4 pt-2" id="polaroidContainer">
        {GALERI_ITEMS.map((item, idx) => {
          // Playful natural rotations for authentic scrapbook feel
          const rotations = ['-1.8deg', '1.5deg', '-1.2deg', '2deg', '-1.5deg', '1.2deg', '-2deg', '1.8deg'];
          const rot = rotations[idx % rotations.length];

          return (
            <div class="col-sm-6 col-lg-3 polaroid-col" data-category={item.category}>
              <div
                class="polaroid-card cursor-pointer view-trigger"
                style={`--card-rot: ${rot};`}
                data-img={item.image}
                data-title={item.title}
                data-desc={item.description}
                data-meta={`${item.batch} • ${item.school}`}
              >
                <!-- Washi Tape Effect at Top -->
                <div class="washi-tape"></div>

                <!-- Photo Frame -->
                <div class="polaroid-photo-frame">
                  <img src={item.image} alt={item.title} loading="lazy" />
                  <span class="polaroid-category-tag">
                    {item.categoryLabel}
                  </span>
                </div>

                <!-- Handwritten-Style Bottom Caption -->
                <div class="polaroid-details">
                  <div class="polaroid-title">{item.title}</div>
                  <div class="polaroid-school">
                    <i class="bi bi-geo-alt-fill me-1"></i>{item.school}
                  </div>
                  <div class="polaroid-footer">
                    <span class="polaroid-date">{item.date}</span>
                    <span class="polaroid-btn">
                      <i class="bi bi-zoom-in"></i> Lihat
                    </span>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- BAGIAN 3: ROL FILM HORISONTAL (Behind the Scenes Filmstrip) -->
  <section class="py-5 bg-dark text-white position-relative overflow-hidden">
    <div class="container mb-4">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1 mb-2 small">
            <i class="bi bi-film me-1"></i> BEHIND THE SCENES
          </span>
          <h2 class="h3 fw-bold mb-1 text-white">Rol Film: Momen Candid Keseharian</h2>
          <p class="text-white-50 small mb-0">Geser untuk melihat potongan momen santai di sela-sela jam kerja dan workshop.</p>
        </div>
        <div class="small text-white-50 d-none d-sm-block">
          <i class="bi bi-arrow-left-right me-1 text-warning"></i> Scroll Horisontal
        </div>
      </div>
    </div>

    <!-- Film Strip Container -->
    <div class="filmstrip-wrapper">
      <div class="filmstrip-track">
        {GALERI_ITEMS.concat(GALERI_ITEMS.slice(0, 4)).map((item, idx) => (
          <div class="filmstrip-frame cursor-pointer view-trigger" data-img={item.image} data-title={item.title} data-desc={item.description} data-meta={`${item.batch} • ${item.school}`}>
            <div class="film-holes film-holes-top">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="film-img-box">
              <img src={item.image} alt={item.title} loading="lazy" />
              <div class="film-stamp">FRAME #0{idx + 1}</div>
            </div>
            <div class="film-holes film-holes-bottom">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BAGIAN 4: STICKY NOTES CATATAN HATI ALUMNI (Wall of Love & Gratitude) -->
  <section class="py-5 bg-light position-relative">
    <div class="container">
      <div class="text-center mb-5">
        <span class="badge bg-secondary bg-opacity-25 text-dark rounded-pill px-3 py-1 mb-2 fw-bold text-uppercase small">
          Kesan & Pesan Siswa
        </span>
        <h2 class="h3 fw-bold text-dark">Apa Kata Mereka yang Pernah Berproses di Saka?</h2>
        <p class="text-muted mx-auto" style="max-width: 580px;">
          Catatan hangat dan testimoni langsung dari adik-adik magang yang telah menyelesaikan masa PKL mereka.
        </p>
      </div>

      <div class="row g-4">
        {alumniNotes.map((note) => (
          <div class="col-md-6 col-lg-3">
            <div
              class="sticky-note-card shadow-sm"
              style={`background-color: ${note.color}; border-top: 5px solid ${note.border}; --note-rot: ${note.rotate};`}
            >
              <div class="pin-icon">
                <i class="bi bi-pin-fill text-danger"></i>
              </div>
              <p class="sticky-quote fst-italic text-dark mb-4">
                "{note.quote}"
              </p>
              <div class="sticky-author pt-3 border-top border-dark border-opacity-10">
                <div class="fw-bold text-dark">{note.name}</div>
                <div class="small text-muted">{note.school}</div>
                <div class="badge bg-dark bg-opacity-10 text-dark rounded-pill mt-1 small">
                  {note.batch}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox Modal Layar Penuh -->
  <div id="galleryLightbox" class="gallery-lightbox" aria-hidden="true" role="dialog" aria-label="Pratinjau Foto">
    <div class="gallery-lightbox-backdrop"></div>
    <div class="gallery-lightbox-dialog">
      <button type="button" id="lightboxClose" class="lightbox-close" aria-label="Tutup Layar Penuh">
        <i class="bi bi-x-lg"></i>
      </button>

      <div class="gallery-lightbox-content">
        <div class="gallery-lightbox-img-wrap">
          <img id="lightboxImg" src="" alt="" class="gallery-lightbox-img" />
        </div>
        <div class="gallery-lightbox-caption">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span id="lightboxMeta" class="badge bg-warning text-dark px-3 py-1 rounded-pill small fw-bold"></span>
            <span class="small text-white-50"><i class="bi bi-check-circle-fill text-success me-1"></i> Dokumentasi Terverifikasi</span>
          </div>
          <h3 id="lightboxTitle" class="h5 fw-bold text-white mb-2"></h3>
          <p id="lightboxDesc" class="small text-white-50 mb-0"></p>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA Box -->
  <CTASection
    title="Siap Mengukir Cerita Sukses & Kenangan Berharga di Saka?"
