<script>
  function initAestheticGallery() {
    // Filter logic for Polaroid Scrapbook Wall
    const filterBtns = document.querySelectorAll('.scrap-filter-pill');
    const polaroidCols = document.querySelectorAll('.polaroid-col');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        polaroidCols.forEach((col) => {
          const cat = col.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            (col as HTMLElement).style.display = 'block';
          } else {
            (col as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Lightbox Logic
    const lightbox = document.getElementById('galleryLightbox');
    const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
    const lightboxTitle = document.getElementById('lightboxTitle');
    const lightboxMeta = document.getElementById('lightboxMeta');
    const lightboxDesc = document.getElementById('lightboxDesc');
    const closeBtn = document.getElementById('lightboxClose');
    const backdrop = document.querySelector('.gallery-lightbox-backdrop');

    function openLightbox(img: string, title: string, desc: string, meta: string) {
      if (!lightbox || !lightboxImg || !lightboxTitle || !lightboxDesc || !lightboxMeta) return;
      lightboxImg.src = img;
      lightboxImg.alt = title;
      lightboxTitle.textContent = title;
      lightboxMeta.textContent = meta;
      lightboxDesc.textContent = desc;
      lightbox.classList.add('show');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('show');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.view-trigger').forEach((el) => {
      el.addEventListener('click', () => {
        const img = el.getAttribute('data-img') || '';
        const title = el.getAttribute('data-title') || '';
        const desc = el.getAttribute('data-desc') || '';
        const meta = el.getAttribute('data-meta') || '';
        openLightbox(img, title, desc, meta);
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (backdrop) backdrop.addEventListener('click', closeLightbox);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    // Polaroid Stack Interactive Swap (Foto Belakang Pindah ke Depan)
    const stack = document.getElementById('heroPolaroidStack');
    if (stack) {
      let isAnimating = false;
      const card1 = document.getElementById('polaroidCard1');
      const card2 = document.getElementById('polaroidCard2');
      const swapPill = stack.querySelector('.hero-polaroid-swap-pill');

      function swapCards() {
        if (isAnimating || !card1 || !card2) return;
        isAnimating = true;

        const currentFront = card1.classList.contains('is-front') ? card1 : card2;
        const currentBack = currentFront === card1 ? card2 : card1;

        // Animasi foto belakang meluncur keluar lalu mendarat di posisi depan
        currentBack.classList.add('swapping-out');

        setTimeout(() => {
          currentBack.classList.remove('is-back', 'swapping-out');
          currentBack.classList.add('is-front');

          currentFront.classList.remove('is-front');
          currentFront.classList.add('is-back');

          setTimeout(() => {
            isAnimating = false;
          }, 320);
        }, 180);
      }

      card1.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.btn-polaroid-zoom')) return;
        swapCards();
      });

      card2.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.btn-polaroid-zoom')) return;
        swapCards();
      });

      if (swapPill) {
        swapPill.addEventListener('click', (e) => {
          e.stopPropagation();
          swapCards();
        });
      }
    }
  }

  initAestheticGallery();
  document.addEventListener('astro:page-load', initAestheticGallery);
</script>
