                        {idx < dailyRoutine.length - 1 && (
                          <button
                            type="button"
                            class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold text-primary routine-next-btn"
                            data-next-step={idx + 1}
                          >
                            Berikutnya <i class="bi bi-chevron-right"></i>
                          </button>
                        )}
                        {idx === dailyRoutine.length - 1 && (
                          <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="bi bi-check-circle-fill me-1"></i>Pulang On-Time
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Mobile Step Indicator Dots -->
          <div class="d-flex align-items-center justify-content-center gap-1.5 mt-3">
            {dailyRoutine.map((_, idx) => (
              <span class={`routine-step-dot ${idx === 0 ? 'active' : ''}`} data-dot-index={idx}></span>
            ))}
          </div>
        </div>
      </div>
    </div>
