    progress: 50,
    title: 'Mengerjakan Tugas Divisi & Proyek Industri',
    desc: 'Fokus pengerjaan tugas divisi (DKV, Web Dev, SEO, Video Kreatif, atau Kemasan). Mentor selalu standby di samping untuk mendampingi jika ada kendala teknis.',
    icon: 'bi-laptop-fill',
    badgeClass: 'bg-success-subtle text-success border-success-subtle',
    bgImage: '/images/21.webp',
  },
  {
