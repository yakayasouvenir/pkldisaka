  <script>
    function setupEnvCarousel() {
      const track = document.getElementById('envCarouselTrack');
      const prevBtn = document.getElementById('envCarouselPrev') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('envCarouselNext') as HTMLButtonElement | null;
      if (!track || !prevBtn || !nextBtn) return;

      function updateNavState() {
        if (!track || !prevBtn || !nextBtn) return;
        const atStart = track.scrollLeft <= 10;
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 10;
        prevBtn.disabled = atStart;
        nextBtn.disabled = atEnd;
      }

      prevBtn.addEventListener('click', () => {
        const item = track.querySelector('.env-carousel-item') as HTMLElement | null;
        const cardWidth = item ? item.offsetWidth + 20 : 340;
        track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        const item = track.querySelector('.env-carousel-item') as HTMLElement | null;
        const cardWidth = item ? item.offsetWidth + 20 : 340;
        track.scrollBy({ left: cardWidth, behavior: 'smooth' });
      });

      // Mouse Drag-to-Scroll (Desktop)
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      let hasDragged = false;

      track.addEventListener('mousedown', (e: MouseEvent) => {
        if (e.button !== 0) return; // Klik kiri saja
        isDown = true;
        hasDragged = false;
        track.classList.add('is-dragging');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      window.addEventListener('mouseup', () => {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('is-dragging');
      });

      track.addEventListener('mouseleave', () => {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('is-dragging');
      });

      track.addEventListener('mousemove', (e: MouseEvent) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5; // Kecepatan scroll responsif
        if (Math.abs(walk) > 5) {
          hasDragged = true;
        }
        track.scrollLeft = scrollLeft - walk;
      });

      track.addEventListener(
        'click',
        (e: MouseEvent) => {
          if (hasDragged) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );

      track.addEventListener('scroll', updateNavState, { passive: true });
      window.addEventListener('resize', updateNavState, { passive: true });
      updateNavState();
    }

    function setupHomeVideoModal() {
      const videoBtns = document.querySelectorAll('.home-video-modal-btn');
      const modalTitle = document.getElementById('homeModalVideoTitle');
      const modalThumb = document.getElementById('homeModalVideoThumb') as HTMLImageElement | null;
      const modalDesc = document.getElementById('homeModalVideoDesc');
      const modalAuthor = document.getElementById('homeModalVideoAuthor');

      videoBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const title = btn.getAttribute('data-title') || 'Video Testimoni';
          const author = btn.getAttribute('data-author') || '';
          const desc = btn.getAttribute('data-desc') || '';
          const thumb = btn.getAttribute('data-thumb') || '';

          if (modalTitle) modalTitle.textContent = title;
          if (modalThumb && thumb) modalThumb.src = thumb;
          if (modalDesc) modalDesc.textContent = desc;
          if (modalAuthor) modalAuthor.textContent = author;

          const modalEl = document.getElementById('homeVideoModal');
          if (modalEl && (window as any).bootstrap) {
            const modal = new (window as any).bootstrap.Modal(modalEl);
            modal.show();
          }
        });
      });
    }

    function initHomePage() {
      setupEnvCarousel();
      setupHomeVideoModal();
    }

    initHomePage();
    document.addEventListener('astro:page-load', initHomePage);
  </script>

