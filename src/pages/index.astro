    link: '/divisi/digital-marketing/',
    linkText: 'Pelajari Digital Marketing →',
  },
  {
    image: '/images/15.webp',
    alt: 'Aktivitas pemotretan produk dengan tata cahaya softbox studio oleh siswi magang SMK',
    badge: 'Divisi Konten & Multimedia',
    title: 'Studio Foto & Kurasi Konten Kreatif',
    desc: 'Praktik langsung penataan tata cahaya softbox, pemotretan katalog produk komersial, penyusunan storyboard, serta kurasi video promosi pendek untuk platform media sosial.',
    link: '/divisi/foto-video-produk/',
    linkText: 'Pelajari Foto & Video →',
  },
  {
    image: '/images/1.webp',
    alt: 'Praktik perakitan boks kemasan souvenir dan pemeriksaan dummy prototipe oleh peserta PKL',
    badge: 'Divisi Kemasan & Produksi',
    title: 'Pemeriksaan Pracetak & Finishing Kemasan',
    desc: 'Siswa Teknik Grafika dan Produksi mempelajari kalibrasi warna cetak, spesifikasi bahan karton kemasan, pembuatan dummy prototipe, serta teknik finishing hotprint dan embossing.',
    link: '/divisi/packaging/',
    linkText: 'Pelajari Divisi Kemasan →',
  },
  {
    image: '/images/10.webp',
    alt: 'Suasana ruang kerja dan fasilitas operasional PKL peserta magang di Saka Malang',
    badge: 'Fasilitas & Ekosistem Industri',
    title: 'Fasilitas Ruang Kerja Kondusif',
    desc: 'Didukung koneksi internet cepat, perangkat kerja terintegrasi, suasana studio yang tenang, serta area diskusi terbuka untuk menunjang produktivitas harian seluruh peserta magang.',
    link: '/program-pkl/fasilitas/',
    linkText: 'Lihat Fasilitas PKL →',
  },
];

const faqs = homePage.faqs;
---

<BaseLayout
  title={homePage.title}
  description={homePage.metaDescription}
  path="/"
  schema={[faqNode('/', faqs)]}
>
  <!-- 1. HERO SECTION: FULLSCREEN BACKGROUND DENGAN OVERLAY TRANSPARAN -->
  <section
    class="home-hero-fullscreen text-center"
    style="--hero-bg: url('/images/13.webp');"
  >
    <div class="home-hero-overlay" aria-hidden="true"></div>

    <div class="container home-hero-content">
      <a href="/lowongan-pkl/" class="home-hero-badge text-decoration-none shadow-sm" aria-label="Cari Peluang - Wujudkan Karier Impianmu">
        <span class="home-hero-badge-pill">Cari Peluang</span>
        <div class="home-hero-badge-text text-start">
          <div class="home-hero-badge-title">Wujudkan Karier Impianmu</div>
          <div class="home-hero-badge-sub">Peluang kerja dan magang untuk masa depanmu</div>
        </div>
      </a>

      <h1 class="home-hero-title">
        Tempat Magang dan PKL Paling Asik di Malang
      </h1>

      <p class="home-hero-lead">
        Ekosistem kerja asik, family friendly, tempat grow bersama dan tidak ada senioritas.
      </p>

      <div class="d-flex flex-wrap gap-3 justify-content-center mb-3">
        <a href="/cara-daftar/" class="btn-primary-saka shadow-lg">
          <i class="bi bi-journal-check"></i>
          <span>Panduan Cara Daftar</span>
        </a>
        <a
          href="/aktivitas-magang/"
          class="btn btn-outline-light rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2 fw-semibold"
          style="backdrop-filter: blur(6px); background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.4);"
        >
          <i class="bi bi-play-circle-fill"></i>
          <span>Aktivitas Magang</span>
        </a>
      </div>

      <!-- Factual Notice Transparan & Teks Jelas -->
      <div class="home-hero-status-box mx-auto" style="max-width: 760px;">
        <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap text-start">
          <span class="badge bg-success text-white px-2 py-1 rounded-pill flex-shrink-0" style="font-size: 0.76rem;">
            <i class="bi bi-shield-check me-1"></i>Informasi Faktual
          </span>
          <span class="small" style="line-height: 1.5;">
            Seluruh prosedur PKL, kelengkapan berkas, dan jadwal penerimaan diselaraskan dengan tata kelola resmi pendidikan vokasi.
          </span>
        </div>
      </div>


    </div>
  </section>

  <!-- MITRA SEKOLAH (ANIMASI 1 BARIS / CONTINUOUS RUNNING LOGO TICKER) -->
  <section class="partner-marquee-section" aria-label="Mitra Sekolah & Kampus">
    <div class="container mb-3">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div>
          <div class="d-inline-flex align-items-center gap-1.5 badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 mb-1 font-monospace" style="font-size: 0.72rem;">
            <i class="bi bi-mortarboard-fill text-primary"></i>
            <span>Sinergi Vokasi Industri</span>
          </div>
          <h2 class="h5 fw-bold mb-0 text-dark">Sekolah & Kampus Mitra PKL di Saka</h2>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="small text-muted d-none d-lg-inline">Telah bermitra dengan {SCHOOL_PARTNERS.length} institusi pendidikan</span>
          <a
            href="/mitra/"
            class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-2xs"
            style="font-size: 0.82rem;"
          >
            <span>Lihat Semua Mitra</span>
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- 1 Baris Ticker Marquee yang Mengalir Terus Menerus -->
    <div class="partner-marquee-container">
      <div class="partner-marquee-track">
        {[...SCHOOL_PARTNERS, ...SCHOOL_PARTNERS].map((school, idx) => (
          <a
            href="/mitra/"
            class="partner-marquee-item"
            title={`${school.name} - ${school.city} (${school.type})`}
            aria-hidden={idx >= SCHOOL_PARTNERS.length ? 'true' : 'false'}
          >
            <div class="partner-marquee-logo">
              <img
                src={school.logo}
                alt={`Logo ${school.name}`}
                width="28"
                height="28"
                loading="lazy"
              />
            </div>
            <div class="partner-marquee-info">
              <span class="partner-marquee-name">{school.name}</span>
              <span class="partner-marquee-meta">
                <span class="badge bg-light text-secondary border py-0 px-1 font-monospace" style="font-size: 0.65rem;">
                  {school.type}
                </span>
                <span>•</span>
                <span>{school.city}</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- JADWAL MAGANG & RUTINITAS HARIAN (DESKTOP: TIMELINE VERTIKAL TETAP, MOBILE: INTERACTIVE SWIPE DECK) -->
  <section class="content-section" id="jadwal-rutinitas" style="background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);">
    <div class="container">
      <div class="text-center mx-auto mb-4" style="max-width: 760px;">
        <span class="section-heading-eyebrow">Jam Kerja & Keseharian Magang</span>
        <h2 class="section-heading-title">PKL Cuma 5 Hari Kerja: Senin – Jumat (08:00 – 16:00)</h2>
        <p class="section-heading-desc mb-0">
          Di Saka, kami menerapkan jam magang mulai jam <strong>08:00 – 16:00 WIB</strong>. PKL di kami cuma 5 hari kerja (Senin – Jumat), <strong>Sabtu dan Minggu libur</strong>. Istirahat siang 1 jam (12:00 – 13:00 WIB), lingkungan kerja family friendly, dan tanpa senioritas!
        </p>
      </div>

      <!-- 4 Highlight Cards Jadwal (Compact Grid) -->
      <div class="row g-3 g-md-4 mb-4">
        <div class="col-6 col-lg-3">
          <div class="schedule-stat-card p-3 p-md-4 h-100 rounded-4 border bg-white shadow-xs text-center">
            <div class="schedule-stat-icon bg-primary text-white mx-auto mb-2 mb-md-3">
              <i class="bi bi-calendar2-week-fill"></i>
            </div>
            <div class="h6 fw-bold mb-1 text-dark">5 Hari Kerja</div>
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle mb-1 mb-md-2" style="font-size: 0.72rem;">Senin – Jumat</div>
            <p class="small text-muted mb-0 d-none d-sm-block">Sabtu & Minggu libur total. Waktu seimbang buat istirahat & keluarga.</p>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="schedule-stat-card p-3 p-md-4 h-100 rounded-4 border bg-white shadow-xs text-center">
            <div class="schedule-stat-icon bg-success text-white mx-auto mb-2 mb-md-3">
              <i class="bi bi-clock-history"></i>
            </div>
            <div class="h6 fw-bold mb-1 text-dark">08:00 – 16:00 WIB</div>
            <div class="badge bg-success-subtle text-success border border-success-subtle mb-1 mb-md-2" style="font-size: 0.72rem;">Jam Teratur</div>
            <p class="small text-muted mb-0 d-none d-sm-block">Magang mulai jam 8 pagi sampai 4 sore. Selesai piket langsung pulang on-time.</p>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="schedule-stat-card p-3 p-md-4 h-100 rounded-4 border bg-white shadow-xs text-center">
            <div class="schedule-stat-icon bg-warning text-dark mx-auto mb-2 mb-md-3">
              <i class="bi bi-cup-hot-fill"></i>
            </div>
            <div class="h6 fw-bold mb-1 text-dark">Istirahat 1 Jam</div>
            <div class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mb-1 mb-md-2" style="font-size: 0.72rem;">12:00 – 13:00 WIB</div>
            <p class="small text-muted mb-0 d-none d-sm-block">Waktu 1 jam saat adzan Dzuhur. Cukup buat sholat dan makan siang bareng.</p>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="schedule-stat-card p-3 p-md-4 h-100 rounded-4 border bg-white shadow-xs text-center">
            <div class="schedule-stat-icon bg-info text-white mx-auto mb-2 mb-md-3">
              <i class="bi bi-heart-fill"></i>
            </div>
            <div class="h6 fw-bold mb-1 text-dark">No Senioritas</div>
            <div class="badge bg-info-subtle text-info border border-info-subtle mb-1 mb-md-2" style="font-size: 0.72rem;">Family Friendly</div>
            <p class="small text-muted mb-0 d-none d-sm-block">Doa bersama pagi & sore, piket bareng, dan mentor suportif seperti teman.</p>
          </div>
        </div>
      </div>

      <!-- 1. TAMPILAN DESKTOP: TIMELINE VERTIKAL TETAP TERSTRUKTUR (SESUAI PERMINTAAN USER) -->
      <div class="d-none d-lg-block">
        <div class="daily-timeline-wrapper bg-white p-4 p-lg-5 rounded-4 border shadow-sm">
          <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom">
            <i class="bi bi-list-task text-primary fs-4"></i>
            <div>
              <h3 class="h5 fw-bold mb-0 text-dark">Rangkaian Kegiatan yang Dilakukan Harian</h3>
              <span class="small text-muted">Aktivitas teratur mulai dari kedatangan sebelum jam 08:00 hingga kepulangan jam 16:00 WIB</span>
            </div>
          </div>

          <div class="daily-timeline">
            {dailyRoutine.map((item, idx) => (
              <div class="daily-timeline-item">
                <div class="daily-timeline-marker">
                  <div class="daily-timeline-icon">
                    <i class={`bi ${item.icon}`}></i>
                  </div>
                  {idx < dailyRoutine.length - 1 && <div class="daily-timeline-line"></div>}
                </div>
                <div class="daily-timeline-content">
                  <div class="daily-timeline-card position-relative overflow-hidden p-3 p-lg-3.5 rounded-3 border bg-white shadow-xs">
                    <!-- Transparent Background Photo (Teks Tetap Jelas Terbaca) -->
                    <div class="routine-card-bg-wrap" aria-hidden="true">
                      <img src={item.bgImage} alt="" class="routine-card-bg-img" loading="lazy" />
                      <div class="routine-card-bg-overlay"></div>
                    </div>

                    <div class="position-relative z-1">
                      <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <span class="daily-timeline-time font-monospace fw-bold">{item.time}</span>
                        <span class={`badge border rounded-pill ${item.badgeClass}`} style="font-size: 0.72rem;">{item.badge}</span>
                      </div>
                      <h4 class="h6 fw-bold mb-1 text-dark">{item.title}</h4>
                      <p class="small text-muted mb-0" style="line-height: 1.55;">{item.desc}</p>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- 2. TAMPILAN MOBILE: INTERACTIVE SWIPE CARD DECK (TIDAK HANYA SCROLL LURUS KE BAWAH) -->
      <div class="d-lg-none">
        <div class="daily-routine-box bg-white p-3 p-md-4 rounded-4 border shadow-sm">
          <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3 pb-2 border-bottom">
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-primary text-white rounded-circle p-2">
                <i class="bi bi-list-stars"></i>
              </span>
              <div>
                <h3 class="h6 fw-bold mb-0 text-dark">Rangkaian Kegiatan Harian</h3>
                <span class="small text-muted" style="font-size: 0.75rem;">Aktivitas teratur dari pagi hingga pulang</span>
              </div>
            </div>
            <div class="d-flex align-items-center gap-1.5 text-muted small font-monospace" style="font-size: 0.72rem;">
              <i class="bi bi-arrow-left-right text-primary"></i>
              <span>Geser kartu alur</span>
            </div>
          </div>

          <!-- Horizontal Quick Nav Pills -->
          <div class="routine-pills-nav-wrapper mb-3">
            <div class="routine-pills-nav" id="routinePillsNav" role="tablist" aria-label="Pilih Jam Kegiatan">
              {dailyRoutine.map((item, idx) => (
                <button
                  type="button"
                  class={`routine-pill-btn ${idx === 0 ? 'active' : ''}`}
                  data-step-target={idx}
                  aria-label={`Lihat kegiatan ${item.time}`}
                >
                  <span>{item.emoji}</span>
                  <span class="routine-pill-time">{item.shortTime}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Swipeable Cards Track -->
          <div class="routine-swipe-container">
            <div class="routine-swipe-track" id="routineSwipeTrack" tabindex="0" role="region" aria-label="Alur kegiatan harian anak magang">
              {dailyRoutine.map((item, idx) => (
                <div class="routine-swipe-card" data-step-index={idx}>
                  <div class="routine-card-inner position-relative overflow-hidden">
                    <!-- Transparent Background Photo (Teks Tetap Jelas Terbaca) -->
                    <div class="routine-card-bg-wrap" aria-hidden="true">
                      <img src={item.bgImage} alt="" class="routine-card-bg-img" loading="lazy" />
                      <div class="routine-card-bg-overlay"></div>
                    </div>

                    <div class="position-relative z-1 d-flex flex-column h-100">
                      <!-- Header Step & Progress -->
                      <div class="routine-card-header">
                        <div class="d-flex align-items-center justify-content-between w-100 mb-2">
                          <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.7rem;">
                            Step {item.step} of 7
                          </span>
                          <span class={`badge border rounded-pill ${item.badgeClass}`} style="font-size: 0.72rem;">
                            {item.badge}
                          </span>
                        </div>

                        <div class="routine-card-progressbar" title={`Progres Hari: ${item.progress}%`}>
                          <div class="routine-card-progressbar-fill" style={`width: ${item.progress}%;`}></div>
                        </div>
                      </div>

                      <!-- Body -->
                      <div class="routine-card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                          <span class="routine-card-emoji">{item.emoji}</span>
                          <span class="routine-card-time font-monospace fw-bold">{item.time}</span>
                        </div>
                        <h4 class="routine-card-title">{item.title}</h4>
                        <p class="routine-card-desc">{item.desc}</p>
                      </div>

