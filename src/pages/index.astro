---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LinkCard from '../components/LinkCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articleVisuals } from '../data/visuals';
import FAQList from '../components/FAQList.astro';
import CTASection from '../components/CTASection.astro';
import StatusNotice from '../components/StatusNotice.astro';
import { PKL_PAGES, GROUPS_INFO, getCategoryChildren } from '../data/pklData';
import { SCHOOL_PARTNERS } from '../data/partners';
import { TESTIMONIALS } from '../data/testimonials';
import { faqNode } from '../lib/schema';
import { waLink } from '../data/site';

const homePage = PKL_PAGES.find((p) => p.path === '/')!;
const jurusans = getCategoryChildren('jurusan').slice(0, 6);
const divisis = getCategoryChildren('divisi').slice(0, 6);
const panduanArticles = PKL_PAGES.filter(
  (p) => ['B8', 'B9', 'B10', 'B11'].includes(p.group) && !p.isHub
).slice(0, 6);

const arsipBgImages = [
  '/images/4.webp',
  '/images/8.webp',
  '/images/10.webp',
  '/images/13.webp',
  '/images/22.webp',
  '/images/21.webp',
];

const dailyRoutine = [
