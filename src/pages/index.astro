    emoji: '🚀',
    badge: 'Lanjut Tugas',
    progress: 85,
    title: 'Lanjut Mengerjakan Tugas & Review Mentor',
    desc: 'Melanjutkan pengerjaan tugas proyek industri, eksplorasi ide kreatif, dan sesi review santai dari mentor untuk memastikan kualitas portofolio siswa berstandar agensi.',
    icon: 'bi-gear-wide-connected',
    badgeClass: 'bg-primary-subtle text-primary border-primary-subtle',
    bgImage: '/images/12.webp',
  },
  {
    step: 6,
    time: '15:50 – 16:00 WIB',
    shortTime: '15:50 Siap Pulang',
    emoji: '🎒',
    badge: 'Persiapan Pulang',
    progress: 95,
    title: 'Persiapan Pulang & Doa Bersama',
    desc: 'Jam 15:50 mulai bersiap-siap, merapikan file pekerjaan, menyimpan dokumen di repositori/cloud, evaluasi singkat harian, dan ditutup dengan doa bersama.',
    icon: 'bi-check-circle-fill',
    badgeClass: 'bg-secondary-subtle text-secondary border-secondary-subtle',
    bgImage: '/images/15.webp',
  },
  {
    step: 7,
    time: 'Tepat 16:00 WIB',
    shortTime: '16:00 Pulang',
    emoji: '🚪',
    badge: 'Langsung Pulang',
    progress: 100,
    title: 'Piket Sore & Langsung Pulang (Bebas Lembur)',
    desc: 'Piket sore kilat merapikan workstation masing-masing. Begitu jam 16:00 tiba, seluruh anak magang langsung pulang! Tidak ada lembur malam, waktu istirahat di rumah terjamin.',
    icon: 'bi-door-open-fill',
    badgeClass: 'bg-danger-subtle text-danger border-danger-subtle',
    bgImage: '/images/8.webp',
  },
];

// 6 Foto Showcase: Praktik Nyata & Lingkungan Kerja (Dengan 1 Card Digital Marketing Sesuai Permintaan)
const lingkunganPhotos = [
  {
    image: '/images/12.webp',
    alt: 'Peserta PKL divisi Desain Grafis dan DKV sedang merancang layout desain visual di studio',
    badge: 'Divisi Desain & DKV',
