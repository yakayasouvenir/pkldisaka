---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LinkCard from '../components/LinkCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articleVisuals } from '../data/visuals';
import FAQList from '../components/FAQList.astro';
import CTASection from '../components/CTASection.astro';
import StatusNotice from '../components/StatusNotice.astro';
import { PKL_PAGES, GROUPS_INFO, getCategoryChildren } from '../data/pklData';
import { SCHOOL_PARTNERS } from '../data/partners';
import { TESTIMONIALS } from '../data/testimonials';
import { faqNode } from '../lib/schema';
import { waLink } from '../data/site';

const homePage = PKL_PAGES.find((p) => p.path === '/')!;
const jurusans = getCategoryChildren('jurusan').slice(0, 6);
const divisis = getCategoryChildren('divisi').slice(0, 6);
const panduanArticles = PKL_PAGES.filter(
  (p) => ['B8', 'B9', 'B10', 'B11'].includes(p.group) && !p.isHub
).slice(0, 6);

const arsipBgImages = [
  '/images/4.webp',
  '/images/8.webp',
  '/images/10.webp',
  '/images/13.webp',
  '/images/22.webp',
  '/images/21.webp',
];

const dailyRoutine = [
  {
    time: 'Sebelum 08:00 WIB',
    badge: 'Disiplin Pagi',
    title: 'Datang Sebelum Jam 08:00, Doa Bersama & Piket Pagi',
    desc: 'Peserta magang hadir tepat waktu sebelum jam 08:00. Mengawali pagi dengan doa bersama demi kelancaran aktivitas, dilanjutkan piket pagi bersama membersihkan dan merapikan ruang kerja studio.',
    icon: 'bi-sun-fill',
    badgeClass: 'bg-primary-subtle text-primary border-primary-subtle',
  },
  {
    time: '08:00 – 08:30 WIB',
    badge: 'Briefing Santai',
    title: 'Briefing Tugas yang Akan Dikerjakan / Materi',
    desc: 'Setelah piket, seluruh siswa dan mentor berkumpul untuk briefing harian. Mentor memaparkan materi praktis, arahan teknis proyek komersial klien, serta pembagian target hari ini.',
    icon: 'bi-chat-dots-fill',
    badgeClass: 'bg-info-subtle text-info border-info-subtle',
  },
  {
    time: '08:30 – 11:30 WIB',
    badge: 'Praktik Nyata',
    title: 'Mengerjakan Tugas Divisi & Proyek Industri',
    desc: 'Fokus pengerjaan tugas divisi (DKV, Web Development, SEO, Video Konten, maupun Produksi Kemasan) dengan bimbingan dan supervisi santai dari mentor profesional.',
    icon: 'bi-laptop-fill',
    badgeClass: 'bg-success-subtle text-success border-success-subtle',
  },
  {
    time: '11:30 – 13:00 WIB',
    badge: 'Ishoma 1,5 Jam',
    title: 'Istirahat Jam 11:30 / Adzan Dzuhur – Jam 1 (13:00)',
    desc: 'Waktu istirahat panjang 1,5 jam mulai saat adzan Dzuhur (11:30) sampai jam 13:00 siang. Siswa dapat sholat Dzuhur berjamaah, makan siang santai bareng, ngobrol akrab, dan rehat.',
    icon: 'bi-cup-hot-fill',
    badgeClass: 'bg-warning-subtle text-warning-emphasis border-warning-subtle',
  },
  {
    time: '13:00 – 15:50 WIB',
    badge: 'Lanjut Tugas',
    title: 'Lanjut Mengerjakan Tugas & Review Hasil Kerja',
    desc: 'Kembali beraktivitas melanjutkan eksekusi tugas proyek, eksplorasi ide kreatif, serta sesi review langsung dari mentor untuk memastikan kualitas portofolio siswa.',
    icon: 'bi-gear-wide-connected',
    badgeClass: 'bg-primary-subtle text-primary border-primary-subtle',
  },
  {
    time: '15:50 – 16:00 WIB',
    badge: 'Penutupan Hari',
    title: 'Persiapan Pulang & Doa Bersama',
    desc: 'Ketika jam 15:50, peserta mulai bersiap-siap, merapikan file pekerjaan, menyimpan dokumen di repositori/cloud, evaluasi singkat harian, dan ditutup dengan doa bersama.',
    icon: 'bi-check-circle-fill',
    badgeClass: 'bg-secondary-subtle text-secondary border-secondary-subtle',
  },
  {
    time: 'Tepat 16:00 WIB',
    badge: 'Langsung Pulang',
    title: 'Piket Sore & Langsung Pulang (Bebas Lembur)',
    desc: 'Setelah doa bersama, siswa melakukan piket sore merapikan workstation masing-masing. Tepat jam 16:00 langsung pulang tanpa ada beban lembur malam!',
    icon: 'bi-door-open-fill',
    badgeClass: 'bg-danger-subtle text-danger border-danger-subtle',
  },
];

const lingkunganPhotos = [
  {
    image: '/images/12.webp',
    alt: 'Peserta PKL divisi Desain Grafis dan DKV sedang merancang layout desain visual di studio',
    badge: 'Divisi Desain & DKV',
    title: 'Studio Desain & Perancangan Visual',
    desc: 'Peserta jurusan DKV dan Multimedia mengasah kemahiran dalam perancangan identitas merek, desain kemasan produk UMKM, tipografi, dan aset visual pemasaran dengan bimbingan standar industri.',
    link: '/divisi/desain-grafis/',
    linkText: 'Pelajari Divisi Desain →',
  },
  {
    image: '/images/21.webp',
    alt: 'Sesi praktik teknis coding web development dan mentoring arsitektur website peserta PKL',
    badge: 'Divisi Web & IT',
    title: 'Mentoring Teknis & Analisis Digital',
    desc: 'Siswa RPL dan TKJ mendapatkan arahan teknis rutin mengenai optimasi struktur website, performa kecepatan halaman, riset kata kunci SEO, dan integrasi analitik secara berkala.',
    link: '/divisi/seo-website/',
    linkText: 'Pelajari Divisi SEO & Web →',
  },
  {
    image: '/images/22.webp',
    alt: 'Peserta magang PKL berdiskusi dan berkolaborasi dalam menyelesaikan proyek digital tim',
    badge: 'Kolaborasi Antar Jurusan',
    title: 'Ruang Kerja Kolaboratif Antar Divisi',
    desc: 'Membiasakan peserta dengan ritme kerja agensi nyata: sinergi antara divisi kreatif visual, pemrograman web, dan pemasaran digital agar proyek terselesaikan tepat sasaran.',
    link: '/divisi/digital-marketing/',
    linkText: 'Pelajari Digital Marketing →',
  },
  {
    image: '/images/15.webp',
    alt: 'Aktivitas pemotretan produk dengan tata cahaya softbox studio oleh siswi magang SMK',
    badge: 'Divisi Konten & Multimedia',
    title: 'Studio Foto & Kurasi Konten Kreatif',
    desc: 'Praktik langsung penataan tata cahaya softbox, pemotretan katalog produk komersial, penyusunan storyboard, serta kurasi video promosi pendek untuk platform media sosial.',
    link: '/divisi/foto-video-produk/',
    linkText: 'Pelajari Foto & Video →',
  },
  {
    image: '/images/1.webp',
    alt: 'Praktik perakitan boks kemasan souvenir dan pemeriksaan dummy prototipe oleh peserta PKL',
    badge: 'Divisi Kemasan & Produksi',
    title: 'Pemeriksaan Pracetak & Finishing Kemasan',
    desc: 'Siswa Teknik Grafika dan Produksi mempelajari kalibrasi warna cetak, spesifikasi bahan karton kemasan, pembuatan dummy prototipe, serta teknik finishing hotprint dan embossing.',
    link: '/divisi/packaging/',
    linkText: 'Pelajari Divisi Kemasan →',
  },
  {
    image: '/images/10.webp',
    alt: 'Suasana ruang kerja dan fasilitas operasional PKL peserta magang di Saka Malang',
    badge: 'Fasilitas & Ekosistem Industri',
    title: 'Fasilitas Ruang Kerja Kondusif',
    desc: 'Didukung koneksi internet cepat, perangkat kerja terintegrasi, suasana studio yang tenang, serta area diskusi terbuka untuk menunjang produktivitas harian seluruh peserta magang.',
    link: '/program-pkl/fasilitas/',
    linkText: 'Lihat Fasilitas PKL →',
  },
];

const faqs = homePage.faqs;
---

<BaseLayout
  title={homePage.title}
  description={homePage.metaDescription}
  path="/"
  schema={[faqNode('/', faqs)]}
>
  <!-- 1. HERO SECTION: FULLSCREEN BACKGROUND DENGAN OVERLAY TRANSPARAN -->
  <section
    class="home-hero-fullscreen text-center"
    style="--hero-bg: url('/images/13.webp');"
  >
    <div class="home-hero-overlay" aria-hidden="true"></div>

    <div class="container home-hero-content">
      <div class="home-hero-badge">
        <span class="badge bg-primary rounded-pill px-2 py-1">Vokasi & Magang</span>
        <span class="small text-white-50">Portal Resmi Panduan Praktik Kerja Industri</span>
      </div>

      <h1 class="home-hero-title">
        Tempat Magang dan PKL Paling Asik di Malang
      </h1>

      <p class="home-hero-lead">
        Ekosistem kerja asik, family friendly, tempat grow bersama dan tidak ada senioritas.
      </p>

      <div class="d-flex flex-wrap gap-3 justify-content-center mb-3">
        <a href="/cara-daftar/" class="btn-primary-saka shadow-lg">
          <i class="bi bi-journal-check"></i>
          <span>Panduan Cara Daftar</span>
        </a>
        <a
          href="/aktivitas-magang/"
          class="btn btn-outline-light rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2 fw-semibold"
          style="backdrop-filter: blur(6px); background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.4);"
        >
          <i class="bi bi-play-circle-fill"></i>
          <span>Aktivitas Magang</span>
        </a>
      </div>

      <!-- Factual Notice Transparan & Teks Jelas -->
      <div class="home-hero-status-box mx-auto" style="max-width: 760px;">
        <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap text-start">
          <span class="badge bg-success text-white px-2 py-1 rounded-pill flex-shrink-0" style="font-size: 0.76rem;">
            <i class="bi bi-shield-check me-1"></i>Informasi Faktual
          </span>
          <span class="small" style="line-height: 1.5;">
            Seluruh prosedur administrasi, kelengkapan berkas, dan jadwal penerimaan diselaraskan dengan tata kelola resmi pendidikan vokasi.
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- MITRA SEKOLAH (ANIMASI 1 BARIS / CONTINUOUS RUNNING LOGO TICKER) -->
  <section class="partner-marquee-section" aria-label="Mitra Sekolah & Kampus">
    <div class="container mb-3">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div>
          <div class="d-inline-flex align-items-center gap-1.5 badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 mb-1 font-monospace" style="font-size: 0.72rem;">
            <i class="bi bi-mortarboard-fill text-primary"></i>
            <span>Sinergi Vokasi Industri</span>
          </div>
          <h2 class="h5 fw-bold mb-0 text-dark">Sekolah & Kampus Mitra PKL di Saka</h2>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="small text-muted d-none d-lg-inline">Telah bermitra dengan {SCHOOL_PARTNERS.length} institusi pendidikan</span>
          <a
            href="/mitra/"
            class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-2xs"
            style="font-size: 0.82rem;"
          >
            <span>Lihat Semua Mitra</span>
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- 1 Baris Ticker Marquee yang Mengalir Terus Menerus -->
    <div class="partner-marquee-container">
      <div class="partner-marquee-track">
        {[...SCHOOL_PARTNERS, ...SCHOOL_PARTNERS].map((school, idx) => (
          <a
            href="/mitra/"
            class="partner-marquee-item"
            title={`${school.name} - ${school.city} (${school.type})`}
            aria-hidden={idx >= SCHOOL_PARTNERS.length ? 'true' : 'false'}
          >
            <div class="partner-marquee-logo">
              <img
                src={school.logo}
                alt={`Logo ${school.name}`}
                width="28"
                height="28"
                loading="lazy"
              />
            </div>
            <div class="partner-marquee-info">
              <span class="partner-marquee-name">{school.name}</span>
              <span class="partner-marquee-meta">
                <span class="badge bg-light text-secondary border py-0 px-1 font-monospace" style="font-size: 0.65rem;">
                  {school.type}
                </span>
                <span>•</span>
                <span>{school.city}</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- JADWAL MAGANG & RUTINITAS HARIAN (5 HARI KERJA, SENIN - JUMAT, 08:00 - 16:00) -->
  <section class="content-section" id="jadwal-rutinitas" style="background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);">
    <div class="container">
      <div class="text-center mx-auto mb-5" style="max-width: 760px;">
        <span class="section-heading-eyebrow">Jam Kerja & Keseharian Magang</span>
        <h2 class="section-heading-title">PKL Cuma 5 Hari Kerja: Senin – Jumat (08:00 – 16:00)</h2>
        <p class="section-heading-desc">
          Di Saka, kami menerapkan jam magang mulai jam <strong>08:00 – 16:00 WIB</strong>. PKL di kami cuma 5 hari kerja (Senin – Jumat), <strong>Sabtu dan Minggu libur</strong>. Istirahat siang leluasa 1,5 jam, lingkungan kerja family friendly, dan tanpa senioritas!
        </p>
      </div>

      <!-- 4 Highlight Cards Jadwal -->
      <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
          <div class="schedule-stat-card p-4 h-100 rounded-4 border bg-white shadow-xs text-center">
            <div class="schedule-stat-icon bg-primary text-white mx-auto mb-3">
              <i class="bi bi-calendar2-week-fill"></i>
            </div>
            <div class="h5 fw-bold mb-1 text-dark">5 Hari Kerja</div>
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle mb-2">Senin – Jumat</div>
            <p class="small text-muted mb-0">Sabtu & Minggu libur total. Anak magang punya waktu berkualitas untuk keluarga, teman, dan beristirahat.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="schedule-stat-card p-4 h-100 rounded-4 border bg-white shadow-xs text-center">
            <div class="schedule-stat-icon bg-success text-white mx-auto mb-3">
              <i class="bi bi-clock-history"></i>
            </div>
            <div class="h5 fw-bold mb-1 text-dark">08:00 – 16:00 WIB</div>
            <div class="badge bg-success-subtle text-success border border-success-subtle mb-2">Jam Magang Pasti</div>
            <p class="small text-muted mb-0">Magang mulai jam 08:00 sampai 16:00. Selesai piket langsung pulang tepat waktu tanpa lembur.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="schedule-stat-card p-4 h-100 rounded-4 border bg-white shadow-xs text-center">
            <div class="schedule-stat-icon bg-warning text-dark mx-auto mb-3">
              <i class="bi bi-cup-hot-fill"></i>
            </div>
            <div class="h5 fw-bold mb-1 text-dark">Istirahat 1,5 Jam</div>
            <div class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mb-2">11:30 – 13:00 WIB</div>
            <p class="small text-muted mb-0">Istirahat jam 11:30 / adzan Dzuhur – jam 1 (13:00). Leluasa untuk sholat Dzuhur dan makan siang santai.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="schedule-stat-card p-4 h-100 rounded-4 border bg-white shadow-xs text-center">
            <div class="schedule-stat-icon bg-info text-white mx-auto mb-3">
              <i class="bi bi-heart-fill"></i>
            </div>
            <div class="h5 fw-bold mb-1 text-dark">No Senioritas</div>
            <div class="badge bg-info-subtle text-info border border-info-subtle mb-2">Family Friendly</div>
            <p class="small text-muted mb-0">Diawali dan diakhiri doa bersama, piket bareng, briefing santai, dan mentor yang suportif membimbing.</p>
          </div>
        </div>
      </div>

      <!-- Timeline Rangkaian Kegiatan Harian (Step-by-Step) -->
      <div class="daily-timeline-wrapper bg-white p-4 p-lg-5 rounded-4 border shadow-sm">
        <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom">
          <i class="bi bi-list-task text-primary fs-4"></i>
          <div>
            <h3 class="h5 fw-bold mb-0 text-dark">Rangkaian Kegiatan yang Dilakukan Harian</h3>
            <span class="small text-muted">Aktivitas teratur mulai dari kedatangan sebelum jam 08:00 hingga kepulangan jam 16:00 WIB</span>
          </div>
        </div>

        <div class="daily-timeline">
          {dailyRoutine.map((item, idx) => (
            <div class="daily-timeline-item">
              <div class="daily-timeline-marker">
                <div class="daily-timeline-icon">
                  <i class={`bi ${item.icon}`}></i>
                </div>
                {idx < dailyRoutine.length - 1 && <div class="daily-timeline-line"></div>}
              </div>
              <div class="daily-timeline-content">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                  <span class="daily-timeline-time font-monospace fw-bold">{item.time}</span>
                  <span class={`badge border rounded-pill ${item.badgeClass}`} style="font-size: 0.72rem;">{item.badge}</span>
                </div>
                <h4 class="h6 fw-bold mb-1 text-dark">{item.title}</h4>
                <p class="small text-muted mb-0" style="line-height: 1.55;">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONI DARI MURID / ANAK MAGANG (TEKS, FOTO & VIDIO) -->
  <section class="content-section" id="testimoni-magang" style="background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end gap-3 mb-5">
        <div>
          <span class="section-heading-eyebrow">Cerita & Pengalaman Nyata</span>
          <h2 class="section-heading-title mb-1">Testimoni Anak Magang di Saka</h2>
          <p class="section-heading-desc mb-0" style="max-width: 680px;">
            Simak ulasan otentik, foto, dan video singkat dari para siswa SMK serta mahasiswa vokasi yang merasakan langsung serunya magang tanpa senioritas di Saka Malang.
          </p>
        </div>
        <div>
          <a href="/aktivitas-magang/" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-2xs">
            <i class="bi bi-play-circle-fill"></i>
            <span>Lihat Semua Video & Aktivitas</span>
            <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>

      <div class="row g-4">
        {TESTIMONIALS.map((t) => (
          <div class="col-md-6 col-lg-4">
            <div class="testimonial-card-modern h-100 p-4 rounded-4 bg-white border d-flex flex-column shadow-xs">
              <!-- Header: Avatar, Name, School, City -->
              <div class="d-flex align-items-center gap-3 mb-3">
                <img
                  src={t.avatar}
                  alt={`Foto ${t.name}`}
                  class="rounded-circle object-fit-cover border border-2 border-primary-subtle flex-shrink-0"
                  width="52"
                  height="52"
                  loading="lazy"
                />
                <div class="min-w-0">
                  <div class="d-flex align-items-center gap-1.5 mb-0.5">
                    <h3 class="h6 fw-bold mb-0 text-dark text-truncate" style="font-size: 0.95rem;">{t.name}</h3>
                  </div>
                  <div class="small text-muted text-truncate" style="font-size: 0.78rem;">
                    {t.school}
                  </div>
                  <div class="d-flex align-items-center gap-2 mt-0.5">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-0 px-1.5 font-monospace" style="font-size: 0.65rem;">
                      {t.badge}
                    </span>
                    <span class="small text-muted" style="font-size: 0.72rem;">
                      <i class="bi bi-geo-alt text-danger me-0.5"></i>{t.city}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Rating Stars -->
              <div class="d-flex align-items-center gap-1 mb-2.5 text-warning" style="font-size: 0.85rem;">
                {Array.from({ length: t.rating }).map(() => (
                  <i class="bi bi-star-fill"></i>
                ))}
                <span class="small text-muted ms-1 font-monospace" style="font-size: 0.75rem;">(5.0)</span>
              </div>

              <!-- Quote Text -->
              <p class="small text-secondary mb-3 flex-grow-1" style="line-height: 1.6; font-size: 0.86rem;">
                "{t.quote}"
              </p>

              <!-- Video Clip Preview / Trigger (jika ada video) -->
              {t.hasVideo && (
                <div class="mt-auto pt-3 border-top">
                  <button
                    type="button"
                    class="btn btn-sm btn-outline-danger w-100 rounded-pill py-2 d-flex align-items-center justify-content-center gap-2 font-monospace fw-semibold home-video-modal-btn"
                    data-title={t.videoTitle || t.name}
                    data-desc={t.quote}
                    data-author={`${t.name} - ${t.school}`}
                    data-thumb={t.videoThumbnail || t.avatar}
                  >
                    <i class="bi bi-play-circle-fill fs-6"></i>
                    <span>Tonton Video Singkat ({t.videoDuration})</span>
                  </button>
                </div>
              )}

              {!t.hasVideo && (
                <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between text-muted small" style="font-size: 0.76rem;">
                  <span><i class="bi bi-patch-check-fill text-success me-1"></i>Ulasan Terverifikasi</span>
                  <span class="font-monospace">{t.batch}</span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. RINGKASAN PROGRAM & JALUR INFORMASI (7 Kelompok Konten Utama) -->
  <section class="content-section">
    <div class="container">
      <SectionHeading
        eyebrow="Struktur Informasi"
        title="7 Jalur Utama Panduan PKL"
        description="Temukan informasi spesifik sesuai kebutuhan persiapan magang Anda dari indeks kelompok materi resmi."
        center={true}
      />

      <div class="row g-4">
        {Object.entries(GROUPS_INFO)
          .filter(([key]) => key !== 'B4')
          .map(([key, group]) => (
            <div class="col-md-6 col-lg-4">
              <LinkCard
                href={group.path}
                title={group.title}
                description={group.desc}
                icon={group.icon}
                badge={`Kode ${key}`}
                linkText="Buka Direktori"
              />
            </div>
          ))}
      </div>
    </div>
  </section>

