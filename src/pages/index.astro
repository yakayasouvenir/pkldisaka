  <script>
    function setupEnvCarousel() {
      const track = document.getElementById('envCarouselTrack');
      const prevBtn = document.getElementById('envCarouselPrev') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('envCarouselNext') as HTMLButtonElement | null;
      if (!track || !prevBtn || !nextBtn) return;

      function updateNavState() {
        if (!track || !prevBtn || !nextBtn) return;
        const atStart = track.scrollLeft <= 10;
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 10;
        prevBtn.disabled = atStart;
        nextBtn.disabled = atEnd;
      }

      prevBtn.addEventListener('click', () => {
        const item = track.querySelector('.env-carousel-item') as HTMLElement | null;
        const cardWidth = item ? item.offsetWidth + 20 : 340;
        track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        const item = track.querySelector('.env-carousel-item') as HTMLElement | null;
        const cardWidth = item ? item.offsetWidth + 20 : 340;
        track.scrollBy({ left: cardWidth, behavior: 'smooth' });
      });

      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      let hasDragged = false;

      track.addEventListener('mousedown', (e: MouseEvent) => {
        if (e.button !== 0) return;
        isDown = true;
        hasDragged = false;
        track.classList.add('is-dragging');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      window.addEventListener('mouseup', () => {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('is-dragging');
      });

      track.addEventListener('mouseleave', () => {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('is-dragging');
      });

      track.addEventListener('mousemove', (e: MouseEvent) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5;
        if (Math.abs(walk) > 5) {
          hasDragged = true;
        }
        track.scrollLeft = scrollLeft - walk;
      });

      track.addEventListener(
        'click',
        (e: MouseEvent) => {
          if (hasDragged) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );

      track.addEventListener('scroll', updateNavState, { passive: true });
      window.addEventListener('resize', updateNavState, { passive: true });
      updateNavState();
    }

    function setupHomeVideoModal() {
      const videoBtns = document.querySelectorAll('.home-video-modal-btn');
      const modalTitle = document.getElementById('homeModalVideoTitle');
      const modalThumb = document.getElementById('homeModalVideoThumb');
      const modalDesc = document.getElementById('homeModalVideoDesc');
      const modalAuthor = document.getElementById('homeModalVideoAuthor');
      const realWrap = document.getElementById('homeModalRealVideoWrap');
      const simWrap = document.getElementById('homeModalSimulatedWrap');
      const realVideo = document.getElementById('homeModalVideoPlayer') as HTMLVideoElement | null;

      videoBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const title = btn.getAttribute('data-title') || 'Video Testimoni';
          const author = btn.getAttribute('data-author') || '';
          const desc = btn.getAttribute('data-desc') || '';
          const thumb = btn.getAttribute('data-thumb') || '';
          const videoUrl = btn.getAttribute('data-video-url') || '';

          if (modalTitle) modalTitle.textContent = title;
          if (modalDesc) modalDesc.textContent = desc;
          if (modalAuthor) modalAuthor.textContent = author;

          if (videoUrl && realVideo && realWrap && simWrap) {
            realWrap.style.display = 'block';
            simWrap.style.display = 'none';
            realVideo.src = videoUrl;
            realVideo.load();
            realVideo.play().catch(() => {});
          } else {
            if (realWrap) realWrap.style.display = 'none';
            if (simWrap) simWrap.style.display = 'block';
            if (modalThumb && thumb) (modalThumb as HTMLImageElement).src = thumb;
            if (realVideo) {
              realVideo.pause();
              realVideo.src = '';
            }
          }

          const modalEl = document.getElementById('homeVideoModal');
          if (modalEl && (window as any).bootstrap) {
            const modal = new (window as any).bootstrap.Modal(modalEl);
            modal.show();
          }
        });
      });

      const modalEl = document.getElementById('homeVideoModal');
      if (modalEl) {
        modalEl.addEventListener('hidden.bs.modal', () => {
          if (realVideo) {
            realVideo.pause();
          }
        });
      }
    }

    function setupDailyRoutineSwipe() {
      const track = document.getElementById('routineSwipeTrack');
      const pills = document.querySelectorAll('.routine-pill-btn');
      const dots = document.querySelectorAll('.routine-step-dot');
      const nextBtns = document.querySelectorAll('.routine-next-btn');
      if (!track) return;

      function updateActiveState(stepIdx: number) {
        pills.forEach((p, i) => {
          if (i === stepIdx) {
            p.classList.add('active');
            p.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            p.classList.remove('active');
          }
        });

        dots.forEach((d, i) => {
          if (i === stepIdx) {
            d.classList.add('active');
          } else {
            d.classList.remove('active');
          }
        });
      }

      function scrollToStep(stepIdx: number) {
        const card = track?.querySelector(`[data-step-index="${stepIdx}"]`) as HTMLElement | null;
        if (card && track) {
          track.scrollTo({ left: card.offsetLeft - 16, behavior: 'smooth' });
          updateActiveState(stepIdx);
        }
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const target = Number(pill.getAttribute('data-step-target') || 0);
          scrollToStep(target);
        });
      });

      nextBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = Number(btn.getAttribute('data-next-step') || 0);
          scrollToStep(next);
        });
      });

      track.addEventListener(
        'scroll',
        () => {
          const cards = track.querySelectorAll('.routine-swipe-card');
          const scrollLeft = track.scrollLeft;
          cards.forEach((card, idx) => {
            const el = card as HTMLElement;
            if (Math.abs(el.offsetLeft - scrollLeft - 16) < el.offsetWidth / 2) {
              updateActiveState(idx);
            }
          });
        },
        { passive: true }
      );
    }

    function initHomePage() {
      setupEnvCarousel();
      setupHomeVideoModal();
      setupDailyRoutineSwipe();
    }

    initHomePage();
    document.addEventListener('astro:page-load', initHomePage);
  </script>

