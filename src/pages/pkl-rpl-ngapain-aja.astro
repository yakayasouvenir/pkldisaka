---
// src/pages/pkl-rpl-ngapain-aja.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatusNotice from '../components/StatusNotice.astro';
import FAQList from '../components/FAQList.astro';
import CTASection from '../components/CTASection.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, waLink, mapsLink } from '../data/site';
import { faqNode } from '../lib/schema';
import { getCollection } from 'astro:content';

const path = '/pkl-rpl-ngapain-aja/';
const crumbs = [{ name: 'PKL RPL Ngapain Aja', path }];

// Ambil artikel pendukung topik cluster
const allBlog = await getCollection('blog');
const supportSlugs = [
  'tugas-anak-rpl-saat-pkl',
  'tempat-pkl-rpl',
  'persiapan-pkl-rpl',
  'contoh-laporan-pkl-rpl',
];

const supportingArticles = supportSlugs
  .map((slug) => allBlog.find((b) => b.id === slug))
  .filter(Boolean);

const faqs = [
  {
    q: 'PKL RPL ngapain aja selama di tempat magang?',
    a: 'Siswa jurusan RPL selama PKL umumnya mengerjakan tugas pemrograman dan web development, mulai dari slicing desain UI Figma ke HTML/CSS responsif, menambahkan interaktivitas dengan JavaScript, mengolah database MySQL dan script backend, memperbaiki bug program (debugging), hingga pengujian kualitas aplikasi (QA testing).',
  },
  {
    q: 'Apakah anak magang RPL selalu dituntut coding seharian?',
    a: 'Tidak selalu. Selain koding, peserta didik juga terlibat dalam perancangan antarmuka antarmuka (UI/UX) di Figma, audit performa website di Google Lighthouse, dokumentasi kode, pengelolaan repositori Git/GitHub, serta penyusunan jurnal harian kegiatan magang.',
  },
  {
    q: 'Bagaimana jika siswa SMK RPL belum mahir coding saat mulai PKL?',
    a: 'Di tempat magang yang berkualitas seperti PKL di Saka Malang, siswa dibimbing secara bertahap oleh mentor industri profesional mulai dari pemahaman fondasi dasar web semantik, penataan styling CSS, hingga praktik langsung pada proyek digital nyata.',
  },
  {
    q: 'Bahasa pemrograman dan tools apa yang paling sering digunakan saat PKL RPL?',
    a: 'Teknologi yang paling sering digunakan adalah HTML5, CSS3 (Flexbox/Grid), JavaScript, PHP, MySQL, Bootstrap/Tailwind, Visual Studio Code, Git/GitHub, dan Figma.',
  },
  {
    q: 'Apakah hasil pekerjaan PKL RPL bisa dijadikan portofolio kerja?',
    a: 'Ya, hasil proyek pembuatan website, landing page, atau modul aplikasi yang dikerjakan selama magang dapat menjadi portofolio resmi yang sangat berharga untuk melamar pekerjaan atau melanjutkan kuliah setelah mendapat izin dari perusahaan.',
  },
];

const workPillars = [
  {
    title: 'Web & Front End Development',
    icon: 'bi-code-slash',
    desc: 'Membangun landing page dan website bisnis menggunakan HTML5 semantik, CSS modern (Flexbox/Grid), serta interaktivitas JavaScript responsif.',
    tags: ['HTML5', 'CSS3', 'JavaScript', 'Responsive UI'],
  },
  {
    title: 'Back End & Database Management',
    icon: 'bi-database-check',
    desc: 'Mengembangkan logika aplikasi web dinamis menggunakan PHP, menghubungkan formulir antarmuka, serta merancang skema database MySQL terstruktur.',
    tags: ['PHP', 'MySQL', 'CRUD System', 'Form Handling'],
  },
  {
    title: 'UI/UX Design & Slicing',
    icon: 'bi-palette-fill',
    desc: 'Mempelajari perancangan antarmuka di Figma, memahami wireframe pengguna, dan mengonversikan desain visual menjadi susunan kode web yang presisi.',
    tags: ['Figma', 'Wireframing', 'UI Slicing', 'Clean Layout'],
  },
  {
    title: 'Bug Fixing & Software Testing',
    icon: 'bi-bug-fill',
    desc: 'Melatih kemampuan problem solving melalui debugging error program, inspeksi console browser, dan pengujian fitur aplikasi secara sistematis.',
    tags: ['QA Testing', 'Debugging', 'Browser DevTools', 'Validasi Form'],
  },
];
---

<BaseLayout
  title="PKL RPL Ngapain Aja? Tugas, Kegiatan Koding, dan Pengalaman Nyata Siswa SMK"
  description="Penasaran PKL RPL ngapain aja? Pelajari tugas nyata anak magang RPL mulai dari koding HTML/CSS/JS, database MySQL, testing aplikasi, hingga bimbingan mentor industri di PKL di Saka."
  path={path}
  crumbs={crumbs}
  schema={[faqNode(path, faqs)]}
>
  <PageHero
    eyebrow="PANDUAN LENGKAP MAGANG SMK REKAYASA PERANGKAT LUNAK"
    title="PKL RPL Ngapain Aja? Ini Tugas, Kegiatan Koding, dan Proyek Nyatanya"
    lead="Banyak siswa SMK bertanya-tanya: PKL RPL ngapain aja di tempat magang? Temukan gambaran lengkap alur kerja nyata anak Rekayasa Perangkat Lunak mulai dari pembuatan website, pengelolaan database, pengujian aplikasi, hingga bimbingan mentor industri terpercaya."
    crumbs={crumbs}
    bgImage="/images/blog/pkl-rpl-ngapain-aja.webp"
  />

  <section class="content-section">
    <div class="container">
      <div class="row g-4 g-xl-5">
        <!-- Main Content Column -->
        <div class="col-lg-8">
          <StatusNotice
            status="Panduan Faktual & Terverifikasi Industri"
            note="Disusun berdasarkan silabus Capaian Pembelajaran SMK jurusan Rekayasa Perangkat Lunak dan alur kerja riil agensi teknologi CV Saudagar Kaya Abadi Malang."
          />

          <article class="article-content">
            <!-- Summary Box -->
            <div class="article-summary-box mb-4">
              <div class="article-summary-title">
                <i class="bi bi-info-circle-fill text-primary me-2"></i>Jawaban Singkat: PKL RPL Ngapain Aja?
              </div>
              <p class="article-summary-text mb-0">
                Secara umum, <strong>PKL RPL ngapain aja</strong> mencakup kegiatan koding pengembangan website, slicing desain UI Figma ke dalam markup HTML dan CSS responsif, mengelola logika interaktif JavaScript, mengonfigurasi skema database MySQL dengan PHP, memperbaiki bug program (*debugging*), serta menguji fungsionalitas sistem (*quality assurance*). Di <strong><a href="/" class="text-decoration-none fw-bold text-primary">PKL di Saka</a></strong> Malang, seluruh siswa dibimbing bertahap oleh mentor industri agar siap menghasilkan portofolio karya digital yang nyata.
              </p>
            </div>

            <!-- Feature Image Box -->
            <div class="article-feature-box mb-5">
              <div class="row g-3 align-items-center">
                <div class="col-md-5">
                  <div class="article-feature-img-wrap">
                    <img
                      src="/images/blog/tugas-anak-rpl-saat-pkl.webp"
                      alt="Aktivitas koding siswa SMK jurusan RPL bersama mentor industri di Malang"
                      loading="lazy"
                      width="480"
                      height="300"
                    />
                    <span class="article-feature-badge">
                      <i class="bi bi-laptop me-1"></i>Praktik Nyata Industri
                    </span>
                  </div>
                </div>
                <div class="col-md-7">
                  <h3 class="h6 fw-bold text-primary mb-2">Bimbingan Koding Bertahap dari Mentor</h3>
                  <p class="small text-muted mb-3">
                    Peserta magang RPL tidak dilepas sendirian menghadapi kode rumit. Setiap siswa mendapatkan modul penugasan yang disesuaikan dengan kemampuan awal, mulai dari penataan layout semantik hingga integrasi backend yang andal.
                  </p>
                  <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-dark border"><i class="bi bi-check2 text-success me-1"></i>Web Developer</span>
                    <span class="badge bg-light text-dark border"><i class="bi bi-check2 text-success me-1"></i>QA Testing</span>
                    <span class="badge bg-light text-dark border"><i class="bi bi-check2 text-success me-1"></i>Figma UI Slicing</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Content Body -->
            <h2 class="h4 fw-bold text-dark mb-3">Daftar Pekerjaan dan Kegiatan Utama Anak PKL RPL</h2>
            <p>
              Program Praktik Kerja Lapangan (PKL) bagi siswa SMK program keahlian Rekayasa Perangkat Lunak (RPL) dirancang untuk mentransformasikan materi teori sekolah menjadi keterampilan terapan yang dibutuhkan industri software.
            </p>
            <p>
              Berikut adalah 4 pilar penugasan utama yang biasa dikerjakan siswa selama menjalani masa magang di software house atau agensi teknologi digital:
            </p>

            <div class="row g-3 my-4">
              {workPillars.map((pillar) => (
                <div class="col-md-6">
                  <div class="p-3 border rounded-3 bg-light h-100 shadow-xs">
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <div class="bg-primary text-white rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class={`bi ${pillar.icon}`}></i>
                      </div>
                      <h3 class="h6 fw-bold text-dark mb-0">{pillar.title}</h3>
                    </div>
                    <p class="small text-muted mb-3">{pillar.desc}</p>
                    <div class="d-flex flex-wrap gap-1">
                      {pillar.tags.map((tag) => (
                        <span class="badge bg-white text-secondary border font-monospace small" style="font-size: 0.72rem;">{tag}</span>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <h2 class="h4 fw-bold text-dark mt-5 mb-3">Contoh Alur Hari Kerja Siswa Magang RPL</h2>
            <p>
              Untuk memberikan gambaran nyata, berikut adalah gambaran rutinitas kerja harian peserta PKL jurusan RPL di lingkungan agensi modern:
            </p>
            <ol class="ps-3 mb-4 text-muted">
              <li class="mb-2"><strong>08.00 - 08.30: Morning Briefing & Review Target</strong> — Berdiskusi santai dengan mentor industri mengenai progres penulisan kode hari sebelumnya dan penetapan target halaman yang akan dibuat.</li>
              <li class="mb-2"><strong>08.30 - 11.45: Sesi Koding & Slicing Desain</strong> — Fokus mengerjakan slicing antarmuka dari Figma ke Visual Studio Code menggunakan HTML, CSS modern, dan JavaScript.</li>
              <li class="mb-2"><strong>11.45 - 13.00: Istirahat, Sholat, dan Makan Siang</strong> — Waktu relaksasi dan kebersamaan antar sesama peserta magang dari berbagai sekolah dan kampus.</li>
              <li class="mb-2"><strong>13.00 - 15.30: Debugging, Integrasi Database & Testing</strong> — Melakukan uji coba pengiriman form, pemeriksaan error di browser console, serta optimasi kecepatan muat halaman.</li>
              <li class="mb-2"><strong>15.30 - 16.00: Code Review & Jurnal Harian</strong> — Mentor mengevaluasi kerapian kode, memberikan masukan perbaikan (*feedback*), dan menandatangani lembar catatan kerja harian siswa.</li>
            </ol>

            <div class="my-4 text-center">
              <figure>
                <img
                  src="/images/blog/tempat-pkl-rpl.webp"
                  alt="Siswa RPL berdiskusi dengan mentor di studio pengembangan website Malang"
                  class="img-fluid rounded-4 shadow-sm w-100"
                  loading="lazy"
                />
                <figcaption class="text-muted small mt-2">Suasana mentoring teknis di lingkungan kerja nyata yang suportif dan profesional.</figcaption>
              </figure>
            </div>

            <h2 class="h4 fw-bold text-dark mt-5 mb-3">Mengapa Memilih PKL RPL di Saka Malang?</h2>
            <p>
              Menjawab kebingungan siswa seputar <em>PKL RPL ngapain aja</em>, <strong><a href="/" class="text-decoration-none fw-bold text-primary">PKL di Saka</a></strong> hadir memberikan solusi program magang terstruktur yang 100% bebas biaya:
            </p>
            <ul class="ps-3 mb-4 text-muted">
              <li class="mb-2"><strong>Kurikulum Selaras Sekolah:</strong> Materi penugasan disusun agar linear dengan kompetensi kejuruan SMK sehingga laporan PKL dan nilai rapor Anda terjamin optimal.</li>
              <li class="mb-2"><strong>Workstation Komputer & Internet Cepat:</strong> Disediakan fasilitas pendukung kerja koding dan riset yang nyaman di kantor Malang.</li>
              <li class="mb-2"><strong>Mentor Berpengalaman:</strong> Didampingi langsung oleh praktisi web developer dan digital strategist yang sabar membimbing dari nol.</li>
              <li class="mb-2"><strong>Portofolio Proyek Nyata:</strong> Hasil karya website atau aplikasi Anda dapat diakses secara publik dan menjadi modal berharga saat melamar kerja setelah lulus.</li>
            </ul>

            <div class="p-4 bg-primary-subtle border border-primary-subtle rounded-4 my-5 text-center">
              <h3 class="h5 fw-bold text-primary mb-2">Ingin Pengalaman PKL RPL yang Nyata & Terarah?</h3>
              <p class="small text-muted mb-3 mx-auto" style="max-width: 540px;">
                Jangan biarkan masa magang Anda habis hanya untuk tugas non-teknis. Gabung bersama divisi Web Engineering di PKL di Saka Malang dan asah keahlian koding Anda bersama mentor profesional.
              </p>
              <a
                href={waLink('Halo Tim PKL di Saka, saya siswa SMK jurusan RPL ingin menanyakan ketersediaan kuota magang untuk posisi web development. Terima kasih!')}
                class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2"
                target="_blank"
                rel="noopener noreferrer"
              >
                <i class="bi bi-whatsapp"></i>
                Konsultasi Kuota Magang RPL
              </a>
            </div>

            <!-- Supporting Blog Cluster -->
            <div class="mt-5 pt-4 border-top">
              <h2 class="h5 fw-bold text-dark mb-4">Artikel Panduan Terkait PKL Jurusan RPL</h2>
              <div class="row g-3">
                {supportingArticles.map((art) => (
                  <div class="col-md-6">
                    <ArticleCard
                      href={`/blog/${art.id}/`}
                      title={art.data.title}
                      summary={art.data.description}
                      category={art.data.category || 'Panduan RPL'}
                      bgImage={art.data.image}
                    />
                  </div>
                ))}
              </div>
            </div>

            <!-- FAQ Section -->
            <div class="mt-5 pt-4 border-top">
              <h2 class="h5 fw-bold text-dark mb-3">Tanya Jawab Seputar Kegiatan PKL Jurusan RPL</h2>
              <FAQList faqs={faqs} />
            </div>
          </article>
        </div>

        <!-- Sidebar Column -->
        <div class="col-lg-4">
          <div class="sticky-top" style="top: 2rem;">
            <!-- Konsultasi Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill w-fit mb-3">
                <i class="bi bi-check-circle-fill me-1"></i>Pendaftaran Gratis 100%
              </span>
              <h3 class="h6 fw-bold text-dark mb-2">Daftar PKL RPL di Saka Malang</h3>
              <p class="small text-muted mb-4">
                Kuota penerimaan siswa magang RPL dibuka setiap periode semester. Hubungi tim admin kami untuk cek slot divisi koding yang masih tersedia.
              </p>
              <a
                href={waLink('Halo Tim Saka, saya ingin mendaftar PKL jurusan Rekayasa Perangkat Lunak (RPL). Mohon info alur pendaftarannya.')}
                class="btn btn-primary w-100 rounded-pill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm mb-3"
                target="_blank"
                rel="noopener noreferrer"
              >
                <i class="bi bi-whatsapp"></i>
                Daftar Sekarang via WA
              </a>
              <div class="text-center small text-muted">
                <i class="bi bi-clock me-1"></i>Respon Cepat Jam Kerja (08.00 - 16.00 WIB)
              </div>
            </div>

            <!-- Info Kontak & Lokasi -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
              <div class="small fw-bold text-uppercase text-primary mb-2">Lokasi Studio Magang</div>
              <h4 class="h6 fw-bold text-dark mb-2">Sentra Vokasi CV Saudagar Kaya Abadi</h4>
              <p class="small text-muted mb-3">
                Jl. Band. Palmerah No.D3-35B, Cemorokandang, Kec. Kedungkandang, Kota Malang, Jawa Timur 65138
              </p>
              <a
                href={mapsLink}
                class="btn btn-outline-secondary w-100 rounded-pill py-2 small fw-medium d-inline-flex align-items-center justify-content-center gap-2"
                target="_blank"
                rel="noopener noreferrer"
              >
                <i class="bi bi-geo-alt-fill text-danger"></i>
                Petunjuk Arah Google Maps
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
