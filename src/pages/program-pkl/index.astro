---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import LinkCard from '../../components/LinkCard.astro';
import FAQList from '../../components/FAQList.astro';
import CTASection from '../../components/CTASection.astro';
import StatusNotice from '../../components/StatusNotice.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { getPageByPath } from '../../data/pklData';
import { faqNode } from '../../lib/schema';

const page = getPageByPath('/program-pkl/')!;
const crumbs = [{ name: page.h1, path: page.path }];
---

<BaseLayout
  title={page.title}
  description={page.metaDescription}
  path={page.path}
  crumbs={crumbs}
  schema={page.faqs ? [faqNode(page.path, page.faqs)] : []}
>
  <PageHero
    eyebrow={page.groupName}
    title={page.h1}
    lead={page.summary}
    crumbs={crumbs}
    bgImage="/images/20.webp"
  />

  <section class="content-section">
    <div class="container article-container">
      <StatusNotice
        status={page.status}
        targetDate={page.targetDate}
        note="Kurikulum industri PKL diselaraskan dengan Capaian Pembelajaran SMK dan perguruan tinggi."
      />

      <article class="article-content">
        <div class="article-summary-box">
          <div class="article-summary-title">
            <i class="bi bi-info-circle-fill me-1"></i>Ringkasan Kurikulum Program
          </div>
          <p class="article-summary-text">{page.summary}</p>
        </div>

        <!-- Feature Box Kurikulum & Fasilitas PKL -->
        <div class="article-feature-box">
          <div class="row g-3 align-items-center">
            <div class="col-md-5">
              <div class="article-feature-img-wrap">
                <img
                  src="/images/13.webp"
                  alt="Sesi pembekalan kurikulum industri dan mentoring terpadu bersama praktisi"
                  loading="lazy"
                  width="480"
                  height="300"
                />
                <span class="article-feature-badge">
                  <i class="bi bi-mortarboard-fill me-1"></i>Kurikulum Industri
                </span>
              </div>
            </div>
            <div class="col-md-7">
              <h3 class="h6 fw-bold text-primary mb-2">Pilar Pembinaan & Kurikulum Praktik Saka</h3>
              <p class="small text-muted mb-2">
                Program disusun untuk mengonversi materi kejuruan sekolah dan kampus menjadi keterampilan kerja riil berstandar industri digital.
              </p>
              <div class="competency-item">
                <i class="bi bi-check-circle-fill"></i>
                <span><strong>Bimbingan Praktisi:</strong> Arahan teknis langsung dari staf industri berpengalaman.</span>
              </div>
              <div class="competency-item">
                <i class="bi bi-check-circle-fill"></i>
                <span><strong>Portofolio Otentik:</strong> Hasil karya nyata dijadikan portofolio profesional siswa.</span>
              </div>
              <div class="competency-item mb-0">
                <i class="bi bi-check-circle-fill"></i>
                <span><strong>Pengesahan Resmi:</strong> Penilaian transparan untuk laporan ke sekolah/kampus.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="article-body">
          {page.sections.map((sec) => (
            <div class="mb-4">
              <h2>{sec.heading}</h2>
              <p>{sec.content}</p>
              {sec.bullets && (
                <ul>
                  {sec.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}

          <!-- Dokumentasi Foto Lapangan & Fasilitas Terkait (Foto 3 & 4) -->
        <div class="article-gallery-showcase my-4 p-3 p-md-4 rounded-4 bg-light border">
          <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div>
              <h3 class="h6 fw-bold text-dark mb-0">
                <i class="bi bi-camera-fill text-primary me-2"></i>Dokumentasi Aktivitas & Fasilitas Terkait
              </h3>
              <p class="small text-muted mb-0">Gambaran nyata ekosistem kerja, sarana penunjang, dan pendampingan di Saka Malang.</p>
            </div>
            <span class="badge bg-white text-primary border shadow-xs">
              <i class="bi bi-images me-1"></i>Dokumentasi Nyata
            </span>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <div class="gallery-photo-card h-100 bg-white rounded-3 overflow-hidden border shadow-xs d-flex flex-column">
                <div class="position-relative">
                  <img
                    src="/images/22.webp"
                    alt="Kolaborasi pengerjaan proyek industri lintas divisi kejuruan"
                    loading="lazy"
                    class="w-100 object-fit-cover"
                    style="height: 195px;"
                  />
                  <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 end-0 m-2">
                    <i class="bi bi-people-fill me-1"></i>Praktik Tim Kerja
                  </span>
                </div>
                <div class="p-3 d-flex flex-column flex-grow-1">
                  <div class="fw-bold small text-dark mb-1">Kolaborasi Pengerjaan Proyek Industri</div>
                  <p class="small text-muted mb-0" style="line-height: 1.5;">Peserta dibimbing menyelesaikan tugas nyata agensi dalam suasana kerja tim profesional yang kondusif.</p>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="gallery-photo-card h-100 bg-white rounded-3 overflow-hidden border shadow-xs d-flex flex-column">
                <div class="position-relative">
                  <img
                    src="/images/4.webp"
                    alt="Pelepasan siswa magang dan penyerahan sertifikat kompetensi resmi"
                    loading="lazy"
                    class="w-100 object-fit-cover"
                    style="height: 195px;"
                  />
                  <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 end-0 m-2">
                    <i class="bi bi-award-fill me-1"></i>Kelulusan Program
                  </span>
                </div>
                <div class="p-3 d-flex flex-column flex-grow-1">
                  <div class="fw-bold small text-dark mb-1">Penyerahan Sertifikat Kompetensi Resmi</div>
                  <p class="small text-muted mb-0" style="line-height: 1.5;">Setiap peserta yang menuntaskan program PKL memperoleh sertifikat resmi berkop industri sebagai bukti kompetensi kerja.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <h2 class="mt-4 mb-3">Sub-Program Terkait</h2>
          <div class="row g-3">
            <div class="col-md-6">
              <LinkCard
                href="/program-pkl/alur-seleksi/"
                title="Alur Seleksi & Penerimaan"
                description="Tahapan pendaftaran mulai dari pengajuan berkas, tes kompetensi ringan, hingga surat balasan."
                icon="bi-diagram-2"
                linkText="Lihat Alur Seleksi"
              />
            </div>
            <div class="col-md-6">
              <LinkCard
                href="/program-pkl/fasilitas/"
                title="Fasilitas & Ruang Kerja"
                description="Sarana kerja kolaboratif, koneksi internet berkecepatan tinggi, dan ruang diskusi penunjang."
                icon="bi-laptop"
                linkText="Lihat Fasilitas"
              />
            </div>
          </div>
        </div>

        <RelatedLinks urls={page.relatedUrls} />
      </article>
    </div>
  </section>

  {page.faqs && (
    <FAQList
      items={page.faqs}
      id="faq-program"
      title="Pertanyaan Seputar Program PKL"
    />
  )}

  <CTASection />
</BaseLayout>
