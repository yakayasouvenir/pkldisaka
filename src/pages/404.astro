---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 - Halaman Tidak Ditemukan"
  description="Halaman yang Anda cari tidak ditemukan di pkldisaka.com."
  path="/404/"
  noindex
>
  <section class="content-section text-center py-5">
    <div class="container py-4">
      <div class="fw-bold text-primary mb-2" style="font-size: 6rem; line-height: 1;">404</div>
      <h1 class="h2 fw-bold mb-3">Halaman Tidak Ditemukan</h1>
      <p class="text-muted mx-auto mb-4" style="max-width: 520px;">
        Halaman yang Anda tuju mungkin telah diperbarui atau dipindahkan sesuai struktur direktori master 72 URL pkldisaka.com.
      </p>
      <div class="d-flex flex-wrap gap-3 justify-content-center">
        <a class="btn-primary-saka" href="/">
          <i class="bi bi-house-door me-1"></i>Kembali ke Beranda
        </a>
        <a class="btn-secondary-saka" href="/program-pkl/">
          <i class="bi bi-grid me-1"></i>Lihat Panduan Program
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
